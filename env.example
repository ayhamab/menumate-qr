RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
PORT=3000

# Secrets and credentials
RAILS_MASTER_KEY=your-master-key-here
SECRET_KEY_BASE=generate-with-rails-secret

# Database configuration
DATABASE_URL=postgres://app_user:strong-password@localhost:5432/menumate_qr
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=
CABLE_DATABASE_URL=
DB_STATEMENT_TIMEOUT=5000

# Application URLs / hosts
APP_HOST=example.com
APP_PROTOCOL=https
ALLOWED_HOSTS=example.com,.example.com

# SSL / security
FORCE_SSL=true
ASSUME_SSL=true

# Active Storage (set to `local` if you do not use S3)
ACTIVE_STORAGE_SERVICE=amazon_env
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET=menumate-qr-production
AWS_SSE_ALGORITHM=AES256

# Email (leave blank to disable SMTP delivery)
SMTP_ADDRESS=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPEN_TIMEOUT=5
SMTP_READ_TIMEOUT=5

# Background jobs / realtime
SOLID_QUEUE_IN_PUMA=1

# Third-party integrations
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=

