<% content_for :title, "#{@brand.name} - #{@restaurant.name}" %>

<div class="brand-show">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_brands_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900"><%= @brand.name %></h1>
        <p class="text-gray-600 mt-1"><%= @restaurant.name %></p>
      </div>
    </div>
  </div>

  <!-- Brand Info Card -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100" style="<%= @brand.brand_color.present? ? "border-left: 4px solid #{@brand.brand_color}" : '' %>">
    <div class="flex items-start justify-between mb-6">
      <div class="flex-1">
        <% if @brand.description.present? %>
          <p class="text-gray-700 text-lg leading-relaxed mb-4"><%= @brand.description %></p>
        <% end %>
        <div class="flex flex-wrap gap-4 text-sm">
          <div>
            <p class="text-gray-500 mb-1">Menu Items</p>
            <p class="text-2xl font-bold text-indigo-600"><%= @brand.menu_items_count %></p>
          </div>
          <div>
            <p class="text-gray-500 mb-1">QR Codes</p>
            <p class="text-2xl font-bold text-indigo-600"><%= @brand.qr_codes.count %></p>
          </div>
          <div>
            <p class="text-gray-500 mb-1">Status</p>
            <p class="text-lg font-semibold <%= @brand.active? ? 'text-green-600' : 'text-gray-600' %>">
              <%= @brand.active? ? 'Active' : 'Inactive' %>
            </p>
          </div>
        </div>
      </div>
      <div class="flex gap-3">
        <%= link_to edit_restaurant_brand_path(@restaurant, @brand), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <span>Edit Brand</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Menu Items -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Menu Items</h2>
      <%= link_to new_restaurant_menu_item_path(@restaurant, brand_id: @brand.id), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add Menu Item</span>
      <% end %>
    </div>

    <% if @menu_items.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @menu_items_by_category.each do |category, items| %>
          <div class="mb-6">
            <h3 class="text-lg font-bold text-gray-900 mb-3">
              <%= category.present? ? category : 'Uncategorized' %>
            </h3>
            <div class="space-y-3">
              <% items.each do |item| %>
                <%= link_to restaurant_menu_item_path(@restaurant, item), class: "block bg-gray-50 rounded-lg p-4 border-2 border-gray-200 hover:border-indigo-300 hover:shadow-md transition-all duration-200" do %>
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <h4 class="font-bold text-gray-900 mb-1"><%= item.name %></h4>
                      <p class="text-sm text-gray-600 mb-2 line-clamp-2"><%= item.description %></p>
                      <p class="text-lg font-bold text-indigo-600">$<%= number_with_precision(item.price, precision: 2) %></p>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-50 rounded-lg p-8 text-center border-2 border-dashed border-gray-200">
        <p class="text-gray-600 mb-4">No menu items for this brand yet</p>
        <%= link_to new_restaurant_menu_item_path(@restaurant, brand_id: @brand.id), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Add First Menu Item</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- QR Code Section -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Brand QR Code</h2>
    <div class="flex flex-col items-center">
      <div class="bg-white p-4 rounded-xl border-2 border-gray-200 shadow-inner mb-4">
        <% menu_url = menu_brand_url(@brand, host: request.host_with_port, protocol: request.protocol) %>
        <%= qr_code_svg(menu_url, size: 200) %>
      </div>
      <p class="text-sm text-gray-600 text-center mb-4">
        Scan this QR code to view the <%= @brand.name %> menu
      </p>
      <div class="flex gap-3">
        <%= link_to qr_code_png_restaurant_brand_path(@restaurant, @brand), class: "bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download PNG</span>
        <% end %>
        <%= link_to qr_code_svg_restaurant_brand_path(@restaurant, @brand), class: "bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download SVG</span>
        <% end %>
      </div>
      <div class="mt-4 p-3 bg-indigo-50 rounded-lg">
        <p class="text-xs text-indigo-700 font-semibold mb-1">Public Menu URL:</p>
        <p class="text-xs text-indigo-900 font-mono break-all"><%= menu_url %></p>
      </div>
    </div>
  </div>
</div>
