<% content_for :title, "Virtual Brands - #{@restaurant.name}" %>

<div class="brands-index">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Virtual Restaurant Brands</h1>
        <p class="text-gray-600 mt-1"><%= @restaurant.name %></p>
      </div>
    </div>
  </div>

  <!-- Info Banner -->
  <div class="bg-blue-50 border-2 border-blue-300 rounded-xl p-6 mb-8">
    <div class="flex items-start gap-4">
      <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <h3 class="text-lg font-bold text-blue-900 mb-2">Multi-Brand Support for Virtual Restaurants</h3>
        <p class="text-blue-800 mb-2">Create multiple virtual restaurant brands from the same kitchen. Each brand can have its own menu, branding, and QR codes while sharing the same physical location and ingredients.</p>
        <p class="text-sm text-blue-700">Perfect for ghost kitchens, cloud kitchens, and virtual restaurant concepts.</p>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="mb-8 flex justify-end">
    <%= link_to new_restaurant_brand_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      <span>New Brand</span>
    <% end %>
  </div>

  <!-- Brands Grid -->
  <% if @brands.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @brands.each do |brand| %>
        <div class="bg-white rounded-xl shadow-lg p-6 border-2 <%= brand.active? ? 'border-indigo-300 hover:border-indigo-400' : 'border-gray-200' %> hover:shadow-xl transition-all duration-200">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-xl font-bold text-gray-900"><%= brand.name %></h3>
                <% if brand.active? %>
                  <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-bold rounded-full">Active</span>
                <% else %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-800 text-xs font-bold rounded-full">Inactive</span>
                <% end %>
              </div>
              <% if brand.description.present? %>
                <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= brand.description %></p>
              <% end %>
            </div>
            <% if brand.brand_color.present? %>
              <div class="w-8 h-8 rounded-full border-2 border-gray-300" style="background-color: <%= brand.brand_color %>"></div>
            <% end %>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
            <div>
              <p class="text-gray-500 mb-1">Menu Items</p>
              <p class="text-2xl font-bold text-indigo-600"><%= brand.menu_items_count %></p>
            </div>
            <div>
              <p class="text-gray-500 mb-1">QR Codes</p>
              <p class="text-2xl font-bold text-indigo-600"><%= brand.qr_codes.count %></p>
            </div>
          </div>

          <div class="flex gap-2 pt-4 border-t border-gray-200">
            <%= link_to restaurant_brand_path(@restaurant, brand), class: "flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              <span>View</span>
            <% end %>
            <%= link_to edit_restaurant_brand_path(@restaurant, brand), class: "flex-1 bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <span>Edit</span>
            <% end %>
            <%= link_to restaurant_brand_path(@restaurant, brand), 
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete '#{brand.name}'? This will not delete menu items, but they will become unassigned." }, 
                        class: "flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <span>Delete</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-lg p-12 border-2 border-dashed border-gray-200 text-center">
      <svg class="w-20 h-20 text-indigo-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Virtual Brands Yet</h3>
      <p class="text-gray-600 mb-6">Create your first virtual restaurant brand to offer multiple menus from the same kitchen</p>
      <%= link_to new_restaurant_brand_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create First Brand</span>
      <% end %>
    </div>
  <% end %>
</div>
