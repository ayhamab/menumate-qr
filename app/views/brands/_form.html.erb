<%= form_with model: [@restaurant, brand], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
  <% if brand.errors.any? %>
    <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6 mb-8">
      <h3 class="text-red-800 font-bold mb-2">
        <%= pluralize(brand.errors.count, "error") %> found:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% brand.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <!-- Name -->
    <div>
      <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Brand Name <span class="text-red-500">*</span>
      <% end %>
      <%= form.text_field :name, 
                          required: true,
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                          placeholder: "e.g., Pizza Express, Burger House" %>
      <p class="text-xs text-gray-500 mt-1">The name of your virtual restaurant brand</p>
    </div>

    <!-- Description -->
    <div>
      <%= form.label :description, class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :description, 
                         rows: 4,
                         class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 resize-none",
                         placeholder: "Describe your brand concept and cuisine style..." %>
    </div>

    <!-- Brand Color -->
    <div>
      <%= form.label :brand_color, "Brand Color (Hex)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <div class="flex items-center gap-4">
        <%= form.text_field :brand_color, 
                            class: "w-32 px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 font-mono",
                            placeholder: "#3B82F6",
                            pattern: "^#[0-9A-Fa-f]{6}$" %>
        <div class="flex items-center gap-2">
          <div id="color_preview" class="w-12 h-12 rounded-lg border-2 border-gray-300" style="background-color: <%= brand.brand_color || '#3B82F6' %>"></div>
          <span class="text-sm text-gray-600">Preview</span>
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-1">Hex color code (e.g., #3B82F6) for brand theming</p>
    </div>

    <!-- Logo URL -->
    <div>
      <%= form.label :logo_url, "Logo URL (optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.url_field :logo_url, 
                         class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                         placeholder: "https://example.com/logo.png" %>
      <p class="text-xs text-gray-500 mt-1">URL to your brand logo image</p>
    </div>

    <!-- Display Order -->
    <div>
      <%= form.label :display_order, "Display Order", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.number_field :display_order, 
                           value: brand.display_order || 0,
                           class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      <p class="text-xs text-gray-500 mt-1">Lower numbers appear first in lists</p>
    </div>

    <!-- Active Status -->
    <div class="flex items-center gap-3">
      <%= form.check_box :active, 
                        class: "w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
      <%= form.label :active, "Brand is active", class: "text-sm font-semibold text-gray-700 cursor-pointer" %>
    </div>
    <p class="text-xs text-gray-500">Inactive brands won't appear in public menus</p>

    <!-- Form Actions -->
    <div class="flex items-center justify-between pt-6 border-t border-gray-200 mt-8">
      <%= link_to restaurant_brands_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" do %>
        Cancel
      <% end %>
      <%= form.submit brand.new_record? ? "Create Brand" : "Update Brand", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
    </div>
  </div>
<% end %>

<script>
  // Color preview update
  document.addEventListener('DOMContentLoaded', function() {
    const colorInput = document.querySelector('input[name*="brand_color"]');
    const colorPreview = document.getElementById('color_preview');
    
    if (colorInput && colorPreview) {
      colorInput.addEventListener('input', function() {
        const color = this.value || '#3B82F6';
        if (/^#[0-9A-Fa-f]{6}$/.test(color)) {
          colorPreview.style.backgroundColor = color;
        }
      });
    }
  });
</script>

