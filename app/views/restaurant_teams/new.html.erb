<% content_for :title, "Add Team Member - #{@restaurant.name}" %>

<div class="team-form-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Add Team Member</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <% begin %>
        <%= link_to restaurant_restaurant_team_index_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to Team</span>
        <% end %>
      <% rescue %>
        <%= link_to "/restaurants/#{@restaurant.id}/team", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to Team</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= form_with model: [@restaurant, @restaurant_team], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
    <% if @restaurant_team.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-6 mb-8 rounded-lg" role="alert">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-4 flex-1">
            <h3 class="text-lg font-semibold text-red-800 mb-2">
              <%= pluralize(@restaurant_team.errors.count, "error") %> prohibited this team member from being added:
            </h3>
            <div class="text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @restaurant_team.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="space-y-6">
      <!-- User Selection -->
      <div>
        <%= form.label :user_id, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          User <span class="text-red-500">*</span>
        <% end %>
        <%= form.collection_select :user_id, 
                                    @available_users, 
                                    :id, 
                                    :email,
                                    { prompt: "Select a user..." },
                                    { 
                                      required: true,
                                      class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900"
                                    } %>
        <p class="mt-1 text-xs text-gray-500">Select a user to add to the team. They must have an account.</p>
      </div>

      <!-- Role Selection -->
      <div>
        <%= form.label :role, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Role <span class="text-red-500">*</span>
        <% end %>
        <%= form.select :role,
                         [
                           ['Chef', 'chef'],
                           ['Manager', 'manager'],
                           ['Staff', 'staff']
                         ],
                         { prompt: "Select a role..." },
                         { 
                           required: true,
                           class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900"
                         } %>
        <div class="mt-3 space-y-2 text-sm text-gray-600">
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-purple-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <strong>Chef:</strong> Can edit, create, and delete menu items. Can approve changes.
            </div>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <strong>Manager:</strong> Can edit menu items and manage team members. Can view analytics.
            </div>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-gray-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <strong>Staff:</strong> Can view menu items, add comments, and view assignments.
            </div>
          </div>
        </div>
      </div>

      <!-- Active Status -->
      <div class="flex items-center gap-3">
        <%= form.check_box :active, { checked: true }, true, false %>
        <%= form.label :active, "Active team member", class: "text-sm font-semibold text-gray-700" %>
        <p class="text-xs text-gray-500">Inactive members cannot access the restaurant</p>
      </div>

      <!-- Form Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-200 mt-8">
        <% begin %>
          <%= link_to "Cancel", restaurant_restaurant_team_index_path(@restaurant), class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% rescue %>
          <%= link_to "Cancel", "/restaurants/#{@restaurant.id}/team", class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% end %>
        <%= form.submit "Add Team Member", class: "w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

