<% content_for :title, "Team - #{@restaurant.name}" %>

<div class="team-management-page">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Team Management</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
        <% if can_manage_team?(@restaurant) %>
          <% begin %>
            <%= link_to new_restaurant_restaurant_team_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Add Team Member</span>
            <% end %>
          <% rescue %>
            <%= link_to "/restaurants/#{@restaurant.id}/team/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Add Team Member</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Team Members Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <!-- Owner -->
    <% if @restaurant.user.present? %>
      <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl shadow-xl p-6 border-2 border-yellow-200">
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="bg-yellow-500 w-12 h-12 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 text-lg">Owner</h3>
              <p class="text-sm text-gray-600"><%= @restaurant.user.email %></p>
            </div>
          </div>
        </div>
        <div class="bg-yellow-100 text-yellow-800 text-xs font-bold px-3 py-1 rounded-full inline-block">
          Full Access
        </div>
      </div>
    <% end %>

    <!-- Team Members -->
    <% @restaurant_teams.each do |team_member| %>
      <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-200 hover:shadow-2xl transition-all duration-200">
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="bg-indigo-100 w-12 h-12 rounded-full flex items-center justify-center">
              <% role_icon = case team_member.role
                when 'chef'
                  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>'
                when 'manager'
                  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>'
                else
                  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>'
                end %>
              <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <%= role_icon.html_safe %>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 text-lg"><%= team_member.user.email %></h3>
              <p class="text-sm text-gray-600 capitalize"><%= team_member.role %></p>
            </div>
          </div>
        </div>
        
        <div class="flex items-center justify-between">
          <div class="flex gap-2">
            <% role_badge = case team_member.role
              when 'chef'
                'bg-purple-100 text-purple-800'
              when 'manager'
                'bg-blue-100 text-blue-800'
              else
                'bg-gray-100 text-gray-800'
            end %>
            <span class="text-xs font-bold px-3 py-1 rounded-full <%= role_badge %> capitalize">
              <%= team_member.role %>
            </span>
            <% unless team_member.active? %>
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-red-100 text-red-800">
                Inactive
              </span>
            <% end %>
          </div>
          
          <% if can_manage_team?(@restaurant) %>
            <div class="flex gap-2">
              <% begin %>
                <%= link_to edit_restaurant_restaurant_team_path(@restaurant, team_member), class: "text-indigo-600 hover:text-indigo-800" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>
              <% rescue %>
                <%= link_to "/restaurants/#{@restaurant.id}/team/#{team_member.id}/edit", class: "text-indigo-600 hover:text-indigo-800" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>
              <% end %>
              <%= link_to restaurant_restaurant_team_path(@restaurant, team_member), 
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove #{team_member.user.email} from the team?" }, 
                          class: "text-red-600 hover:text-red-800" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Empty State -->
  <% if @restaurant_teams.empty? && @restaurant.user.present? %>
    <div class="bg-white rounded-2xl shadow-lg p-12 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <h3 class="text-xl font-bold text-gray-900 mb-2">No Team Members Yet</h3>
      <p class="text-gray-600 mb-6">Add chefs and staff to collaborate on menu management</p>
      <% if can_manage_team?(@restaurant) %>
        <% begin %>
          <%= link_to new_restaurant_restaurant_team_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add First Team Member</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/team/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add First Team Member</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <!-- Role Permissions Info -->
  <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-2xl shadow-lg p-8 border border-indigo-100 mt-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Role Permissions</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white rounded-xl p-4 border border-gray-200">
        <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
          <span class="bg-yellow-500 text-white text-xs font-bold px-2 py-1 rounded">Owner</span>
        </h3>
        <ul class="text-sm text-gray-600 space-y-2">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Full access
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Manage team
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Edit/Delete items
          </li>
        </ul>
      </div>
      
      <div class="bg-white rounded-xl p-4 border border-gray-200">
        <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
          <span class="bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded">Chef</span>
        </h3>
        <ul class="text-sm text-gray-600 space-y-2">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Edit menu items
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Create/Delete items
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Approve changes
          </li>
        </ul>
      </div>
      
      <div class="bg-white rounded-xl p-4 border border-gray-200">
        <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
          <span class="bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded">Manager</span>
        </h3>
        <ul class="text-sm text-gray-600 space-y-2">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Edit menu items
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Manage team
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            View analytics
          </li>
        </ul>
      </div>
      
      <div class="bg-white rounded-xl p-4 border border-gray-200">
        <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
          <span class="bg-gray-500 text-white text-xs font-bold px-2 py-1 rounded">Staff</span>
        </h3>
        <ul class="text-sm text-gray-600 space-y-2">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            View menu items
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Add comments
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            View assignments
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

