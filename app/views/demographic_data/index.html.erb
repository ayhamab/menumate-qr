<% content_for :title, "Demographic Data - #{@restaurant.name}" %>

<div class="demographic-data-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Demographic Data</h1>
        <p class="text-gray-600 text-lg">Local demographics for ML predictions</p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <span>Back</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to new_restaurant_demographic_data_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add Data</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/demographic_data/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <span>Add Data</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @demographic_data.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <% @demographic_data.each do |data| %>
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h3 class="text-2xl font-bold text-gray-900 mb-2"><%= data.region_code %></h3>
              <div class="flex items-center gap-2">
                <span class="bg-<%= data.verified? ? 'green' : 'yellow' %>-100 text-<%= data.verified? ? 'green' : 'yellow' %>-800 text-xs font-bold px-3 py-1 rounded-full">
                  <%= data.data_source.humanize %>
                </span>
                <% if data.verified? %>
                  <span class="bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full">
                    Verified
                  </span>
                <% end %>
              </div>
            </div>
            <div class="flex gap-2">
              <% begin %>
                <%= link_to restaurant_demographic_data_path(@restaurant, data), class: "text-indigo-600 hover:text-indigo-700" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                <% end %>
              <% rescue %>
                <%= link_to "/restaurants/#{@restaurant.id}/demographic_data/#{data.id}", class: "text-indigo-600 hover:text-indigo-700" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>

          <!-- Key Metrics -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <% if data.average_age %>
              <div class="p-4 bg-blue-50 rounded-xl">
                <p class="text-sm text-gray-600 mb-1">Average Age</p>
                <p class="text-2xl font-bold text-gray-900"><%= data.average_age %></p>
              </div>
            <% end %>
            <% if data.median_income %>
              <div class="p-4 bg-green-50 rounded-xl">
                <p class="text-sm text-gray-600 mb-1">Median Income</p>
                <p class="text-2xl font-bold text-gray-900">$<%= number_with_precision(data.median_income, precision: 0, delimiter: ',') %></p>
              </div>
            <% end %>
          </div>

          <!-- Top Preferences -->
          <% if data.top_dietary_preferences.any? %>
            <div class="mb-4">
              <p class="text-sm font-semibold text-gray-700 mb-2">Top Dietary Preferences:</p>
              <div class="flex flex-wrap gap-2">
                <% data.top_dietary_preferences.each do |pref| %>
                  <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">
                    <%= pref.humanize %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Cultural Group -->
          <% if data.primary_cultural_group %>
            <div class="mb-4">
              <p class="text-sm font-semibold text-gray-700 mb-2">Primary Cultural Group:</p>
              <span class="bg-purple-100 text-purple-800 text-sm font-bold px-3 py-1 rounded-full">
                <%= data.primary_cultural_group.humanize %>
              </span>
            </div>
          <% end %>

          <!-- Demographic Score -->
          <div class="mt-6 p-4 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl border border-indigo-200">
            <p class="text-sm font-semibold text-gray-700 mb-1">Demographic Score</p>
            <p class="text-3xl font-bold text-indigo-900"><%= data.demographic_score %></p>
            <p class="text-xs text-gray-600 mt-1">Composite score for ML features</p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Demographic Data</h3>
      <p class="text-gray-600 mb-8">Add demographic data to enable ML-powered menu predictions</p>
      <% begin %>
        <%= link_to new_restaurant_demographic_data_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Add Demographic Data</span>
        <% end %>
      <% rescue %>
        <%= link_to "/restaurants/#{@restaurant.id}/demographic_data/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
          <span>Add Demographic Data</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

