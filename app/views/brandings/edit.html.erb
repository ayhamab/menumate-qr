<% content_for :title, "Custom Branding - #{@restaurant.name} - MenuMate QR" %>

<div class="branding-edit">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Custom Branding</h1>
        <p class="text-gray-600 mt-1">White-label your restaurant's digital menu</p>
      </div>
    </div>
  </div>

  <!-- Info Banner -->
  <div class="bg-blue-50 border-2 border-blue-300 rounded-xl p-6 mb-8">
    <div class="flex items-start gap-3">
      <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <h3 class="text-lg font-bold text-blue-900 mb-2">White-Label Branding</h3>
        <p class="text-blue-800">
          Customize your menu's appearance with your brand colors, logo, and styling. This feature is available for Enterprise plan subscribers.
          All changes will be reflected on your public menu pages.
        </p>
      </div>
    </div>
  </div>

  <%= form_with model: [@restaurant, @branding], local: true, multipart: true, class: "space-y-8" do |f| %>
    <% if @branding.errors.any? %>
      <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6">
        <h3 class="text-red-800 font-bold mb-2">
          <%= pluralize(@branding.errors.count, "error") %> prohibited this branding from being saved:
        </h3>
        <ul class="list-disc list-inside text-red-700">
          <% @branding.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Company Information -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Company Information</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :company_name, "Company Name (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :company_name, 
                          placeholder: "Leave blank to use restaurant name",
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
          <p class="text-xs text-gray-500 mt-1">Override the restaurant name in branding</p>
        </div>

        <div>
          <%= f.label :tagline, "Tagline (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :tagline, 
                          placeholder: "e.g., 'Fresh ingredients, authentic flavors'",
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        </div>
      </div>
    </div>

    <!-- Colors -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Color Scheme</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= f.label :primary_color, "Primary Color", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="flex items-center gap-3">
            <%= f.color_field :primary_color, 
                             value: @branding.primary_color || '#4F46E5',
                             class: "w-20 h-12 border-2 border-gray-300 rounded-lg cursor-pointer" %>
            <%= f.text_field :primary_color, 
                            placeholder: "#4F46E5",
                            class: "flex-1 px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 font-mono text-sm" %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Main brand color</p>
        </div>

        <div>
          <%= f.label :secondary_color, "Secondary Color", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="flex items-center gap-3">
            <%= f.color_field :secondary_color, 
                             value: @branding.secondary_color || '#7C3AED',
                             class: "w-20 h-12 border-2 border-gray-300 rounded-lg cursor-pointer" %>
            <%= f.text_field :secondary_color, 
                            placeholder: "#7C3AED",
                            class: "flex-1 px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 font-mono text-sm" %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Secondary brand color</p>
        </div>

        <div>
          <%= f.label :accent_color, "Accent Color", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="flex items-center gap-3">
            <%= f.color_field :accent_color, 
                             value: @branding.accent_color || '#EC4899',
                             class: "w-20 h-12 border-2 border-gray-300 rounded-lg cursor-pointer" %>
            <%= f.text_field :accent_color, 
                            placeholder: "#EC4899",
                            class: "flex-1 px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 font-mono text-sm" %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Accent/highlight color</p>
        </div>
      </div>

      <!-- Color Preview -->
      <div class="mt-6 p-6 bg-gray-50 rounded-xl">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Color Preview</h3>
        <div class="flex gap-4">
          <div class="flex-1 h-20 rounded-lg" style="background-color: <%= @branding.primary_color || '#4F46E5' %>" id="primary-preview"></div>
          <div class="flex-1 h-20 rounded-lg" style="background-color: <%= @branding.secondary_color || '#7C3AED' %>" id="secondary-preview"></div>
          <div class="flex-1 h-20 rounded-lg" style="background-color: <%= @branding.accent_color || '#EC4899' %>" id="accent-preview"></div>
        </div>
      </div>
    </div>

    <!-- Typography -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Typography</h2>
      
      <div>
        <%= f.label :font_family, "Font Family", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.select :font_family,
                    options_for_select([
                      ['Inter (Default)', 'Inter, system-ui, sans-serif'],
                      ['Roboto', 'Roboto, sans-serif'],
                      ['Open Sans', 'Open Sans, sans-serif'],
                      ['Lato', 'Lato, sans-serif'],
                      ['Montserrat', 'Montserrat, sans-serif'],
                      ['Poppins', 'Poppins, sans-serif'],
                      ['Playfair Display', 'Playfair Display, serif'],
                      ['Merriweather', 'Merriweather, serif']
                    ], @branding.font_family || 'Inter, system-ui, sans-serif'),
                    {},
                    { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" } %>
        <p class="text-xs text-gray-500 mt-1">Font family for menu text</p>
      </div>

      <!-- Font Preview -->
      <div class="mt-6 p-6 bg-gray-50 rounded-xl">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Font Preview</h3>
        <p class="text-2xl" style="font-family: <%= @branding.font_family || 'Inter, system-ui, sans-serif' %>" id="font-preview">
          The quick brown fox jumps over the lazy dog
        </p>
      </div>
    </div>

    <!-- Logo & Favicon -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Logo & Favicon</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :logo, "Logo", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <% if @branding.logo.attached? %>
            <div class="mb-4">
              <%= image_tag @branding.logo, class: "max-w-xs h-auto rounded-lg border-2 border-gray-200" %>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <%= f.check_box :remove_logo, class: "w-4 h-4 text-indigo-600 border-gray-300 rounded" %>
              <%= f.label :remove_logo, "Remove logo", class: "text-sm text-gray-700" %>
            </div>
          <% end %>
          <%= f.file_field :logo, 
                          accept: "image/png,image/jpeg,image/jpg,image/svg+xml,image/webp",
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200" %>
          <p class="text-xs text-gray-500 mt-1">PNG, JPG, SVG, or WebP (max 5MB)</p>
        </div>

        <div>
          <%= f.label :favicon, "Favicon", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <% if @branding.favicon.attached? %>
            <div class="mb-4">
              <%= image_tag @branding.favicon, class: "w-16 h-16 rounded border-2 border-gray-200" %>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <%= f.check_box :remove_favicon, class: "w-4 h-4 text-indigo-600 border-gray-300 rounded" %>
              <%= f.label :remove_favicon, "Remove favicon", class: "text-sm text-gray-700" %>
            </div>
          <% end %>
          <%= f.file_field :favicon, 
                          accept: "image/png,image/jpeg,image/jpg,image/x-icon,image/svg+xml",
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200" %>
          <p class="text-xs text-gray-500 mt-1">PNG, JPG, ICO, or SVG (max 1MB)</p>
        </div>
      </div>
    </div>

    <!-- Custom CSS -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Custom CSS</h2>
      
      <div>
        <%= f.label :custom_css, "Custom CSS (Advanced)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.text_area :custom_css, 
                       rows: 10,
                       placeholder: "/* Add your custom CSS here */\n.menu-item {\n  /* your styles */\n}",
                       class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 font-mono text-sm resize-none" %>
        <p class="text-xs text-gray-500 mt-1">Add custom CSS to further customize your menu appearance (max 10,000 characters)</p>
      </div>
    </div>

    <!-- White-Label Options -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">White-Label Options</h2>
      
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <%= f.check_box :hide_menumate_branding, class: "w-5 h-5 text-indigo-600 border-gray-300 rounded mt-1" %>
          <div>
            <%= f.label :hide_menumate_branding, "Hide MenuMate QR Branding", class: "text-sm font-semibold text-gray-700 cursor-pointer" %>
            <p class="text-xs text-gray-500 mt-1">Remove MenuMate QR branding from your public menu pages</p>
          </div>
        </div>

        <div>
          <%= f.label :custom_domain, "Custom Domain (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :custom_domain, 
                          placeholder: "menu.yourrestaurant.com",
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
          <p class="text-xs text-gray-500 mt-1">Set up a custom domain for your menu (requires DNS configuration)</p>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
      <%= f.submit "Save Branding", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
      <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" do %>
        Cancel
      <% end %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Update color previews in real-time
    const colorInputs = ['primary_color', 'secondary_color', 'accent_color'];
    colorInputs.forEach(function(colorName) {
      const input = document.querySelector(`#branding_${colorName}`);
      const preview = document.getElementById(`${colorName.replace('_', '-')}-preview`);
      if (input && preview) {
        input.addEventListener('input', function() {
          preview.style.backgroundColor = this.value;
        });
      }
    });

    // Update font preview
    const fontSelect = document.querySelector('#branding_font_family');
    const fontPreview = document.getElementById('font-preview');
    if (fontSelect && fontPreview) {
      fontSelect.addEventListener('change', function() {
        fontPreview.style.fontFamily = this.value;
      });
    }
  });
</script>
