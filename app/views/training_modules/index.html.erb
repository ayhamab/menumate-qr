<% content_for :title, "Training Modules - #{@restaurant.name}" %>

<div class="training-modules-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Staff Training</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
        <% if can_edit_menu_items?(@restaurant) || restaurant_owner?(@restaurant) %>
          <% begin %>
            <%= link_to new_restaurant_training_module_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>New Module</span>
            <% end %>
          <% rescue %>
            <%= link_to "/restaurants/#{@restaurant.id}/training_modules/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>New Module</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap gap-2">
      <%= link_to restaurant_training_modules_path(@restaurant), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type].blank? ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        All Modules
      <% end %>
      <%= link_to restaurant_training_modules_path(@restaurant, type: 'dietary_requirements'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type] == 'dietary_requirements' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Dietary Requirements
      <% end %>
      <%= link_to restaurant_training_modules_path(@restaurant, type: 'allergy_safety'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type] == 'allergy_safety' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Allergy Safety
      <% end %>
      <%= link_to restaurant_training_modules_path(@restaurant, type: 'food_handling'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type] == 'food_handling' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Food Handling
      <% end %>
    </div>
  </div>

  <!-- Training Modules Grid -->
  <% if @training_modules.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @training_modules.each do |module_item| %>
        <% 
          completion = @user_completions&.dig(module_item.id)
          status_class = if completion&.passed?
            'border-green-500 bg-green-50'
          elsif completion
            'border-yellow-500 bg-yellow-50'
          else
            'border-gray-200 bg-white'
          end
        %>
        <% begin %>
          <%= link_to restaurant_training_module_path(@restaurant, module_item), class: "block rounded-2xl shadow-xl p-6 border-2 #{status_class} hover:shadow-2xl transition-all duration-200 transform hover:-translate-y-1" do %>
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900 mb-2"><%= module_item.title %></h3>
                <p class="text-sm text-gray-600 capitalize mb-2"><%= module_item.module_type.humanize %></p>
                <% if module_item.required? %>
                  <span class="inline-block bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded-full mb-2">Required</span>
                <% end %>
              </div>
              <% if completion&.passed? %>
                <div class="bg-green-500 rounded-full p-2">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
              <% elsif completion %>
                <div class="bg-yellow-500 rounded-full p-2">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              <% end %>
            </div>
            
            <div class="space-y-2 mb-4">
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Questions:</span>
                <span class="font-bold text-gray-900"><%= module_item.training_questions.count %></span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Duration:</span>
                <span class="font-bold text-gray-900">~<%= module_item.estimated_duration %> min</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Passing Score:</span>
                <span class="font-bold text-gray-900"><%= module_item.passing_score %>%</span>
              </div>
            </div>
            
            <% if completion&.passed? %>
              <div class="bg-green-100 border border-green-300 rounded-lg p-3 mt-4">
                <p class="text-xs font-semibold text-green-800">Completed: <%= completion.completed_at&.strftime("%B %d, %Y") %></p>
                <p class="text-xs text-green-700">Score: <%= completion.score %>%</p>
                <% if completion.days_until_expiry && completion.days_until_expiry < 30 %>
                  <p class="text-xs text-orange-700 font-semibold mt-1">
                    Expires in <%= completion.days_until_expiry %> days
                  </p>
                <% end %>
              </div>
            <% elsif completion %>
              <div class="bg-yellow-100 border border-yellow-300 rounded-lg p-3 mt-4">
                <p class="text-xs font-semibold text-yellow-800">In Progress</p>
              </div>
            <% else %>
              <div class="bg-indigo-100 border border-indigo-300 rounded-lg p-3 mt-4">
                <p class="text-xs font-semibold text-indigo-800">Not Started</p>
              </div>
            <% end %>
          <% end %>
        <% rescue %>
          <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= module_item.title %></h3>
            <p class="text-sm text-gray-600"><%= module_item.training_questions.count %> questions</p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Training Modules Yet</h3>
      <p class="text-gray-600 mb-8">Create training modules to educate your staff on dietary requirements and allergy safety</p>
      <% if can_edit_menu_items?(@restaurant) || restaurant_owner?(@restaurant) %>
        <% begin %>
          <%= link_to new_restaurant_training_module_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Create First Module</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/training_modules/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Create First Module</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

