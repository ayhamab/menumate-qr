<% content_for :title, "Edit Training Module - #{@training_module.title}" %>

<div class="training-module-form-page">
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Edit Training Module</h1>
    <p class="text-gray-600 text-lg"><%= @training_module.title %></p>
  </div>

  <%= form_with model: [@restaurant, @training_module], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
    <% if @training_module.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-6 mb-8 rounded-lg">
        <h3 class="text-lg font-semibold mb-2">Errors:</h3>
        <ul class="list-disc pl-5">
          <% @training_module.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div>
        <%= form.label :title, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Module Title <span class="text-red-500">*</span>
        <% end %>
        <%= form.text_field :title, required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :module_type, "Module Type", class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Module Type <span class="text-red-500">*</span>
        <% end %>
        <%= form.select :module_type,
                         [
                           ['Dietary Requirements', 'dietary_requirements'],
                           ['Allergy Safety', 'allergy_safety'],
                           ['Food Handling', 'food_handling'],
                           ['Customer Service', 'customer_service'],
                           ['General', 'general']
                         ],
                         { selected: @training_module.module_type },
                         { required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>

      <div>
        <%= form.label :description, "Description", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :description, rows: 3, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :content, "Training Content", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :content, rows: 12, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :learning_objectives, "Learning Objectives", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :learning_objectives, rows: 4, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= form.label :passing_score, "Passing Score (%)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.number_field :passing_score, min: 0, max: 100, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= form.label :certification_valid_days, "Certification Valid (days)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.number_field :certification_valid_days, min: 0, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Optional" %>
        </div>

        <div>
          <%= form.label :position, "Position", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.number_field :position, min: 0, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <div class="flex items-center gap-3">
          <%= form.check_box :active, checked: @training_module.active != false %>
          <%= form.label :active, "Active (visible to staff)", class: "text-sm font-semibold text-gray-700" %>
        </div>
        <div class="flex items-center gap-3">
          <%= form.check_box :required, checked: @training_module.required == true %>
          <%= form.label :required, "Required Training", class: "text-sm font-semibold text-gray-700" %>
        </div>
      </div>

      <div>
        <%= form.label :notes, "Admin Notes", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :notes, rows: 3, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-200 mt-8">
        <% begin %>
          <%= link_to "Cancel", restaurant_training_module_path(@restaurant, @training_module), class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/training_modules/#{@training_module.id}", class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% end %>
        <%= form.submit "Update Module", class: "w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

