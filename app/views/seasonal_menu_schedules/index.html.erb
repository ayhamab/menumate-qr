<% content_for :title, "Seasonal Menu Schedules - #{@restaurant.name}" %>

<div class="seasonal-menu-schedules">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Seasonal Menu Schedules</h1>
        <p class="text-gray-600 mt-1"><%= @restaurant.name %></p>
      </div>
    </div>
  </div>

  <!-- Filters and Actions -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div class="flex gap-2">
        <%= link_to restaurant_seasonal_menu_schedules_path(@restaurant, status: 'active'), 
                    class: "px-4 py-2 rounded-lg font-semibold transition-all duration-200 #{params[:status] == 'active' || params[:status].blank? ? 'bg-green-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Active
        <% end %>
        <%= link_to restaurant_seasonal_menu_schedules_path(@restaurant, status: 'upcoming'), 
                    class: "px-4 py-2 rounded-lg font-semibold transition-all duration-200 #{params[:status] == 'upcoming' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Upcoming
        <% end %>
        <%= link_to restaurant_seasonal_menu_schedules_path(@restaurant, status: 'past'), 
                    class: "px-4 py-2 rounded-lg font-semibold transition-all duration-200 #{params[:status] == 'past' ? 'bg-gray-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Past
        <% end %>
      </div>
      <%= link_to new_restaurant_seasonal_menu_schedule_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>New Schedule</span>
      <% end %>
    </div>
  </div>

  <!-- Schedules List -->
  <% if @seasonal_menu_schedules.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @seasonal_menu_schedules.each do |schedule| %>
        <div class="bg-white rounded-xl shadow-lg p-6 border-2 <%= schedule.status == 'active' ? 'border-green-300' : schedule.status == 'upcoming' ? 'border-blue-300' : 'border-gray-200' %> hover:shadow-xl transition-all duration-200">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-900 mb-2"><%= schedule.name %></h3>
              <p class="text-sm text-gray-600 mb-1">
                <strong>Menu Item:</strong> <%= schedule.menu_item.name %>
              </p>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold <%= schedule.status == 'active' ? 'bg-green-100 text-green-800' : schedule.status == 'upcoming' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
              <%= schedule.status.upcase %>
            </span>
          </div>

          <div class="space-y-2 mb-4">
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span class="text-gray-700">
                <%= schedule.start_date.strftime('%b %d, %Y') %> - <%= schedule.end_date.strftime('%b %d, %Y') %>
              </span>
            </div>
            <% if schedule.start_time.present? && schedule.end_time.present? %>
              <div class="flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">
                  <%= schedule.start_time.strftime('%I:%M %p') %> - <%= schedule.end_time.strftime('%I:%M %p') %>
                </span>
              </div>
            <% end %>
            <% if schedule.recurring? %>
              <div class="flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                <span class="text-purple-700 font-semibold">
                  Recurring: <%= schedule.recurring_pattern&.humanize || 'Custom' %>
                </span>
              </div>
            <% end %>
          </div>

          <div class="flex gap-2 pt-4 border-t border-gray-200">
            <%= link_to edit_restaurant_seasonal_menu_schedule_path(@restaurant, schedule), class: "flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <span>Edit</span>
            <% end %>
            <%= link_to restaurant_seasonal_menu_schedule_path(@restaurant, schedule), 
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this schedule?" }, 
                        class: "flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <span>Delete</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-lg p-12 border-2 border-dashed border-gray-200 text-center">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <p class="text-gray-600 text-lg font-medium mb-2">No seasonal schedules yet</p>
      <p class="text-gray-500 text-sm mb-6">Create schedules to automatically show/hide menu items based on dates and times</p>
      <%= link_to new_restaurant_seasonal_menu_schedule_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create First Schedule</span>
      <% end %>
    </div>
  <% end %>
</div>
