<% content_for :title, "New Seasonal Schedule - #{@restaurant.name}" %>

<div class="mb-8">
  <div class="flex items-center gap-3 mb-4">
    <%= link_to restaurant_seasonal_menu_schedules_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
    <% end %>
    <h1 class="text-3xl font-extrabold text-gray-900">New Seasonal Schedule</h1>
  </div>
</div>

<%= render 'form', seasonal_menu_schedule: @seasonal_menu_schedule, restaurant: @restaurant %>
