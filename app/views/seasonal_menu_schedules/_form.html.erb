<%= form_with model: [@restaurant, seasonal_menu_schedule], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
  <% if seasonal_menu_schedule.errors.any? %>
    <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6 mb-8">
      <h3 class="text-red-800 font-bold mb-2">
        <%= pluralize(seasonal_menu_schedule.errors.count, "error") %> found:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% seasonal_menu_schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <!-- Name -->
    <div>
      <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Schedule Name <span class="text-red-500">*</span>
      <% end %>
      <%= form.text_field :name, 
                          required: true,
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                          placeholder: "e.g., Summer Menu, Holiday Specials" %>
      <p class="text-xs text-gray-500 mt-1">A descriptive name for this schedule</p>
    </div>

    <!-- Menu Item -->
    <div>
      <%= form.label :menu_item_id, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Menu Item <span class="text-red-500">*</span>
      <% end %>
      <%= form.select :menu_item_id,
                      options_from_collection_for_select(@menu_items, :id, :name, seasonal_menu_schedule.menu_item_id),
                      { include_blank: 'Select a menu item' },
                      { required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" } %>
    </div>

    <!-- Date Range -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :start_date, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Start Date <span class="text-red-500">*</span>
        <% end %>
        <%= form.date_field :start_date, 
                           required: true,
                           class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      </div>
      <div>
        <%= form.label :end_date, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          End Date <span class="text-red-500">*</span>
        <% end %>
        <%= form.date_field :end_date, 
                           required: true,
                           class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      </div>
    </div>

    <!-- Time Range (Optional) -->
    <div class="bg-indigo-50 border-2 border-indigo-200 rounded-xl p-6">
      <h3 class="text-sm font-semibold text-indigo-900 mb-4">Time Range (Optional)</h3>
      <p class="text-xs text-indigo-700 mb-4">Set specific times when the menu item should be available each day</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :start_time, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Start Time
          <% end %>
          <%= form.time_field :start_time, 
                             class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        </div>
        <div>
          <%= form.label :end_time, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            End Time
          <% end %>
          <%= form.time_field :end_time, 
                             class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        </div>
      </div>
    </div>

    <!-- Recurring Options -->
    <div class="bg-purple-50 border-2 border-purple-200 rounded-xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <%= form.check_box :recurring, 
                          class: "w-5 h-5 text-purple-600 border-gray-300 rounded focus:ring-purple-500",
                          data: { controller: "toggle", action: "change->toggle#toggle" } %>
        <%= form.label :recurring, "Make this schedule recurring", class: "text-sm font-semibold text-purple-900 cursor-pointer" %>
      </div>
      <div id="recurring_options" class="<%= 'hidden' unless seasonal_menu_schedule.recurring? %>">
        <p class="text-xs text-purple-700 mb-4">The schedule will repeat based on the pattern you select</p>
        <%= form.label :recurring_pattern, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Recurring Pattern
        <% end %>
        <%= form.select :recurring_pattern,
                        options_for_select([
                          ['Yearly (same date each year)', 'yearly'],
                          ['Monthly (same day of month)', 'monthly'],
                          ['Weekly (same day of week)', 'weekly'],
                          ['Daily (every day in date range)', 'daily']
                        ], seasonal_menu_schedule.recurring_pattern),
                        { include_blank: 'Select pattern' },
                        { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" } %>
      </div>
    </div>

    <!-- Active Status -->
    <div class="flex items-center gap-3">
      <%= form.check_box :active, 
                        class: "w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
      <%= form.label :active, "Schedule is active", class: "text-sm font-semibold text-gray-700 cursor-pointer" %>
    </div>
    <p class="text-xs text-gray-500">Inactive schedules won't affect menu item visibility</p>

    <!-- Form Actions -->
    <div class="flex items-center justify-between pt-6 border-t border-gray-200 mt-8">
      <%= link_to restaurant_seasonal_menu_schedules_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" do %>
        Cancel
      <% end %>
      <%= form.submit seasonal_menu_schedule.new_record? ? "Create Schedule" : "Update Schedule", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
    </div>
  </div>
<% end %>

<script>
  // Toggle recurring options visibility
  document.addEventListener('DOMContentLoaded', function() {
    const recurringCheckbox = document.querySelector('input[type="checkbox"][name*="recurring"]');
    const recurringOptions = document.getElementById('recurring_options');
    
    if (recurringCheckbox) {
      recurringCheckbox.addEventListener('change', function() {
        if (this.checked) {
          recurringOptions.classList.remove('hidden');
        } else {
          recurringOptions.classList.add('hidden');
        }
      });
    }
  });
</script>

