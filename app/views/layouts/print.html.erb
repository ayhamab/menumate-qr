<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Menu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      @media print {
        body { margin: 0; padding: 20px; }
        .no-print { display: none !important; }
        .page-break { page-break-after: always; }
        @page { margin: 1cm; }
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.6;
        color: #1f2937;
      }
      .print-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 3px solid #4f46e5;
      }
      .print-header h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
        color: #1f2937;
      }
      .print-header p {
        color: #6b7280;
        margin: 5px 0;
      }
      .menu-section {
        margin-bottom: 40px;
      }
      .menu-section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #4f46e5;
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 2px solid #e5e7eb;
      }
      .menu-item {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e5e7eb;
      }
      .menu-item:last-child {
        border-bottom: none;
      }
      .menu-item-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 5px;
      }
      .menu-item-description {
        color: #6b7280;
        margin-bottom: 8px;
        font-size: 0.95rem;
      }
      .menu-item-price {
        font-size: 1.1rem;
        font-weight: 600;
        color: #4f46e5;
      }
      .dietary-tags {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }
      .dietary-tag {
        font-size: 0.75rem;
        padding: 2px 8px;
        background: #e0e7ff;
        color: #4338ca;
        border-radius: 4px;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <%= yield %>
    <script>
      window.onload = function() {
        window.print();
      }
    </script>
  </body>
</html>

