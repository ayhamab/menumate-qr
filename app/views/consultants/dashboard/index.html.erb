<% content_for :title, "Consultant Dashboard - #{@consultant.display_name}" %>

<div class="consultant-dashboard-page">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Consultant Dashboard</h1>
        <p class="text-gray-600 text-lg"><%= @consultant.display_name %></p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to new_consultants_client_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add Client</span>
          <% end %>
        <% rescue %>
          <%= link_to "/consultants/clients/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add Client</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-indigo-100">
      <div class="flex items-center justify-between mb-4">
        <div class="bg-indigo-100 rounded-full p-3">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
      </div>
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:total_clients] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Total Clients</p>
      <p class="text-indigo-600 text-xs mt-1"><%= @stats[:active_clients] %> active</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-green-100">
      <div class="flex items-center justify-between mb-4">
        <div class="bg-green-100 rounded-full p-3">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:total_menu_items] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Menu Items Managed</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-yellow-100">
      <div class="flex items-center justify-between mb-4">
        <div class="bg-yellow-100 rounded-full p-3">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
        </div>
      </div>
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:pending_tasks] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Pending Tasks</p>
      <% if @stats[:urgent_tasks] > 0 %>
        <p class="text-red-600 text-xs mt-1 font-bold"><%= @stats[:urgent_tasks] %> urgent</p>
      <% end %>
      <% if @stats[:overdue_tasks] > 0 %>
        <p class="text-orange-600 text-xs mt-1 font-bold"><%= @stats[:overdue_tasks] %> overdue</p>
      <% end %>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-purple-100">
      <div class="flex items-center justify-between mb-4">
        <div class="bg-purple-100 rounded-full p-3">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:completed_tasks_this_month] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Completed This Month</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Clients List -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Recent Clients</h2>
        <% begin %>
          <%= link_to consultants_clients_path, class: "text-indigo-600 hover:text-indigo-800 text-sm font-semibold" do %>
            View All →
          <% end %>
        <% rescue %>
          <%= link_to "/consultants/clients", class: "text-indigo-600 hover:text-indigo-800 text-sm font-semibold" do %>
            View All →
          <% end %>
        <% end %>
      </div>
      
      <% if @clients.any? %>
        <div class="space-y-4">
          <% @clients.each do |client| %>
            <% begin %>
              <%= link_to consultants_client_path(client), class: "block p-4 bg-gray-50 rounded-xl hover:bg-indigo-50 transition-all duration-200 border-2 border-transparent hover:border-indigo-200" do %>
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <h3 class="text-lg font-bold text-gray-900 mb-1"><%= client.restaurant.name %></h3>
                    <p class="text-sm text-gray-600"><%= client.restaurant.address %></p>
                    <div class="flex items-center gap-2 mt-2">
                      <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full">Active</span>
                      <% if client.can_edit_menu? %>
                        <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-2 py-1 rounded-full">Menu Edit</span>
                      <% end %>
                    </div>
                  </div>
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </div>
              <% end %>
            <% rescue %>
              <div class="p-4 bg-gray-50 rounded-xl">
                <h3 class="text-lg font-bold text-gray-900"><%= client.restaurant.name %></h3>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-gray-600 mb-4">No clients yet. Add your first client to get started.</p>
          <% begin %>
            <%= link_to new_consultants_client_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg transition-all duration-200" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Add First Client</span>
            <% end %>
          <% rescue %>
            <%= link_to "/consultants/clients/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg transition-all duration-200" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Add First Client</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Tasks -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Tasks</h2>
        <% if @urgent_tasks.any? || @overdue_tasks.any? %>
          <span class="bg-red-100 text-red-800 text-xs font-bold px-3 py-1 rounded-full">
            <%= @urgent_tasks.count + @overdue_tasks.count %> urgent
          </span>
        <% end %>
      </div>
      
      <% if @recent_tasks.any? %>
        <div class="space-y-3">
          <% @recent_tasks.each do |task| %>
            <div class="p-4 bg-gray-50 rounded-xl border-2 <%= 'border-red-300 bg-red-50' if task.urgent? || task.overdue? %>">
              <div class="flex items-start justify-between mb-2">
                <h3 class="text-sm font-bold text-gray-900"><%= task.title %></h3>
                <% if task.urgent? %>
                  <span class="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-full">Urgent</span>
                <% elsif task.overdue? %>
                  <span class="bg-orange-600 text-white text-xs font-bold px-2 py-1 rounded-full">Overdue</span>
                <% end %>
              </div>
              <p class="text-xs text-gray-600 mb-2"><%= task.restaurant&.name || 'General' %></p>
              <% if task.due_date.present? %>
                <p class="text-xs <%= task.overdue? ? 'text-red-600 font-bold' : task.due_soon? ? 'text-orange-600' : 'text-gray-500' %>">
                  Due: <%= task.due_date.strftime("%B %d, %Y") %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-gray-600">No pending tasks.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Pinned Notes -->
  <% if @pinned_notes.any? %>
    <div class="mt-8 bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Pinned Notes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @pinned_notes.each do |note| %>
          <div class="p-4 bg-yellow-50 rounded-xl border-2 border-yellow-200">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-sm font-bold text-gray-900"><%= note.restaurant&.name || 'General' %></h3>
              <svg class="w-4 h-4 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M5.5 17a2.5 2.5 0 01-2.5-2.5V5a2.5 2.5 0 012.5-2.5h9a2.5 2.5 0 012.5 2.5v9.5a2.5 2.5 0 01-2.5 2.5h-9zM5 5v9.5a.5.5 0 00.5.5h9a.5.5 0 00.5-.5V5a.5.5 0 00-.5-.5h-9a.5.5 0 00-.5.5z"></path>
              </svg>
            </div>
            <p class="text-sm text-gray-700 line-clamp-3"><%= note.content %></p>
            <p class="text-xs text-gray-500 mt-2"><%= note.created_at.strftime("%B %d, %Y") %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

