<% content_for :title, "My Clients - Consultant Dashboard" %>

<div class="clients-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">My Clients</h1>
        <p class="text-gray-600 text-lg">Manage your restaurant clients</p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to consultants_dashboard_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Dashboard</span>
          <% end %>
        <% rescue %>
          <%= link_to "/consultants", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Dashboard</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to new_consultants_client_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add Client</span>
          <% end %>
        <% rescue %>
          <%= link_to "/consultants/clients/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add Client</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap gap-2">
      <%= link_to consultants_clients_path, 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:status].blank? ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        All Clients
      <% end %>
      <%= link_to consultants_clients_path(status: 'active'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:status] == 'active' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Active
      <% end %>
      <%= link_to consultants_clients_path(status: 'paused'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:status] == 'paused' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Paused
      <% end %>
    </div>
  </div>

  <!-- Clients Grid -->
  <% if @clients.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @clients.each do |client| %>
        <% 
          status_class = case client.status
          when 'active'
            'border-green-500 bg-green-50'
          when 'paused'
            'border-yellow-500 bg-yellow-50'
          when 'terminated'
            'border-red-500 bg-red-50'
          else
            'border-gray-200 bg-white'
          end
        %>
        <% begin %>
          <%= link_to consultants_client_path(client), class: "block rounded-2xl shadow-xl p-6 border-2 #{status_class} hover:shadow-2xl transition-all duration-200 transform hover:-translate-y-1" do %>
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900 mb-2"><%= client.restaurant.name %></h3>
                <p class="text-sm text-gray-600 mb-3"><%= client.restaurant.address %></p>
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="bg-white text-gray-800 text-xs font-bold px-2 py-1 rounded-full capitalize">
                    <%= client.status %>
                  </span>
                  <% if client.can_edit_menu? %>
                    <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-2 py-1 rounded-full">Menu Edit</span>
                  <% end %>
                  <% if client.can_view_analytics? %>
                    <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-1 rounded-full">Analytics</span>
                  <% end %>
                </div>
              </div>
            </div>
            
            <div class="space-y-2 mb-4">
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Menu Items:</span>
                <span class="font-bold text-gray-900"><%= client.restaurant.menu_items.count %></span>
              </div>
              <% if client.start_date.present? %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Since:</span>
                  <span class="font-bold text-gray-900"><%= client.start_date.strftime("%B %Y") %></span>
                </div>
              <% end %>
            </div>
            
            <div class="pt-4 border-t border-gray-200">
              <span class="text-indigo-600 font-semibold text-sm">Manage Client →</span>
            </div>
          <% end %>
        <% rescue %>
          <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= client.restaurant.name %></h3>
            <p class="text-sm text-gray-600"><%= client.restaurant.menu_items.count %> menu items</p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Clients Yet</h3>
      <p class="text-gray-600 mb-8">Add your first restaurant client to start managing their menu</p>
      <% begin %>
        <%= link_to new_consultants_client_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Add First Client</span>
        <% end %>
      <% rescue %>
        <%= link_to "/consultants/clients/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Add First Client</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

