<% content_for :title, "#{@restaurant.name} - Client Details" %>

<div class="client-detail-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2"><%= @restaurant.name %></h1>
        <p class="text-gray-600 text-lg">Client Management</p>
        <div class="flex items-center gap-2 mt-2">
          <span class="bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full capitalize">
            <%= @client.status %>
          </span>
          <% if @client.can_edit_menu? %>
            <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">Menu Edit</span>
          <% end %>
          <% if @client.can_view_analytics? %>
            <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full">Analytics</span>
          <% end %>
        </div>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to consultants_clients_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/consultants/clients", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to consultants_client_restaurant_path(@client, @restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>View Menu</span>
          <% end %>
        <% rescue %>
          <%= link_to "/consultants/clients/#{@client.id}/restaurants/#{@restaurant.id}", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>View Menu</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
      <h3 class="text-2xl font-bold text-gray-900 mb-1"><%= @restaurant.menu_items.count %></h3>
      <p class="text-gray-600 text-sm font-semibold">Menu Items</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
      <h3 class="text-2xl font-bold text-gray-900 mb-1"><%= @active_tasks.count %></h3>
      <p class="text-gray-600 text-sm font-semibold">Active Tasks</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
      <h3 class="text-2xl font-bold text-gray-900 mb-1"><%= @recent_notes.count %></h3>
      <p class="text-gray-600 text-sm font-semibold">Recent Notes</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
      <h3 class="text-2xl font-bold text-gray-900 mb-1"><%= @recent_reports.count %></h3>
      <p class="text-gray-600 text-sm font-semibold">Reports</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Restaurant Info -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Restaurant Details -->
      <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Restaurant Information</h2>
        <div class="space-y-4">
          <div>
            <p class="text-sm font-semibold text-gray-600 mb-1">Address</p>
            <p class="text-gray-900"><%= @restaurant.address %></p>
          </div>
          <% if @restaurant.phone_number.present? %>
            <div>
              <p class="text-sm font-semibold text-gray-600 mb-1">Phone</p>
              <p class="text-gray-900"><%= @restaurant.phone_number %></p>
            </div>
          <% end %>
          <% if @restaurant.description.present? %>
            <div>
              <p class="text-sm font-semibold text-gray-600 mb-1">Description</p>
              <p class="text-gray-900"><%= @restaurant.description %></p>
            </div>
          <% end %>
          <% if @client.start_date.present? %>
            <div>
              <p class="text-sm font-semibold text-gray-600 mb-1">Client Since</p>
              <p class="text-gray-900"><%= @client.start_date.strftime("%B %d, %Y") %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Recent Notes -->
      <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Recent Notes</h2>
          <% begin %>
            <%= link_to consultants_client_restaurant_consultant_notes_path(@client, @restaurant), class: "text-indigo-600 hover:text-indigo-800 text-sm font-semibold" do %>
              View All →
            <% end %>
          <% rescue %>
            <%= link_to "/consultants/clients/#{@client.id}/restaurants/#{@restaurant.id}/consultant_notes", class: "text-indigo-600 hover:text-indigo-800 text-sm font-semibold" do %>
              View All →
            <% end %>
          <% end %>
        </div>
        <% if @recent_notes.any? %>
          <div class="space-y-3">
            <% @recent_notes.each do |note| %>
              <div class="p-4 bg-gray-50 rounded-xl">
                <p class="text-sm text-gray-700 mb-2"><%= note.content %></p>
                <p class="text-xs text-gray-500"><%= note.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-600 text-center py-4">No notes yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Quick Actions -->
      <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Quick Actions</h3>
        <div class="space-y-2">
          <% begin %>
            <%= link_to consultants_client_restaurant_path(@client, @restaurant), class: "w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span>View Menu</span>
            <% end %>
          <% rescue %>
            <%= link_to "/consultants/clients/#{@client.id}/restaurants/#{@restaurant.id}", class: "w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
              <span>View Menu</span>
            <% end %>
          <% end %>
          <% if @client.can_view_analytics? %>
            <% begin %>
              <%= link_to analytics_consultants_client_restaurant_path(@client, @restaurant), class: "w-full bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span>Analytics</span>
              <% end %>
            <% rescue %>
              <%= link_to "/consultants/clients/#{@client.id}/restaurants/#{@restaurant.id}/analytics", class: "w-full bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
                <span>Analytics</span>
              <% end %>
            <% end %>
          <% end %>
          <% begin %>
            <%= link_to menu_analysis_consultants_client_restaurant_path(@client, @restaurant), class: "w-full bg-green-50 hover:bg-green-100 text-green-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
              </svg>
              <span>Menu Analysis</span>
            <% end %>
          <% rescue %>
            <%= link_to "/consultants/clients/#{@client.id}/restaurants/#{@restaurant.id}/menu_analysis", class: "w-full bg-green-50 hover:bg-green-100 text-green-700 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
              <span>Menu Analysis</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Active Tasks -->
      <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Active Tasks</h3>
        <% if @active_tasks.any? %>
          <div class="space-y-2">
            <% @active_tasks.limit(5).each do |task| %>
              <div class="p-3 bg-gray-50 rounded-lg">
                <p class="text-sm font-semibold text-gray-900 mb-1"><%= task.title %></p>
                <p class="text-xs text-gray-600"><%= task.task_type.humanize %></p>
                <% if task.due_date.present? %>
                  <p class="text-xs <%= task.overdue? ? 'text-red-600 font-bold' : 'text-gray-500' %>">
                    Due: <%= task.due_date.strftime("%b %d") %>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-600 text-sm text-center py-4">No active tasks.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

