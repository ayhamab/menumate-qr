<% content_for :title, "AI Suggestions - #{@menu_item.name}" %>

<div class="ai-analysis-suggestions">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_menu_item_path(@restaurant, @menu_item), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">AI Suggestions</h1>
        <p class="text-gray-600 mt-1"><%= @menu_item.name %></p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Current Values -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Current Values</h2>
      
      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Description</h3>
          <p class="text-gray-700 bg-gray-50 p-4 rounded-lg">
            <%= @menu_item.description.present? ? @menu_item.description : '<span class="text-gray-400 italic">No description</span>'.html_safe %>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Dietary Tags</h3>
          <div class="flex flex-wrap gap-2">
            <% if @menu_item.dietary_tags&.any? %>
              <% @menu_item.dietary_tags.each do |tag| %>
                <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-sm font-semibold">
                  <%= tag.humanize %>
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-400 italic">None</span>
            <% end %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Allergens</h3>
          <div class="flex flex-wrap gap-2">
            <% if @menu_item.allergens&.any? %>
              <% @menu_item.allergens.each do |allergen| %>
                <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold">
                  <%= MenuItem.common_allergens[allergen] || allergen.humanize %>
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-400 italic">None</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- AI Suggestions -->
    <div class="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-2xl shadow-xl p-8 border-2 border-purple-200">
      <div class="flex items-center gap-2 mb-6">
        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-900">AI Suggestions</h2>
        <span class="bg-purple-600 text-white text-xs font-bold px-2 py-1 rounded-full">
          <%= @suggestions[:confidence]&.upcase || 'MEDIUM' %>
        </span>
      </div>

      <% if @suggestions[:reasoning].present? %>
        <div class="bg-white rounded-lg p-4 mb-6 border border-purple-200">
          <p class="text-sm text-gray-700 italic">"<%= @suggestions[:reasoning] %>"</p>
        </div>
      <% end %>

      <%= form_with url: apply_ai_suggestions_restaurant_menu_item_path(@restaurant, @menu_item), method: :patch, local: true, class: "space-y-6" do |f| %>
        <%= hidden_field_tag 'suggestions[dietary_tags]', @suggestions[:dietary_tags]&.to_json %>
        <%= hidden_field_tag 'suggestions[allergens]', @suggestions[:allergens]&.to_json %>
        <%= hidden_field_tag 'suggestions[description]', @suggestions[:description] %>

        <div>
          <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Suggested Description</h3>
          <p class="text-gray-800 bg-white p-4 rounded-lg border-2 border-purple-300">
            <%= @suggestions[:description] || 'No suggestion' %>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Suggested Dietary Tags</h3>
          <div class="flex flex-wrap gap-2">
            <% if @suggestions[:dietary_tags]&.any? %>
              <% @suggestions[:dietary_tags].each do |tag| %>
                <span class="bg-indigo-200 text-indigo-900 px-3 py-1 rounded-full text-sm font-semibold">
                  <%= tag.humanize %>
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-500 italic">No suggestions</span>
            <% end %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Suggested Allergens</h3>
          <div class="flex flex-wrap gap-2">
            <% if @suggestions[:allergens]&.any? %>
              <% @suggestions[:allergens].each do |allergen| %>
                <span class="bg-red-200 text-red-900 px-3 py-1 rounded-full text-sm font-semibold">
                  <%= MenuItem.common_allergens[allergen] || allergen.humanize %>
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-500 italic">No allergens detected</span>
            <% end %>
          </div>
        </div>

        <div class="pt-6 border-t border-purple-200 flex gap-4">
          <%= f.submit "Apply All Suggestions", class: "flex-1 bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
          <%= link_to restaurant_menu_item_path(@restaurant, @menu_item), class: "flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-xl transition-all duration-200 text-center" do %>
            Cancel
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
