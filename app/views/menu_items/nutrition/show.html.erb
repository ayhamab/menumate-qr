<% content_for :title, "Nutrition Information - #{@menu_item.name}" %>

<div class="nutrition-info">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_menu_item_path(@restaurant, @menu_item), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <h1 class="text-3xl font-extrabold text-gray-900">Nutrition Information</h1>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6"><%= @menu_item.name %></h2>

    <% if @nutrition_data.present? %>
      <div class="mb-6 p-4 bg-green-50 border-2 border-green-300 rounded-lg">
        <p class="text-green-800 font-semibold">✓ Nutrition data retrieved successfully from Edamam API</p>
      </div>

      <%= form_with url: update_nutrition_restaurant_menu_item_path(@restaurant, @menu_item), method: :patch, local: true, class: "space-y-6" do |form| %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Calories -->
          <div class="bg-indigo-50 rounded-xl p-6 border-2 border-indigo-200">
            <label class="block text-sm font-semibold text-indigo-700 mb-2">Calories</label>
            <%= form.number_field :calories, value: @nutrition_data[:calories], class: "w-full px-4 py-2 border-2 border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-gray-900", placeholder: "0" %>
            <p class="text-xs text-indigo-600 mt-1">kcal</p>
          </div>

          <!-- Protein -->
          <div class="bg-blue-50 rounded-xl p-6 border-2 border-blue-200">
            <label class="block text-sm font-semibold text-blue-700 mb-2">Protein</label>
            <%= form.number_field :protein, value: @nutrition_data[:protein], step: 0.1, class: "w-full px-4 py-2 border-2 border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900", placeholder: "0.0" %>
            <p class="text-xs text-blue-600 mt-1">grams</p>
          </div>

          <!-- Carbs -->
          <div class="bg-purple-50 rounded-xl p-6 border-2 border-purple-200">
            <label class="block text-sm font-semibold text-purple-700 mb-2">Carbohydrates</label>
            <%= form.number_field :carbs, value: @nutrition_data[:carbs], step: 0.1, class: "w-full px-4 py-2 border-2 border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-gray-900", placeholder: "0.0" %>
            <p class="text-xs text-purple-600 mt-1">grams</p>
          </div>

          <!-- Fat -->
          <div class="bg-orange-50 rounded-xl p-6 border-2 border-orange-200">
            <label class="block text-sm font-semibold text-orange-700 mb-2">Fat</label>
            <%= form.number_field :fat, value: @nutrition_data[:fat], step: 0.1, class: "w-full px-4 py-2 border-2 border-orange-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 text-gray-900", placeholder: "0.0" %>
            <p class="text-xs text-orange-600 mt-1">grams</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Fiber -->
          <div class="bg-green-50 rounded-xl p-6 border-2 border-green-200">
            <label class="block text-sm font-semibold text-green-700 mb-2">Fiber</label>
            <%= form.number_field :fiber, value: @nutrition_data[:fiber], step: 0.1, class: "w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-gray-900", placeholder: "0.0" %>
            <p class="text-xs text-green-600 mt-1">grams</p>
          </div>

          <!-- Sugar -->
          <div class="bg-pink-50 rounded-xl p-6 border-2 border-pink-200">
            <label class="block text-sm font-semibold text-pink-700 mb-2">Sugar</label>
            <%= form.number_field :sugar, value: @nutrition_data[:sugar], step: 0.1, class: "w-full px-4 py-2 border-2 border-pink-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-pink-500 text-gray-900", placeholder: "0.0" %>
            <p class="text-xs text-pink-600 mt-1">grams</p>
          </div>

          <!-- Sodium -->
          <div class="bg-gray-50 rounded-xl p-6 border-2 border-gray-200">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Sodium</label>
            <%= form.number_field :sodium, value: @nutrition_data[:sodium], class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-500 focus:border-gray-500 text-gray-900", placeholder: "0" %>
            <p class="text-xs text-gray-600 mt-1">mg</p>
          </div>

          <!-- Cholesterol -->
          <div class="bg-yellow-50 rounded-xl p-6 border-2 border-yellow-200">
            <label class="block text-sm font-semibold text-yellow-700 mb-2">Cholesterol</label>
            <%= form.number_field :cholesterol, value: @nutrition_data[:cholesterol], class: "w-full px-4 py-2 border-2 border-yellow-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 text-gray-900", placeholder: "0" %>
            <p class="text-xs text-yellow-600 mt-1">mg</p>
          </div>
        </div>

        <div class="flex items-center justify-between pt-6 border-t border-gray-200 mt-8">
          <%= link_to restaurant_menu_item_path(@restaurant, @menu_item), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" do %>
            Cancel
          <% end %>
          <%= form.submit "Save Nutrition Information", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-yellow-50 border-2 border-yellow-300 rounded-lg p-6">
        <p class="text-yellow-800 font-semibold">No nutrition data available. Please try calculating again.</p>
      </div>
    <% end %>
  </div>
</div>

