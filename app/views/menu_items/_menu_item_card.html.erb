<div id="menu_item_<%= menu_item.id %>" 
     class="bg-gray-50 rounded-lg p-4 border-2 <%= menu_item.has_allergens? ? 'border-red-300 hover:border-red-400' : 'border-gray-200 hover:border-indigo-300' %> transition-all duration-200 cursor-move relative"
     data-item-id="<%= menu_item.id %>"
     data-sortable-target="item">
  <!-- Allergy Warning Badge -->
  <% if menu_item.has_allergens? %>
    <div class="absolute top-2 right-2 bg-red-600 text-white px-2 py-1 rounded-full shadow-md flex items-center gap-1 z-10">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <span class="text-xs font-bold">ALLERGENS</span>
    </div>
  <% end %>
  
  <div class="flex items-start gap-4">
    <!-- Drag Handle -->
    <div class="flex-shrink-0 pt-1 text-gray-400 hover:text-indigo-600 transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
      </svg>
    </div>

    <!-- Item Image -->
    <% if menu_item.image.attached? %>
      <div class="flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden bg-gray-200">
        <%= image_tag menu_item.image, class: "w-full h-full object-cover", alt: menu_item.name %>
      </div>
    <% end %>

    <!-- Item Details -->
    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <h3 class="text-lg font-bold text-gray-900 mb-1"><%= menu_item.name %></h3>
          <% if menu_item.description.present? %>
            <p class="text-sm text-gray-600 mb-2 line-clamp-2"><%= menu_item.description %></p>
          <% end %>
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-4">
              <p class="text-xl font-bold text-indigo-600">$<%= number_with_precision(menu_item.price, precision: 2) %></p>
              <% if menu_item.dietary_tags.present? && menu_item.dietary_tags.any? %>
                <div class="flex flex-wrap gap-1">
                  <% menu_item.dietary_tags.first(3).each do |tag| %>
                    <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded">
                      <%= tag.humanize %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
            
            <!-- Allergy Warning -->
            <% if menu_item.has_allergens? %>
              <div class="flex items-center gap-2 p-2 bg-red-50 border border-red-300 rounded-md">
                <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <span class="text-xs font-bold text-red-800">Contains: </span>
                <div class="flex flex-wrap gap-1">
                  <% menu_item.allergens.each do |allergen| %>
                    <span class="text-xs font-semibold text-red-700 bg-red-100 px-1.5 py-0.5 rounded">
                      <%= MenuItem.common_allergens[allergen.to_s] || allergen.humanize %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          
          <!-- Rating Display -->
          <% if menu_item.has_ratings? %>
            <div class="flex items-center gap-2 mt-2">
              <div class="flex items-center gap-0.5">
                <% menu_item.rating_stars.times do %>
                  <svg class="w-4 h-4 text-yellow-400 fill-current" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                <% end %>
              </div>
              <span class="text-xs text-gray-600 font-semibold"><%= menu_item.average_rating %></span>
              <span class="text-xs text-gray-500">(<%= menu_item.rating_count %>)</span>
            </div>
          <% end %>
          
          <!-- Seasonal Schedule Badge -->
          <% if menu_item.has_seasonal_schedules? %>
            <% current_schedule = menu_item.current_seasonal_schedule %>
            <div class="mt-2">
              <% if current_schedule %>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-600 bg-green-50 px-2 py-1 rounded">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <span>Seasonal: <%= current_schedule.name %></span>
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-500 bg-gray-50 px-2 py-1 rounded">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <span>Scheduled (not active)</span>
                </span>
              <% end %>
            </div>
          <% end %>
          
          <!-- Ingredients Badge -->
          <% if menu_item.ingredients.any? %>
            <div class="mt-2">
              <%= link_to restaurant_menu_item_ingredients_path(restaurant, menu_item), class: "inline-flex items-center gap-1 text-xs font-semibold text-orange-600 hover:text-orange-800" do %>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                <span><%= pluralize(menu_item.ingredients.count, 'ingredient') %></span>
                <% if menu_item.has_cross_contamination_risk? %>
                  <span class="bg-orange-500 text-white text-xs px-1.5 py-0.5 rounded-full">⚠️</span>
                <% end %>
              <% end %>
            </div>
          <% end %>
          
          <!-- Dietary Reports Badge -->
          <% if menu_item.has_unresolved_reports? %>
            <div class="mt-2">
              <%= link_to restaurant_menu_item_dietary_accuracy_reports_path(restaurant, menu_item), class: "inline-flex items-center gap-1 text-xs font-semibold text-orange-600 hover:text-orange-800" do %>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <span><%= pluralize(menu_item.unresolved_reports_count, 'unresolved report') %></span>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Actions -->
        <div class="flex gap-2 flex-shrink-0">
          <%= button_to ai_analysis_restaurant_menu_item_path(restaurant, menu_item),
                      method: :post,
                      class: "text-purple-600 hover:text-purple-800 p-2 rounded-lg hover:bg-purple-50 transition-colors",
                      data: { turbo_frame: "_top" },
                      form: { style: "display: inline;" },
                      title: "AI Analysis" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          <% end %>
          <%= link_to edit_restaurant_menu_item_path(restaurant, menu_item), class: "text-indigo-600 hover:text-indigo-800 p-2 rounded-lg hover:bg-indigo-50 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          <% end %>
          <%= link_to restaurant_menu_item_path(restaurant, menu_item), 
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete '#{menu_item.name}'? This action cannot be undone." }, 
                      class: "text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

