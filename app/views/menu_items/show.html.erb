<% content_for :title, "#{@menu_item.name} - #{@restaurant.name} - MenuMate QR" %>

<div class="menu-item-show">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div class="flex-1">
        <h1 class="text-4xl font-extrabold text-gray-900"><%= @menu_item.name %></h1>
        <p class="text-gray-600 mt-1">from <%= @restaurant.name %></p>
      </div>
      <% if restaurant_owner?(@restaurant) %>
        <div class="flex gap-2">
          <%= link_to edit_restaurant_menu_item_path(@restaurant, @menu_item), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Edit</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Menu Item Details -->
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
    <!-- Image Section -->
    <% if @menu_item.image.attached? %>
      <div class="w-full h-96 overflow-hidden bg-gray-100">
        <%= image_tag @menu_item.image, class: "w-full h-full object-cover", alt: @menu_item.name %>
      </div>
    <% end %>
    
    <div class="p-8 md:p-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="md:col-span-2">
          <h2 class="text-3xl font-bold text-gray-900 mb-4"><%= @menu_item.name %></h2>
          
          <% if @menu_item.description.present? %>
            <div class="mb-6">
              <p class="text-gray-700 text-lg leading-relaxed"><%= @menu_item.description %></p>
            </div>
          <% end %>

          <div class="flex items-center gap-4 mb-6 flex-wrap">
            <div class="bg-indigo-100 rounded-xl px-6 py-4">
              <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide mb-1">Price</p>
              <p class="text-4xl font-bold text-indigo-700">$<%= number_with_precision(@menu_item.price, precision: 2) %></p>
            </div>
            <% if @menu_item.has_nutrition_info? %>
              <div class="bg-green-100 rounded-xl px-6 py-4">
                <p class="text-sm font-semibold text-green-600 uppercase tracking-wide mb-1">Calories</p>
                <p class="text-4xl font-bold text-green-700"><%= @menu_item.calories %></p>
                <p class="text-xs text-green-600 mt-1">kcal</p>
              </div>
            <% end %>
          </div>

          <!-- Nutrition Information -->
          <% if @menu_item.has_nutrition_info? %>
            <div class="mb-6 p-6 bg-gradient-to-br from-green-50 to-blue-50 border-2 border-green-300 rounded-xl shadow-lg">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h3 class="text-2xl font-bold text-gray-900">Nutrition Facts</h3>
                <% if @menu_item.nutrition_last_updated.present? %>
                  <span class="text-xs text-gray-500">Updated <%= time_ago_in_words(@menu_item.nutrition_last_updated) %> ago</span>
                <% end %>
              </div>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <% if @menu_item.calories.present? %>
                  <div class="bg-white rounded-lg p-4 border border-green-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Calories</p>
                    <p class="text-2xl font-bold text-indigo-700"><%= @menu_item.calories %></p>
                    <p class="text-xs text-gray-500">kcal</p>
                  </div>
                <% end %>
                <% if @menu_item.protein.present? %>
                  <div class="bg-white rounded-lg p-4 border border-blue-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Protein</p>
                    <p class="text-2xl font-bold text-blue-700"><%= number_with_precision(@menu_item.protein, precision: 1) %>g</p>
                  </div>
                <% end %>
                <% if @menu_item.carbs.present? %>
                  <div class="bg-white rounded-lg p-4 border border-purple-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Carbs</p>
                    <p class="text-2xl font-bold text-purple-700"><%= number_with_precision(@menu_item.carbs, precision: 1) %>g</p>
                  </div>
                <% end %>
                <% if @menu_item.fat.present? %>
                  <div class="bg-white rounded-lg p-4 border border-orange-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Fat</p>
                    <p class="text-2xl font-bold text-orange-700"><%= number_with_precision(@menu_item.fat, precision: 1) %>g</p>
                  </div>
                <% end %>
                <% if @menu_item.fiber.present? %>
                  <div class="bg-white rounded-lg p-4 border border-green-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Fiber</p>
                    <p class="text-2xl font-bold text-green-700"><%= number_with_precision(@menu_item.fiber, precision: 1) %>g</p>
                  </div>
                <% end %>
                <% if @menu_item.sugar.present? %>
                  <div class="bg-white rounded-lg p-4 border border-pink-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Sugar</p>
                    <p class="text-2xl font-bold text-pink-700"><%= number_with_precision(@menu_item.sugar, precision: 1) %>g</p>
                  </div>
                <% end %>
                <% if @menu_item.sodium.present? %>
                  <div class="bg-white rounded-lg p-4 border border-gray-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Sodium</p>
                    <p class="text-2xl font-bold text-gray-700"><%= @menu_item.sodium %>mg</p>
                  </div>
                <% end %>
                <% if @menu_item.cholesterol.present? %>
                  <div class="bg-white rounded-lg p-4 border border-yellow-200">
                    <p class="text-sm font-semibold text-gray-600 mb-1">Cholesterol</p>
                    <p class="text-2xl font-bold text-yellow-700"><%= @menu_item.cholesterol %>mg</p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Allergy Warning - Prominent -->
          <% if @menu_item.has_allergens? %>
            <div class="mb-6 p-6 bg-red-50 border-4 border-red-500 rounded-xl shadow-lg">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <h3 class="text-2xl font-bold text-red-800">⚠️ Contains Allergens</h3>
              </div>
              <p class="text-sm font-semibold text-red-700 mb-3">This item contains the following allergens:</p>
              <div class="flex flex-wrap gap-2">
                <% @menu_item.allergens.each do |allergen| %>
                  <span class="bg-red-600 text-white text-sm font-bold px-4 py-2 rounded-lg border-2 border-red-700 shadow-md">
                    <%= MenuItem.common_allergens[allergen.to_s] || allergen.humanize %>
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-red-600 mt-3 font-medium">Please inform your server if you have any allergies before ordering.</p>
            </div>
          <% end %>

          <% if @menu_item.dietary_tags.present? && @menu_item.dietary_tags.any? %>
            <div class="mb-6">
              <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Dietary Information</h3>
              <div class="flex flex-wrap gap-2">
                <% @menu_item.dietary_tags.each do |tag| %>
                  <span class="bg-green-100 text-green-700 text-sm font-medium px-4 py-2 rounded-full">
                    <%= tag.humanize %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="bg-gray-50 rounded-xl p-6">
            <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-4">Restaurant</h3>
            <p class="text-lg font-bold text-gray-900 mb-2"><%= @restaurant.name %></p>
            <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium inline-flex items-center gap-1" do %>
              View Restaurant
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          </div>

          <% if restaurant_owner?(@restaurant) %>
            <div class="bg-indigo-50 rounded-xl p-6">
              <h3 class="text-sm font-semibold text-indigo-700 uppercase tracking-wide mb-4">Actions</h3>
              <div class="space-y-2">
                <%= link_to restaurant_menu_item_ingredients_path(@restaurant, @menu_item), class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                  </svg>
                  <span>Ingredients</span>
                <% end %>
                <%= button_to calculate_nutrition_restaurant_menu_item_path(@restaurant, @menu_item),
                            method: :post,
                            class: "w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2",
                            data: { turbo_frame: "_top" } do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                  <span><%= @menu_item.has_nutrition_info? ? 'Recalculate' : 'Calculate' %> Nutrition</span>
                <% end %>
                <%= button_to ai_analysis_restaurant_menu_item_path(@restaurant, @menu_item), 
                            method: :post,
                            class: "w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2",
                            data: { turbo_frame: "_top" } do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                  <span>AI Analysis</span>
                <% end %>
                <%= link_to edit_restaurant_menu_item_path(@restaurant, @menu_item), class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                  <span>Edit Item</span>
                <% end %>
                <%= link_to restaurant_menu_item_path(@restaurant, @menu_item), 
                            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete '#{@menu_item.name}'? This action cannot be undone." }, 
                            class: "w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <span>Delete Item</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Rating Section -->
  <div class="mt-8 bg-white rounded-2xl shadow-xl overflow-hidden">
    <div class="p-8">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Customer Ratings</h3>
      <%= render partial: "ratings/rating_section", locals: { menu_item: @menu_item } %>
    </div>
  </div>

  <!-- Dietary Accuracy Report Section -->
  <div class="mt-8 bg-white rounded-2xl shadow-xl overflow-hidden">
    <div class="p-8">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Report Dietary Inaccuracy</h3>
      <%= render partial: "dietary_accuracy_reports/report_section", locals: { menu_item: @menu_item, restaurant: @restaurant } %>
    </div>
  </div>
</div>

