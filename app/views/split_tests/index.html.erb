<% content_for :title, "Split Tests - #{@restaurant.name}" %>

<div class="split-tests-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Split Tests</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to new_restaurant_split_test_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>New Split Test</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/split_tests/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>New Split Test</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <%= form_with url: restaurant_split_tests_path(@restaurant), method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div>
        <%= f.label :status, "Status", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.select :status,
                     [['All', ''], ['Draft', 'draft'], ['Active', 'active'], ['Paused', 'paused'], ['Completed', 'completed']],
                     { selected: params[:status] },
                     { class: "px-4 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>
      <div>
        <%= f.label :type, "Test Type", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.select :type,
                     [['All', ''], ['Description', 'description'], ['Placement', 'placement'], ['Image', 'image'], ['Price', 'price']],
                     { selected: params[:type] },
                     { class: "px-4 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>
      <%= f.submit "Filter", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl transition-all duration-200" %>
      <% if params[:status].present? || params[:type].present? %>
        <%= link_to "Clear", restaurant_split_tests_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-6 rounded-xl transition-all duration-200" %>
      <% end %>
    <% end %>
  </div>

  <!-- Split Tests Grid -->
  <% if @split_tests.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @split_tests.each do |test| %>
        <% begin %>
          <%= link_to restaurant_split_test_path(@restaurant, test), class: "block bg-white rounded-2xl shadow-xl p-6 border border-gray-200 hover:shadow-2xl transition-all duration-200 transform hover:-translate-y-1" do %>
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900 mb-2"><%= test.name %></h3>
                <p class="text-sm text-gray-600 capitalize"><%= test.test_type %> test</p>
                <% if test.menu_item.present? %>
                  <p class="text-xs text-gray-500 mt-1">Menu Item: <%= test.menu_item.name %></p>
                <% end %>
              </div>
              <% status_badge = case test.status
                when 'active'
                  'bg-green-100 text-green-800'
                when 'completed'
                  'bg-blue-100 text-blue-800'
                when 'paused'
                  'bg-yellow-100 text-yellow-800'
                else
                  'bg-gray-100 text-gray-800'
              end %>
              <span class="text-xs font-bold px-3 py-1 rounded-full <%= status_badge %> capitalize">
                <%= test.status %>
              </span>
            </div>
            
            <div class="space-y-2 mb-4">
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Variants:</span>
                <span class="font-bold text-gray-900"><%= test.split_test_variants.count %></span>
              </div>
              <% stats = test.statistics %>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Impressions:</span>
                <span class="font-bold text-gray-900"><%= number_with_delimiter(stats[:total_impressions]) %></span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Conversion Rate:</span>
                <span class="font-bold text-indigo-600"><%= stats[:overall_conversion_rate] %>%</span>
              </div>
            </div>
            
            <% if test.completed? && test.winner_variant_id.present? %>
              <div class="bg-green-50 border border-green-200 rounded-lg p-3">
                <p class="text-xs font-semibold text-green-800">Winner: <%= test.winning_variant&.name %></p>
              </div>
            <% end %>
          <% end %>
        <% rescue %>
          <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= test.name %></h3>
            <p class="text-sm text-gray-600 capitalize"><%= test.test_type %> test</p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Split Tests Yet</h3>
      <p class="text-gray-600 mb-8">Create your first split test to optimize menu item performance</p>
      <% begin %>
        <%= link_to new_restaurant_split_test_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Create First Split Test</span>
        <% end %>
      <% rescue %>
        <%= link_to "/restaurants/#{@restaurant.id}/split_tests/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Create First Split Test</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

