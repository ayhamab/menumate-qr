        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Everything You Need to Modernize Your Menu
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Powerful features designed to help restaurants succeed in the digital age
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl p-8 border border-indigo-100 hover:shadow-xl transition-all duration-200">
          <div class="bg-indigo-600 w-16 h-16 rounded-xl flex items-center justify-center mb-6">
