<% content_for :title, "MenuMate QR - Digital Menus for Restaurants" %>

<div class="landing-page">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-600 text-white py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center">
        <div class="inline-block mb-6">
          <span class="bg-white/20 backdrop-blur-sm text-white text-sm font-semibold px-4 py-2 rounded-full border border-white/30">
            🚀 Trusted by 10,000+ Restaurants Worldwide
          </span>
        </div>
        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 animate-fade-in leading-tight">
          Digital Menus That<br/>
          <span class="bg-gradient-to-r from-yellow-300 to-pink-300 bg-clip-text text-transparent">Drive More Sales</span>
        </h1>
        <p class="text-xl md:text-2xl mb-4 text-indigo-100 max-w-3xl mx-auto">
          Create beautiful QR code menus in minutes. No coding required. Update your menu in real-time and boost customer engagement.
        </p>
        <p class="text-lg mb-8 text-indigo-200 max-w-2xl mx-auto">
          Join thousands of restaurants using MenuMate QR to modernize their menu experience and increase revenue.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
          <% begin %>
            <%= link_to onboarding_welcome_path, class: "bg-white text-indigo-600 font-bold py-4 px-8 rounded-xl shadow-2xl hover:shadow-3xl transform hover:-translate-y-1 transition-all duration-200 text-lg" do %>
              Start Free Trial →
            <% end %>
          <% rescue %>
            <%= link_to "/onboarding", class: "bg-white text-indigo-600 font-bold py-4 px-8 rounded-xl shadow-2xl hover:shadow-3xl transform hover:-translate-y-1 transition-all duration-200 text-lg" do %>
              Start Free Trial →
            <% end %>
          <% end %>
          <% begin %>
            <%= link_to restaurants_path, class: "bg-indigo-700 hover:bg-indigo-800 text-white font-bold py-4 px-8 rounded-xl shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-200 text-lg border-2 border-white/20" do %>
              View Examples
            <% end %>
          <% rescue %>
            <%= link_to "/restaurants", class: "bg-indigo-700 hover:bg-indigo-800 text-white font-bold py-4 px-8 rounded-xl shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-200 text-lg border-2 border-white/20" do %>
              View Examples
            <% end %>
          <% end %>
        </div>
        <p class="text-sm text-indigo-200">
          ✓ Free to start • ✓ No credit card required • ✓ Setup in 5 minutes
        </p>
      </div>
    </div>
  </section>

