              <% end %>
            <% rescue NoMethodError, NameError %>
              <%= link_to "/restaurants/#{@restaurant.id}/menu", class: "flex-1 bg-white text-indigo-600 hover:bg-indigo-50 font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>View Menu</span>
              <% end %>
              <%= link_to "/restaurants/#{@restaurant.id}/menu?print=true", target: '_blank', class: "flex-1 bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2 border-2 border-white/30" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                <span>Print</span>
              <% end %>
            <% end %>
          </div>
          
          <% if restaurant_owner?(@restaurant) %>
            <div class="w-full max-w-lg pt-6 mt-6 border-t border-white/20">
              <p class="text-xs font-semibold text-white/80 uppercase tracking-wide mb-3 text-center">Download for Printing</p>
              <div class="flex gap-2">
                <% begin %>
                  <%= link_to qr_code_png_restaurant_path(@restaurant), class: "flex-1 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm border border-white/30" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    <span>PNG</span>
                  <% end %>
                <% rescue NoMethodError, NameError %>
                  <%= link_to "/restaurants/#{@restaurant.id}/qr_code_png", class: "flex-1 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm border border-white/30" do %>
