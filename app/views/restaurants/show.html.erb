        </div>
        <div class="p-6 space-y-4">
          <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Restaurant ID</p>
            <p class="text-gray-900 font-mono text-sm">#<%= @restaurant.id %></p>
          </div>
          <div class="pt-4 border-t border-gray-200">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Created</p>
            <p class="text-gray-900 text-sm"><%= @restaurant.created_at.strftime("%B %d, %Y") %></p>
            <p class="text-gray-500 text-xs"><%= @restaurant.created_at.strftime("%I:%M %p") %></p>
          </div>
          <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Last Updated</p>
            <p class="text-gray-900 text-sm"><%= @restaurant.updated_at.strftime("%B %d, %Y") %></p>
            <p class="text-gray-500 text-xs"><%= @restaurant.updated_at.strftime("%I:%M %p") %></p>
