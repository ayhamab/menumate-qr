            <% begin %>
              <%= link_to menu_restaurant_path(@restaurant), class: "flex-1 bg-white text-indigo-600 hover:bg-indigo-50 font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2" do %>
