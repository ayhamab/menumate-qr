              <%= link_to menu_restaurant_path(@restaurant, print: true), target: '_blank', class: "flex-1 bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2 border-2 border-white/30" do %>
