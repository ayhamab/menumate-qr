              <span class="text-gray-600">Menu Items</span>
              <span class="text-2xl font-bold text-indigo-600"><%= @restaurant.menu_items.count %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-gray-600">QR Codes</span>
              <span class="text-2xl font-bold text-indigo-600"><%= @restaurant.qr_codes.count %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Restaurant Details Card -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
