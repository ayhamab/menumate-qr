                <% rescue NoMethodError, NameError %>
                  <%= link_to "/restaurants/#{@restaurant.id}/qr_code_svg", class: "flex-1 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm border border-white/30" do %>
