<% content_for :title, "#{@restaurant.name} - Menu" %>

<div class="print-header">
  <h1><%= @restaurant.name %></h1>
  <% if @restaurant.description.present? %>
    <p><%= @restaurant.description %></p>
  <% end %>
  <% if @restaurant.address.present? %>
    <p><%= @restaurant.address %></p>
  <% end %>
  <% if @restaurant.phone_number.present? %>
    <p><%= @restaurant.phone_number %></p>
  <% end %>
  <p style="margin-top: 15px; color: #9ca3af; font-size: 0.875rem;">
    Scan QR code or visit menu online
  </p>
</div>

<% @menu_items_by_category.each do |category, items| %>
  <div class="menu-section">
    <h2 class="menu-section-title">
      <%= category.present? ? category : 'Menu Items' %>
    </h2>
    
    <% items.each do |item| %>
      <div class="menu-item">
        <div class="menu-item-name"><%= item.name %></div>
        <% if item.description.present? %>
          <div class="menu-item-description"><%= item.description %></div>
        <% end %>
        <div class="menu-item-price">$<%= number_with_precision(item.price, precision: 2) %></div>
        <% if item.dietary_tags.present? && item.dietary_tags.any? %>
          <div class="dietary-tags">
            <% item.dietary_tags.each do |tag| %>
              <span class="dietary-tag"><%= tag.humanize %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div style="margin-top: 40px; padding-top: 20px; border-top: 2px solid #e5e7eb; text-align: center; color: #9ca3af; font-size: 0.875rem;">
  <p>Generated by MenuMate QR</p>
  <p><%= Date.current.strftime("%B %d, %Y") %></p>
</div>

