<% content_for :title, "Analytics - #{@restaurant.name} - MenuMate QR" %>

<div class="analytics-dashboard min-h-screen bg-gray-50 py-8 px-4">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900">Menu Analytics</h1>
          <p class="text-gray-600 mt-2">Track your menu's popularity and customer engagement</p>
        </div>
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back to Restaurant</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back to Restaurant</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- QR Scan Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-indigo-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide">Total Scans</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@total_scans) %></p>
          </div>
          <div class="bg-indigo-100 p-3 rounded-lg">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide">Today</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@scans_today) %></p>
          </div>
          <div class="bg-green-100 p-3 rounded-lg">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide">This Week</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@scans_this_week) %></p>
          </div>
          <div class="bg-blue-100 p-3 rounded-lg">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-purple-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide">This Month</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@scans_this_month) %></p>
          </div>
          <div class="bg-purple-100 p-3 rounded-lg">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <!-- Scan Trends Chart -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Scan Trends (Last 30 Days)</h2>
        <div class="h-64">
          <canvas id="scansChart"></canvas>
        </div>
      </div>

      <!-- Peak Scan Times -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Peak Scan Times</h2>
        <div class="h-64">
          <canvas id="peakTimesChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Menu Item Performance -->
    <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-900">Most Popular Menu Items</h2>
        <div class="flex gap-4 text-sm">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-indigo-500 rounded"></div>
            <span class="text-gray-600">Views</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-green-500 rounded"></div>
            <span class="text-gray-600">Clicks</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-purple-500 rounded"></div>
            <span class="text-gray-600">Orders</span>
          </div>
        </div>
      </div>

      <% if @popular_items.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Menu Item</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Views</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Clicks</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Orders</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Conversion</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @popular_items.each do |item| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-semibold text-gray-900"><%= item.name %></div>
                    <div class="text-sm text-gray-500">$<%= number_with_precision(item.price, precision: 2) %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <span class="text-gray-900 font-semibold"><%= number_with_delimiter(item.total_views || 0) %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <span class="text-gray-900 font-semibold"><%= number_with_delimiter(item.total_clicks || 0) %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <span class="text-gray-900 font-semibold"><%= number_with_delimiter(item.total_orders || 0) %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <% if item.total_views && item.total_views > 0 %>
                      <% conversion = ((item.total_clicks || 0).to_f / item.total_views * 100).round(1) %>
                      <span class="text-sm font-medium <%= conversion >= 10 ? 'text-green-600' : conversion >= 5 ? 'text-yellow-600' : 'text-red-600' %>">
                        <%= conversion %>%
                      </span>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <% begin %>
                      <%= link_to restaurant_analytics_menu_item_path(@restaurant, item), class: "text-indigo-600 hover:text-indigo-800 font-medium text-sm" do %>
                        View Details
                      <% end %>
                    <% rescue %>
                      <%= link_to "/restaurants/#{@restaurant.id}/analytics/menu_item/#{item.id}", class: "text-indigo-600 hover:text-indigo-800 font-medium text-sm" do %>
                        View Details
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <p class="text-gray-600">No menu item analytics yet. Start tracking when customers view your menu!</p>
        </div>
      <% end %>
    </div>

    <!-- Additional Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Menu Engagement -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Menu Engagement</h3>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-sm text-gray-600">Total Views</span>
              <span class="text-sm font-semibold text-gray-900"><%= number_with_delimiter(@total_menu_views) %></span>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-sm text-gray-600">Total Clicks</span>
              <span class="text-sm font-semibold text-gray-900"><%= number_with_delimiter(@total_menu_clicks) %></span>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-sm text-gray-600">Total Orders</span>
              <span class="text-sm font-semibold text-gray-900"><%= number_with_delimiter(@total_menu_orders) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Device Types -->
      <% if @device_types.any? %>
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Device Types</h3>
          <div class="space-y-3">
            <% @device_types.sort_by { |k, v| -v }.each do |device, count| %>
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-sm text-gray-600"><%= device %></span>
                  <span class="text-sm font-semibold text-gray-900"><%= number_with_delimiter(count) %></span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= (count.to_f / @device_types.values.sum * 100).round %>%"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Location Stats -->
      <% if @scans_by_location.any? %>
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Scans by Location</h3>
          <div class="space-y-3">
            <% @scans_by_location.sort_by { |k, v| -v }.each do |location, count| %>
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-sm text-gray-600"><%= location %></span>
                  <span class="text-sm font-semibold text-gray-900"><%= number_with_delimiter(count) %></span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: <%= (count.to_f / @scans_by_location.values.sum * 100).round %>%"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
  // Scan Trends Chart
  const scansCtx = document.getElementById('scansChart');
  if (scansCtx) {
    const scansData = <%= @scans_by_date.to_json.html_safe %>;
    new Chart(scansCtx, {
      type: 'line',
      data: {
        labels: Object.keys(scansData),
        datasets: [{
          label: 'QR Scans',
          data: Object.values(scansData),
          borderColor: 'rgb(99, 102, 241)',
          backgroundColor: 'rgba(99, 102, 241, 0.1)',
          tension: 0.4,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        }
      }
    });
  }

  // Peak Times Chart
  const peakTimesCtx = document.getElementById('peakTimesChart');
  if (peakTimesCtx) {
    const peakTimesData = <%= @scans_by_hour.to_json.html_safe %>;
    new Chart(peakTimesCtx, {
      type: 'bar',
      data: {
        labels: Object.keys(peakTimesData),
        datasets: [{
          label: 'Scans',
          data: Object.values(peakTimesData),
          backgroundColor: 'rgba(139, 92, 246, 0.8)',
          borderColor: 'rgb(139, 92, 246)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        }
      }
    });
  }
</script>

