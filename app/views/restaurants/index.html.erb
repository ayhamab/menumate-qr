<% content_for :title, "Restaurants - MenuMate QR" %>

<div class="restaurants-index">
  <!-- Header Section -->
  <div class="mb-10">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-5xl font-extrabold text-gray-900 mb-2">Restaurants</h1>
        <p class="text-gray-600 text-lg">Discover amazing dining experiences</p>
      </div>
      <div class="flex gap-3">
        <%= link_to "/restaurants/new", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>New Restaurant</span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @restaurants.any? %>
    <!-- Restaurants Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @restaurants.each do |restaurant| %>
        <div class="bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 transform hover:-translate-y-1">
          <div class="p-6">
            <!-- Restaurant Name -->
            <h2 class="text-2xl font-bold text-gray-900 mb-3 group">
              <%= link_to restaurant, class: "text-indigo-600 hover:text-indigo-800 transition-colors duration-200" do %>
                <%= restaurant.name %>
                <svg class="inline-block w-4 h-4 ml-1 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
            </h2>
            
            <!-- Description -->
            <% if restaurant.description.present? %>
              <p class="text-gray-600 mb-4 line-clamp-2 leading-relaxed"><%= restaurant.description %></p>
            <% end %>
            
            <!-- Contact Info -->
            <div class="space-y-2 mb-5">
              <div class="flex items-start group">
                <svg class="w-5 h-5 text-indigo-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700 text-sm"><%= restaurant.address %></span>
              </div>
              <% if restaurant.phone_number.present? %>
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-indigo-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <span class="text-gray-700 text-sm"><%= restaurant.phone_number %></span>
                </div>
              <% end %>
            </div>
            
            <!-- Action Buttons -->
            <div class="flex gap-2 pt-4 border-t border-gray-200">
              <%= link_to restaurant, class: "flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-medium py-2.5 px-4 rounded-lg text-center transition-all duration-200 text-sm" do %>
                View
              <% end %>
              <% if restaurant_owner?(restaurant) %>
                <% begin %>
                  <%= link_to edit_restaurant_path(restaurant), class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-4 rounded-lg text-center transition-all duration-200 text-sm" do %>
                    Edit
                  <% end %>
                <% rescue NoMethodError, NameError %>
                  <%= link_to "/restaurants/#{restaurant.id}/edit", class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-4 rounded-lg text-center transition-all duration-200 text-sm" do %>
                    Edit
                  <% end %>
                <% end %>
                <%= link_to restaurant, 
                            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{restaurant.name}? This action cannot be undone." }, 
                            class: "flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-medium py-2.5 px-4 rounded-lg text-center transition-all duration-200 text-sm" do %>
                  Delete
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <div class="max-w-md mx-auto">
        <div class="bg-indigo-100 rounded-full w-24 h-24 flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">No restaurants yet</h3>
        <p class="text-gray-600 mb-8 text-lg">
          Get started by creating your first restaurant!
        </p>
        <%= link_to "/restaurants/new", class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Create Your First Restaurant</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
