<% content_for :title, "Edit Recipe - #{@recipe.name}" %>

<div class="recipe-form-page">
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Edit Recipe</h1>
    <p class="text-gray-600 text-lg"><%= @recipe.name %></p>
  </div>

  <%= form_with model: [@restaurant, @recipe], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
    <% if @recipe.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-6 mb-8 rounded-lg">
        <h3 class="text-lg font-semibold mb-2">Errors:</h3>
        <ul class="list-disc pl-5">
          <% @recipe.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div>
        <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Recipe Name <span class="text-red-500">*</span>
        <% end %>
        <%= form.text_field :name, required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :menu_item_id, "Menu Item", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.collection_select :menu_item_id,
                                    @menu_items,
                                    :id,
                                    :name,
                                    { include_blank: "None (standalone recipe)" },
                                    { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>

      <div>
        <%= form.label :description, "Description", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :description, rows: 4, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= form.label :base_servings, "Base Servings", class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Base Servings <span class="text-red-500">*</span>
          <% end %>
          <%= form.number_field :base_servings, min: 1, required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= form.label :prep_time, "Prep Time (minutes)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.number_field :prep_time, min: 0, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= form.label :cook_time, "Cook Time (minutes)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.number_field :cook_time, min: 0, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div>
        <%= form.label :difficulty, "Difficulty", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.select :difficulty,
                         [['Easy', 'easy'], ['Medium', 'medium'], ['Hard', 'hard']],
                         { include_blank: "Select difficulty..." },
                         { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>

      <div>
        <%= form.label :instructions, "Instructions", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :instructions, rows: 8, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :notes, "Notes", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :notes, rows: 3, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-200 mt-8">
        <% begin %>
          <%= link_to "Cancel", restaurant_recipe_path(@restaurant, @recipe), class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/recipes/#{@recipe.id}", class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% end %>
        <%= form.submit "Update Recipe", class: "w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

