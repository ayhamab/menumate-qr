<% content_for :title, "Dietary Feedback - #{@restaurant.name}" %>

<div class="dietary-feedback-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Dietary Feedback</h1>
        <p class="text-gray-600 text-lg">Customer feedback on dietary accuracy</p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <span>Back</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to statistics_restaurant_dietary_feedbacks_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span>Statistics</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/dietary_feedbacks/statistics", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <span>Statistics</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-indigo-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:total] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Total Feedback</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-red-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:unresolved] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Unresolved</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-orange-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:critical] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Critical Issues</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-green-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:total] - @stats[:unresolved] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Resolved</p>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap items-center gap-4">
      <span class="text-sm font-semibold text-gray-700">Filter:</span>
      
      <%= link_to restaurant_dietary_feedbacks_path(@restaurant), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:unresolved].blank? && params[:type].blank? && params[:severity].blank? ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        All
      <% end %>
      
      <%= link_to restaurant_dietary_feedbacks_path(@restaurant, unresolved: 'true'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:unresolved] == 'true' ? 'bg-red-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Unresolved
      <% end %>
      
      <%= link_to restaurant_dietary_feedbacks_path(@restaurant, severity: 'critical'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:severity] == 'critical' ? 'bg-orange-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Critical
      <% end %>
    </div>
  </div>

  <!-- Feedback List -->
  <% if @feedbacks.any? %>
    <div class="space-y-4">
      <% @feedbacks.each do |feedback| %>
        <div class="bg-white rounded-2xl shadow-lg p-6 border-2 <%= feedback.critical? ? 'border-red-300' : feedback.high_severity? ? 'border-orange-300' : 'border-gray-100' %>">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-xl font-bold text-gray-900">
                  <%= link_to feedback.menu_item.name, restaurant_menu_item_path(@restaurant, feedback.menu_item), class: "hover:text-indigo-600" %>
                </h3>
                <span class="bg-<%= feedback.severity_color %>-100 text-<%= feedback.severity_color %>-800 text-xs font-bold px-3 py-1 rounded-full">
                  <%= feedback.severity.humanize %>
                </span>
                <% unless feedback.resolved? %>
                  <span class="bg-red-100 text-red-800 text-xs font-bold px-3 py-1 rounded-full">
                    Unresolved
                  </span>
                <% end %>
              </div>
              <p class="text-sm text-gray-600 mb-2">
                <strong>Type:</strong> <%= feedback.feedback_type_display %>
              </p>
              <p class="text-gray-700"><%= feedback.message %></p>
            </div>
            <div class="text-right text-sm text-gray-500">
              <%= time_ago_in_words(feedback.created_at) %> ago
            </div>
          </div>

          <!-- Tags Info -->
          <% if feedback.reported_tags.present? || feedback.suggested_tags.present? %>
            <div class="mb-4 p-3 bg-gray-50 rounded-lg">
              <% if feedback.reported_tags.present? %>
                <p class="text-xs font-semibold text-gray-700 mb-1">Reported Tags:</p>
                <div class="flex flex-wrap gap-1 mb-2">
                  <% feedback.reported_tags.each do |tag| %>
                    <span class="bg-red-100 text-red-800 text-xs font-semibold px-2 py-1 rounded-full">
                      <%= tag.humanize %>
                    </span>
                  <% end %>
                </div>
              <% end %>
              <% if feedback.suggested_tags.present? %>
                <p class="text-xs font-semibold text-gray-700 mb-1">Suggested Tags:</p>
                <div class="flex flex-wrap gap-1">
                  <% feedback.suggested_tags.each do |tag| %>
                    <span class="bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded-full">
                      <%= tag.humanize %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Actions -->
          <% unless feedback.resolved? %>
            <div class="flex gap-3 pt-4 border-t border-gray-200">
              <% begin %>
                <%= link_to resolve_restaurant_dietary_feedback_path(@restaurant, feedback), 
                            method: :post,
                            class: "bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm" do %>
                  Mark Resolved
                <% end %>
              <% rescue %>
                <%= link_to "/restaurants/#{@restaurant.id}/dietary_feedbacks/#{feedback.id}/resolve", 
                            method: :post,
                            class: "bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm" do %>
                  Mark Resolved
                <% end %>
              <% end %>
              <% begin %>
                <%= link_to restaurant_dietary_feedback_path(@restaurant, feedback), 
                            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm" do %>
                  View Details
                <% end %>
              <% rescue %>
                <%= link_to "/restaurants/#{@restaurant.id}/dietary_feedbacks/#{feedback.id}", 
                            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm" do %>
                  View Details
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="pt-4 border-t border-gray-200">
              <p class="text-sm text-gray-600">
                <strong>Resolved:</strong> <%= time_ago_in_words(feedback.resolved_at) %> ago
              </p>
              <% if feedback.resolution_notes.present? %>
                <p class="text-sm text-gray-700 mt-2"><%= feedback.resolution_notes %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Feedback Yet</h3>
      <p class="text-gray-600">Customer feedback will appear here</p>
    </div>
  <% end %>
</div>

