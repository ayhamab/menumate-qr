<% content_for :title, "Corporate Accounts" %>

<div class="corporate-accounts-index">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Corporate Accounts</h1>
        <p class="text-gray-600 mt-1">Manage your corporate restaurant accounts</p>
      </div>
      <%= link_to new_corporate_account_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create Corporate Account</span>
      <% end %>
    </div>
  </div>

  <% if @corporate_accounts.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @corporate_accounts.each do |account| %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden border-2 border-indigo-200 hover:border-indigo-400 transition-all duration-200">
          <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-4">
            <h3 class="text-xl font-bold text-white"><%= account.name %></h3>
            <p class="text-white/80 text-sm mt-1"><%= account.email %></p>
          </div>

          <div class="p-6">
            <div class="mb-4 space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Subscription</span>
                <span class="font-semibold text-gray-900"><%= account.subscription_details[:name] %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Restaurants</span>
                <span class="font-semibold text-gray-900"><%= account.restaurants.count %> / <%= account.max_restaurants == Float::INFINITY ? '∞' : account.max_restaurants %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Locations</span>
                <span class="font-semibold text-gray-900"><%= account.total_locations %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Menu Items</span>
                <span class="font-semibold text-gray-900"><%= account.total_menu_items %></span>
              </div>
            </div>

            <div class="pt-4 border-t border-gray-200 flex gap-2">
              <%= link_to corporate_account_path(account), class: "flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <span>View</span>
              <% end %>
              <%= link_to dashboard_corporate_account_path(account), class: "flex-1 bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span>Dashboard</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-xl p-12 text-center">
      <svg class="w-20 h-20 text-indigo-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Corporate Accounts</h3>
      <p class="text-gray-600 mb-6">Create a corporate account to manage multiple restaurants and locations</p>
      <%= link_to new_corporate_account_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create Corporate Account</span>
      <% end %>
    </div>
  <% end %>
</div>
