<% content_for :title, "#{@corporate_account.name} - Dashboard" %>

<div class="corporate-dashboard">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900"><%= @corporate_account.name %></h1>
        <p class="text-gray-600 mt-1">Corporate Account Dashboard</p>
      </div>
      <%= link_to corporate_account_path(@corporate_account), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
        <span>View Account</span>
      <% end %>
    </div>
  </div>

  <!-- Statistics -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-indigo-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Total Restaurants</p>
      <p class="text-3xl font-bold text-indigo-600"><%= @stats[:total_restaurants] %></p>
      <p class="text-xs text-gray-500 mt-1">
        Limit: <%= @corporate_account.max_restaurants == Float::INFINITY ? 'Unlimited' : @corporate_account.max_restaurants %>
      </p>
    </div>
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-purple-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Total Locations</p>
      <p class="text-3xl font-bold text-purple-600"><%= @stats[:total_locations] %></p>
      <p class="text-xs text-gray-500 mt-1"><%= @stats[:active_locations] %> active</p>
    </div>
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-green-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Menu Items</p>
      <p class="text-3xl font-bold text-green-600"><%= @stats[:total_menu_items] %></p>
      <p class="text-xs text-gray-500 mt-1">Across all locations</p>
    </div>
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-pink-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Restaurants with Locations</p>
      <p class="text-3xl font-bold text-pink-600"><%= @stats[:restaurants_with_locations] %></p>
      <p class="text-xs text-gray-500 mt-1">of <%= @stats[:total_restaurants] %> total</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Restaurants -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Restaurants</h2>
        <%= link_to corporate_account_path(@corporate_account), class: "text-indigo-600 hover:text-indigo-800 font-semibold text-sm" do %>
          View All →
        <% end %>
      </div>
      <% if @restaurants.any? %>
        <div class="space-y-4">
          <% @restaurants.limit(5).each do |restaurant| %>
            <div class="p-4 bg-gray-50 rounded-lg hover:bg-indigo-50 transition-colors">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-bold text-gray-900"><%= restaurant.name %></p>
                  <p class="text-sm text-gray-600"><%= restaurant.locations.count %> locations</p>
                </div>
                <span class="text-sm font-semibold text-indigo-600"><%= restaurant.menu_items.count %> items</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">No restaurants yet</p>
      <% end %>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Quick Actions</h2>
      <div class="space-y-3">
        <%= link_to corporate_account_menu_items_path(@corporate_account), class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span>Manage Menu Items</span>
        <% end %>
        <%= link_to corporate_account_locations_path(@corporate_account), class: "w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Manage Locations</span>
        <% end %>
        <%= link_to corporate_account_path(@corporate_account), class: "w-full bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <span>Account Settings</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
