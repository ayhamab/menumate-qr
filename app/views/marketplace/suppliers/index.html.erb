<% content_for :title, "Food Supplier Marketplace - MenuMate QR" %>

<div class="marketplace-page">
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-teal-600 via-cyan-600 to-blue-600 rounded-2xl shadow-2xl overflow-hidden mb-8">
    <div class="px-8 py-12 md:px-16 md:py-20">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Food Supplier Marketplace</h1>
      <p class="text-teal-100 text-xl mb-8 max-w-2xl">
        Discover quality ingredients from verified suppliers. Connect with local producers, wholesalers, and specialty importers.
      </p>
      
      <!-- Search Bar -->
      <%= form_with url: marketplace_suppliers_path, method: :get, local: true, class: "max-w-3xl" do |f| %>
        <div class="flex flex-col sm:flex-row gap-3">
          <%= f.text_field :search, 
                          value: params[:search],
                          placeholder: "Search suppliers or ingredients...",
                          class: "flex-1 px-6 py-4 rounded-xl border-2 border-white/30 bg-white/20 backdrop-blur-sm text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white focus:border-white" %>
          <%= f.submit "Search", class: "bg-white text-teal-600 font-bold py-4 px-8 rounded-xl hover:bg-teal-50 transition-all duration-200 shadow-lg" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap items-center gap-4">
      <span class="text-sm font-semibold text-gray-700">Filter by:</span>
      
      <%= link_to marketplace_suppliers_path(sort: params[:sort], search: params[:search]), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:business_type].blank? ? 'bg-teal-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        All Types
      <% end %>
      
      <% @business_types.each do |type| %>
        <%= link_to marketplace_suppliers_path(business_type: type, sort: params[:sort], search: params[:search]), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:business_type] == type ? 'bg-teal-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          <%= type.humanize %>
        <% end %>
      <% end %>
      
      <div class="ml-auto flex items-center gap-3">
        <span class="text-sm font-semibold text-gray-700">Sort:</span>
        <%= link_to marketplace_suppliers_path(business_type: params[:business_type], search: params[:search], sort: 'featured'), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:sort] == 'featured' || params[:sort].blank? ? 'bg-teal-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Featured
        <% end %>
        <%= link_to marketplace_suppliers_path(business_type: params[:business_type], search: params[:search], sort: 'rating'), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:sort] == 'rating' ? 'bg-teal-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Top Rated
        <% end %>
        <%= link_to marketplace_suppliers_path(business_type: params[:business_type], search: params[:search], sort: 'newest'), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:sort] == 'newest' ? 'bg-teal-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Newest
        <% end %>
      </div>
    </div>
  </div>

  <!-- Suppliers Grid -->
  <% if @suppliers.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <% @suppliers.each do |supplier| %>
        <% begin %>
          <%= link_to marketplace_supplier_path(supplier), class: "block bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-100 hover:border-teal-300 hover:shadow-2xl transition-all duration-200 transform hover:-translate-y-1" do %>
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <% if supplier.logo.attached? %>
                  <%= image_tag supplier.logo, class: "h-16 w-16 rounded-lg object-cover mb-3", alt: "#{supplier.company_name} logo" %>
                <% end %>
                <h3 class="text-xl font-bold text-gray-900 mb-1"><%= supplier.company_name %></h3>
                <% if supplier.business_type.present? %>
                  <p class="text-sm text-gray-600 capitalize mb-2"><%= supplier.business_type.humanize %></p>
                <% end %>
                <% if supplier.verified? %>
                  <span class="inline-block bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full mb-2">Verified</span>
                <% end %>
                <% if supplier.featured? %>
                  <span class="inline-block bg-teal-100 text-teal-800 text-xs font-bold px-2 py-1 rounded-full mb-2">Featured</span>
                <% end %>
              </div>
            </div>
            
            <% if supplier.description.present? %>
              <p class="text-gray-700 text-sm mb-4 line-clamp-2"><%= supplier.description %></p>
            <% end %>
            
            <div class="space-y-2 mb-4">
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600">Ingredients:</span>
                <span class="font-bold text-gray-900"><%= supplier.active_ingredient_count %></span>
              </div>
              <% if supplier.average_rating > 0 %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Rating:</span>
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    <span class="font-bold text-gray-900"><%= supplier.average_rating.round(1) %></span>
                    <span class="text-gray-500">(<%= supplier.total_reviews %>)</span>
                  </div>
                </div>
              <% end %>
            </div>
            
            <div class="pt-4 border-t border-gray-200">
              <span class="text-teal-600 font-semibold text-sm">View Details →</span>
            </div>
          <% end %>
        <% rescue %>
          <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-100">
            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= supplier.company_name %></h3>
            <p class="text-gray-600 text-sm"><%= supplier.active_ingredient_count %> ingredients</p>
          </div>
        <% end %>
      <% end %>
    </div>
    
    <!-- Pagination would go here if using Kaminari or similar -->
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Suppliers Found</h3>
      <p class="text-gray-600">Try adjusting your search or filters.</p>
    </div>
  <% end %>
</div>

