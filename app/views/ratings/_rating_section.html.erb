<div id="rating-section-<%= menu_item.id %>" class="mt-4">
  <% restaurant ||= menu_item.restaurant %>
  <!-- Average Rating Display -->
  <% if menu_item.has_ratings? %>
    <div class="flex items-center gap-3 mb-3">
      <div class="flex items-center gap-1">
        <% menu_item.rating_stars.times do %>
          <svg class="w-5 h-5 text-yellow-400 fill-current" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
        <% end %>
        <% (5 - menu_item.rating_stars).times do %>
          <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 20 20">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold text-gray-900"><%= menu_item.average_rating %></span>
        <span class="text-sm text-gray-600">(<%= pluralize(menu_item.rating_count, 'rating') %>)</span>
      </div>
    </div>
  <% end %>

  <!-- Rating Form -->
  <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
    <h4 class="text-sm font-semibold text-gray-700 mb-3">Rate this item</h4>
    <%= form_with model: [restaurant, menu_item, Rating.new], local: false, data: { turbo: true }, class: "space-y-3" do |f| %>
      <div id="rating-errors-<%= menu_item.id %>"></div>
      
      <div class="flex items-center gap-2" data-controller="star-rating">
        <% (1..5).each do |star| %>
          <label class="cursor-pointer">
            <%= f.radio_button :rating, star, class: "sr-only peer", data: { action: "change->star-rating#updateStars" } %>
            <svg class="w-8 h-8 text-gray-300 hover:text-yellow-400 transition-colors peer-checked:text-yellow-400 star-icon" data-star="<%= star %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
          </label>
        <% end %>
      </div>

      <div>
        <%= f.text_area :comment, 
                        rows: 2,
                        placeholder: "Optional: Share your experience...",
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm resize-none" %>
      </div>

      <div>
        <%= f.submit "Submit Rating", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm" %>
      </div>
    <% end %>
  </div>
</div>

