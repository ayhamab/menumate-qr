<% content_for :title, "Menu Item Compliance - #{@restaurant.name}" %>

<div class="menu-item-compliance-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Menu Item Compliance</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to check_all_restaurant_menu_item_compliances_path(@restaurant, region_id: params[:region_id]), method: :post, class: "bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Check All Items</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/menu_item_compliances/check_all", method: :post, class: "bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <span>Check All Items</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap items-center gap-4">
      <span class="text-sm font-semibold text-gray-700">Filter:</span>
      
      <%= link_to restaurant_menu_item_compliances_path(@restaurant), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:region_id].blank? ? 'bg-emerald-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        All Regions
      <% end %>
      
      <% @regions.each do |region| %>
        <%= link_to restaurant_menu_item_compliances_path(@restaurant, region_id: region.id), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:region_id].to_s == region.id.to_s ? 'bg-emerald-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          <%= region.name %>
        <% end %>
      <% end %>
      
      <div class="ml-auto flex items-center gap-3">
        <span class="text-sm font-semibold text-gray-700">Status:</span>
        <%= link_to restaurant_menu_item_compliances_path(@restaurant, region_id: params[:region_id]), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:status].blank? ? 'bg-emerald-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          All
        <% end %>
        <%= link_to restaurant_menu_item_compliances_path(@restaurant, status: 'compliant', region_id: params[:region_id]), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:status] == 'compliant' ? 'bg-green-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Compliant
        <% end %>
        <%= link_to restaurant_menu_item_compliances_path(@restaurant, status: 'non_compliant', region_id: params[:region_id]), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:status] == 'non_compliant' ? 'bg-red-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          Non-Compliant
        <% end %>
      </div>
    </div>
  </div>

  <!-- Compliance List -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Menu Items</h2>
    
    <% if @menu_item_compliances.any? %>
      <div class="space-y-4">
        <% @menu_item_compliances.each do |menu_item| %>
          <% 
            compliances = menu_item.menu_item_compliances
            if @region
              compliances = compliances.where(region: @region)
            end
            compliant_count = compliances.compliant.count
            non_compliant_count = compliances.non_compliant.count
            total_count = compliances.count
            is_compliant = total_count > 0 && non_compliant_count == 0
          %>
          <div class="p-6 bg-gray-50 rounded-xl border-2 <%= is_compliant ? 'border-green-500' : 'border-red-500' %>">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 mb-2"><%= menu_item.name %></h3>
                <p class="text-sm text-gray-600 mb-3"><%= menu_item.description&.truncate(100) %></p>
                <div class="flex items-center gap-3">
                  <% if is_compliant %>
                    <span class="bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Compliant
                    </span>
                  <% else %>
                    <span class="bg-red-100 text-red-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                      <%= non_compliant_count %> Issue<%= 's' if non_compliant_count != 1 %>
                    </span>
                  <% end %>
                  <span class="text-xs text-gray-600">
                    <%= compliant_count %> / <%= total_count %> laws compliant
                  </span>
                </div>
              </div>
              <% begin %>
                <%= link_to restaurant_menu_item_path(@restaurant, menu_item), class: "text-indigo-600 hover:text-indigo-800 text-sm font-semibold" do %>
                  View Details →
                <% end %>
              <% rescue %>
                <%= link_to "/restaurants/#{@restaurant.id}/menu_items/#{menu_item.id}", class: "text-indigo-600 hover:text-indigo-800 text-sm font-semibold" do %>
                  View Details →
                <% end %>
              <% end %>
            </div>
            
            <!-- Compliance Details -->
            <% if compliances.any? %>
              <div class="mt-4 pt-4 border-t border-gray-200">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <% compliances.each do |compliance| %>
                    <div class="p-3 bg-white rounded-lg border <%= compliance.compliant? ? 'border-green-300' : 'border-red-300' %>">
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-semibold text-gray-900"><%= compliance.dietary_law.name %></span>
                        <% if compliance.compliant? %>
                          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                        <% else %>
                          <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                          </svg>
                        <% end %>
                      </div>
                      <% if compliance.has_violations? %>
                        <ul class="text-xs text-red-700 space-y-1">
                          <% compliance.violations.first(2).each do |violation| %>
                            <li>• <%= violation['message'] || violation[:message] %></li>
                          <% end %>
                        </ul>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-600 mb-4">No compliance data available. Run a compliance check to get started.</p>
        <% begin %>
          <%= link_to check_all_restaurant_menu_item_compliances_path(@restaurant), method: :post, class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Run Compliance Check</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/menu_item_compliances/check_all", method: :post, class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
            <span>Run Compliance Check</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

