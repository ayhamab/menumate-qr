<% content_for :title, "Comments - #{@menu_item.name}" %>

<div class="comments-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Comments</h1>
        <p class="text-gray-600 text-lg"><%= @menu_item.name %></p>
      </div>
      <% begin %>
        <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back</span>
        <% end %>
      <% rescue %>
        <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- New Comment Form -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Add Comment</h2>
    <%= form_with model: [@restaurant, @menu_item, @comment], local: true, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :content, "Comment", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :content, rows: 4, required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Share your thoughts, suggestions, or feedback about this menu item..." %>
      </div>
      <%= form.submit "Post Comment", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" %>
    <% end %>
  </div>

  <!-- Comments List -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">
      Comments (<%= @comments.count %>)
    </h2>
    <% if @comments.any? %>
      <div class="space-y-6">
        <% @comments.each do |comment| %>
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="bg-indigo-100 w-10 h-10 rounded-full flex items-center justify-center">
                  <span class="text-indigo-600 font-bold text-sm"><%= comment.user.email.first.upcase %></span>
                </div>
                <div>
                  <h3 class="font-bold text-gray-900"><%= comment.user.email %></h3>
                  <p class="text-xs text-gray-500"><%= time_ago_in_words(comment.created_at) %> ago</p>
                </div>
              </div>
              <% if comment.user == current_user || can_edit_menu_items?(@restaurant) %>
                <div class="flex gap-2">
                  <% begin %>
                    <%= link_to edit_restaurant_menu_item_comment_path(@restaurant, @menu_item, comment), class: "text-indigo-600 hover:text-indigo-800" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    <% end %>
                  <% rescue %>
                    <%= link_to "/restaurants/#{@restaurant.id}/menu_items/#{@menu_item.id}/menu_item_comments/#{comment.id}/edit", class: "text-indigo-600 hover:text-indigo-800" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    <% end %>
                  <% end %>
                  <%= link_to restaurant_menu_item_comment_path(@restaurant, @menu_item, comment),
                              data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this comment?" },
                              class: "text-red-600 hover:text-red-800" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  <% end %>
                </div>
              <% end %>
            </div>
            <p class="text-gray-700 leading-relaxed whitespace-pre-wrap"><%= comment.content %></p>
            
            <!-- Replies -->
            <% if comment.replies.any? %>
              <div class="mt-4 pl-6 border-l-2 border-indigo-200 space-y-4">
                <% comment.replies.order(created_at: :asc).each do |reply| %>
                  <div class="bg-white rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="font-semibold text-gray-900 text-sm"><%= reply.user.email %></span>
                      <span class="text-xs text-gray-500"><%= time_ago_in_words(reply.created_at) %> ago</span>
                    </div>
                    <p class="text-sm text-gray-700"><%= reply.content %></p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-50 rounded-xl p-12 text-center border-2 border-dashed border-gray-200">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        <h3 class="text-xl font-bold text-gray-900 mb-2">No Comments Yet</h3>
        <p class="text-gray-600">Be the first to comment on this menu item</p>
      </div>
    <% end %>
  </div>
</div>

