<% content_for :title, "Menu Predictions - #{@restaurant.name}" %>

<div class="menu-predictions-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">ML Menu Predictions</h1>
        <p class="text-gray-600 text-lg">Predict menu success based on local demographics</p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to restaurant_demographic_data_index_path(@restaurant), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <span>Demographics</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/demographic_data", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <span>Demographics</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to predict_all_restaurant_menu_predictions_path(@restaurant), method: :post, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>Predict All</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/menu_predictions/predict_all", method: :post, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center gap-2" do %>
            <span>Predict All</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-indigo-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:total_predictions] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Total Predictions</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-green-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:high_confidence] %></h3>
      <p class="text-gray-600 text-sm font-semibold">High Confidence</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-blue-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= (@stats[:avg_success_score] * 100).round(1) %>%</h3>
      <p class="text-gray-600 text-sm font-semibold">Avg Success Score</p>
    </div>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-purple-100">
      <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @stats[:avg_popularity] %></h3>
      <p class="text-gray-600 text-sm font-semibold">Avg Popularity</p>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap items-center gap-4">
      <span class="text-sm font-semibold text-gray-700">Filter:</span>
      
      <%= link_to restaurant_menu_predictions_path(@restaurant), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type].blank? ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        All Types
      <% end %>
      
      <%= link_to restaurant_menu_predictions_path(@restaurant, type: 'success_score'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type] == 'success_score' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Success Score
      <% end %>
      
      <%= link_to restaurant_menu_predictions_path(@restaurant, type: 'popularity_score'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type] == 'popularity_score' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Popularity
      <% end %>
      
      <%= link_to restaurant_menu_predictions_path(@restaurant, type: 'revenue_potential'), 
                  class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:type] == 'revenue_potential' ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
        Revenue
      <% end %>
      
      <div class="ml-auto">
        <%= link_to restaurant_menu_predictions_path(@restaurant, high_confidence: params[:high_confidence] != 'true' ? 'true' : nil), 
                    class: "px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-200 #{params[:high_confidence] == 'true' ? 'bg-green-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" do %>
          High Confidence Only
        <% end %>
      </div>
    </div>
  </div>

  <!-- Predictions by Menu Item -->
  <% if @predictions_by_item.any? %>
    <div class="space-y-6">
      <% @predictions_by_item.each do |menu_item, predictions| %>
        <% 
          success_pred = predictions.find { |p| p.prediction_type == 'success_score' }
          popularity_pred = predictions.find { |p| p.prediction_type == 'popularity_score' }
          revenue_pred = predictions.find { |p| p.prediction_type == 'revenue_potential' }
          dietary_fit = predictions.find { |p| p.prediction_type == 'dietary_fit' }
        %>
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
          <div class="flex items-start justify-between mb-6">
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-gray-900 mb-2"><%= menu_item.name %></h3>
              <p class="text-gray-600 mb-4"><%= menu_item.description&.truncate(150) %></p>
              <div class="flex items-center gap-3">
                <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">
                  $<%= number_with_precision(menu_item.price, precision: 2) %>
                </span>
                <% if menu_item.category.present? %>
                  <span class="bg-gray-100 text-gray-800 text-xs font-bold px-3 py-1 rounded-full">
                    <%= menu_item.category %>
                  </span>
                <% end %>
              </div>
            </div>
            <% if menu_item.image.attached? %>
              <%= image_tag menu_item.image, class: "w-24 h-24 rounded-xl object-cover", alt: menu_item.name %>
            <% end %>
          </div>

          <!-- Predictions Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Success Score -->
            <% if success_pred %>
              <div class="p-4 bg-gradient-to-br <%= success_pred.predicted_value >= 0.7 ? 'from-green-50 to-emerald-50 border-green-300' : success_pred.predicted_value >= 0.5 ? 'from-yellow-50 to-amber-50 border-yellow-300' : 'from-red-50 to-orange-50 border-red-300' %> rounded-xl border-2">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-semibold text-gray-700">Success Score</span>
                  <% if success_pred.high_confidence? %>
                    <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-0.5 rounded-full">High</span>
                  <% end %>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-1">
                  <%= (success_pred.predicted_value * 100).round(1) %>%
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                  <div class="bg-<%= success_pred.predicted_value >= 0.7 ? 'green' : success_pred.predicted_value >= 0.5 ? 'yellow' : 'red' %>-600 h-2 rounded-full" 
                       style="width: <%= (success_pred.predicted_value * 100).round(1) %>%"></div>
                </div>
                <p class="text-xs text-gray-600">Confidence: <%= (success_pred.confidence_score * 100).round(0) %>%</p>
              </div>
            <% end %>

            <!-- Popularity Score -->
            <% if popularity_pred %>
              <div class="p-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl border-2 border-blue-300">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-semibold text-gray-700">Popularity</span>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-1">
                  <%= popularity_pred.predicted_value.round(1) %>/10
                </div>
                <div class="flex items-center gap-1 mb-2">
                  <% 10.times do |i| %>
                    <div class="w-2 h-2 rounded-full <%= i < popularity_pred.predicted_value.round ? 'bg-blue-600' : 'bg-gray-300' %>"></div>
                  <% end %>
                </div>
                <p class="text-xs text-gray-600">Based on demographics</p>
              </div>
            <% end %>

            <!-- Revenue Potential -->
            <% if revenue_pred %>
              <div class="p-4 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl border-2 border-purple-300">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-semibold text-gray-700">Revenue Potential</span>
                </div>
                <div class="text-2xl font-bold text-gray-900 mb-1">
                  $<%= number_with_precision(revenue_pred.predicted_value, precision: 0) %>
                </div>
                <p class="text-xs text-gray-600 mb-2">Estimated monthly</p>
                <p class="text-xs text-gray-500">Confidence: <%= (revenue_pred.confidence_score * 100).round(0) %>%</p>
              </div>
            <% end %>

            <!-- Dietary Fit -->
            <% if dietary_fit %>
              <div class="p-4 bg-gradient-to-br from-teal-50 to-cyan-50 rounded-xl border-2 border-teal-300">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-semibold text-gray-700">Demographic Fit</span>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-1">
                  <%= (dietary_fit.predicted_value * 100).round(1) %>%
                </div>
                <p class="text-xs text-gray-600">Local preferences</p>
              </div>
            <% end %>
          </div>

          <!-- Recommendations -->
          <% if success_pred&.recommendation %>
            <div class="mt-6 p-4 bg-indigo-50 border border-indigo-200 rounded-xl">
              <p class="text-sm font-semibold text-indigo-900 mb-2">Recommendation:</p>
              <p class="text-sm text-indigo-800"><%= success_pred.recommendation %></p>
            </div>
          <% end %>

          <!-- Risk Factors -->
          <% if success_pred&.risk_factors&.any? %>
            <div class="mt-4 p-4 bg-red-50 border border-red-200 rounded-xl">
              <p class="text-sm font-semibold text-red-900 mb-2">Risk Factors:</p>
              <ul class="text-sm text-red-800 space-y-1">
                <% success_pred.risk_factors.each do |risk| %>
                  <li>• <%= risk %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-lg p-16 text-center border-2 border-dashed border-gray-200">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Predictions Yet</h3>
      <p class="text-gray-600 mb-8">Add demographic data and generate predictions to see ML-powered insights</p>
      <div class="flex gap-4 justify-center">
        <% begin %>
          <%= link_to restaurant_demographic_data_index_path(@restaurant), class: "inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <span>Add Demographics</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/demographic_data", class: "inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
            <span>Add Demographics</span>
          <% end %>
        <% end %>
        <% begin %>
          <%= link_to predict_all_restaurant_menu_predictions_path(@restaurant), method: :post, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>Generate Predictions</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/menu_predictions/predict_all", method: :post, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" do %>
            <span>Generate Predictions</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

