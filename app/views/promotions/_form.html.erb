<%= form_with(model: [@restaurant, promotion], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100") do |form| %>
  <% if promotion.errors.any? %>
    <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6 mb-6">
      <h3 class="text-red-800 font-bold mb-2">
        <%= pluralize(promotion.errors.count, "error") %> prohibited this promotion from being saved:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% promotion.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <!-- Title Field -->
    <div>
      <%= form.label :title, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Promotion Title <span class="text-red-500">*</span>
      <% end %>
      <%= form.text_field :title, 
                          required: true,
                          class: "w-full px-4 py-3 border-2 #{promotion.errors[:title].any? ? 'border-red-500' : 'border-gray-300'} rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 placeholder-gray-400",
                          placeholder: "e.g., Summer Special, Happy Hour, Weekend Discount" %>
    </div>

    <!-- Description Field -->
    <div>
      <%= form.label :description, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Description
      <% end %>
      <%= form.text_area :description, 
                         rows: 4,
                         class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 placeholder-gray-400 resize-none",
                         placeholder: "Describe the promotion, terms and conditions, etc." %>
    </div>

    <!-- Discount Type and Value -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :discount_type, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Discount Type <span class="text-red-500">*</span>
        <% end %>
        <%= form.select :discount_type,
                        options_for_select(Promotion.discount_types.map { |k, v| [v, k] }, promotion.discount_type),
                        { prompt: "Select discount type" },
                        { required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" } %>
      </div>

      <div id="discount-value-field" style="<%= 'display: none;' if promotion.discount_type == 'special' %>">
        <%= form.label :discount_value, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Discount Value <span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <span class="text-gray-500 text-lg font-medium" id="discount-symbol"><%= promotion.discount_type == 'percentage' ? '%' : '$' %></span>
          </div>
          <%= form.number_field :discount_value,
                                step: promotion.discount_type == 'percentage' ? 1 : 0.01,
                                min: 0,
                                class: "w-full pl-8 pr-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 placeholder-gray-400",
                                placeholder: "0" %>
        </div>
      </div>
    </div>

    <!-- Date Range -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :start_date, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Start Date <span class="text-red-500">*</span>
        <% end %>
        <%= form.datetime_local_field :start_date,
                                       required: true,
                                       class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      </div>

      <div>
        <%= form.label :end_date, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          End Date <span class="text-red-500">*</span>
        <% end %>
        <%= form.datetime_local_field :end_date,
                                       required: true,
                                       class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      </div>
    </div>

    <!-- Badge Color -->
    <div>
      <%= form.label :badge_color, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Badge Color
      <% end %>
      <div class="grid grid-cols-7 gap-3">
        <% Promotion.badge_colors.each do |color, label| %>
          <label class="flex flex-col items-center cursor-pointer">
            <%= form.radio_button :badge_color, color, class: "sr-only peer" %>
            <div class="w-12 h-12 rounded-lg border-4 <%= color == 'red' ? 'bg-red-500' : color == 'orange' ? 'bg-orange-500' : color == 'yellow' ? 'bg-yellow-500' : color == 'green' ? 'bg-green-500' : color == 'blue' ? 'bg-blue-500' : color == 'purple' ? 'bg-purple-500' : 'bg-pink-500' %> peer-checked:ring-4 peer-checked:ring-indigo-500 peer-checked:ring-offset-2 transition-all"></div>
            <span class="text-xs text-gray-600 mt-1"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Menu Items Selection -->
    <div>
      <%= form.label :menu_item_ids, "Menu Items (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <p class="text-xs text-gray-500 mb-4">Select menu items to apply this promotion to. Leave empty to apply to all items.</p>
      <div class="max-h-64 overflow-y-auto border-2 border-gray-300 rounded-xl p-4 space-y-2">
        <% @restaurant.menu_items.ordered.each do |item| %>
          <label class="flex items-center gap-3 p-2 hover:bg-indigo-50 rounded-lg cursor-pointer">
            <%= form.check_box :menu_item_ids, { multiple: true, checked: promotion.menu_item_ids.include?(item.id) }, item.id, nil %>
            <div class="flex-1">
              <span class="font-medium text-gray-900"><%= item.name %></span>
              <span class="text-sm text-gray-600 ml-2">$<%= number_with_precision(item.price, precision: 2) %></span>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Active Toggle -->
    <div class="flex items-center gap-3">
      <%= form.check_box :active, class: "w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
      <%= form.label :active, "Active", class: "text-sm font-semibold text-gray-700 cursor-pointer" %>
      <p class="text-xs text-gray-500">Only active promotions will be displayed to customers</p>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
      <%= form.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
      <%= link_to restaurant_promotions_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" do %>
        Cancel
      <% end %>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const discountTypeSelect = document.querySelector('#promotion_discount_type');
      const discountValueField = document.getElementById('discount-value-field');
      const discountSymbol = document.getElementById('discount-symbol');
      
      if (discountTypeSelect) {
        discountTypeSelect.addEventListener('change', function() {
          if (this.value === 'special') {
            discountValueField.style.display = 'none';
          } else {
            discountValueField.style.display = 'block';
            discountSymbol.textContent = this.value === 'percentage' ? '%' : '$';
          }
        });
      }
    });
  </script>
<% end %>

