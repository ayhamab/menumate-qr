<% content_for :title, "New Promotion - #{@restaurant.name} - MenuMate QR" %>

<div class="promotion-form">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_promotions_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Create Promotion</h1>
        <p class="text-gray-600 mt-1">Add a new promotion for <%= @restaurant.name %></p>
      </div>
    </div>
  </div>

  <%= render 'form', promotion: @promotion, restaurant: @restaurant %>
</div>

