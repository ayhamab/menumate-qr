<% content_for :title, "Promotions - #{@restaurant.name} - MenuMate QR" %>

<div class="promotions-index">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div class="flex items-center gap-3">
        <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
        <% end %>
        <div>
          <h1 class="text-4xl font-extrabold text-gray-900">Promotions</h1>
          <p class="text-gray-600 mt-1"><%= @restaurant.name %></p>
        </div>
      </div>
      <%= link_to new_restaurant_promotion_path(@restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create Promotion</span>
      <% end %>
    </div>
  </div>

  <!-- Promotions List -->
  <% if @promotions.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @promotions.each do |promotion| %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden border-2 <%= promotion.current? ? 'border-green-400' : promotion.upcoming? ? 'border-blue-400' : 'border-gray-200' %>">
          <!-- Badge Header -->
          <div class="bg-gradient-to-r <%= promotion.badge_color == 'red' ? 'from-red-500 to-red-600' : promotion.badge_color == 'orange' ? 'from-orange-500 to-orange-600' : promotion.badge_color == 'yellow' ? 'from-yellow-500 to-yellow-600' : promotion.badge_color == 'green' ? 'from-green-500 to-green-600' : promotion.badge_color == 'blue' ? 'from-blue-500 to-blue-600' : promotion.badge_color == 'purple' ? 'from-purple-500 to-purple-600' : 'from-pink-500 to-pink-600' %> px-6 py-4">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-bold text-white"><%= promotion.title %></h3>
              <% if promotion.current? %>
                <span class="bg-white text-green-600 text-xs font-bold px-2 py-1 rounded-full">ACTIVE</span>
              <% elsif promotion.upcoming? %>
                <span class="bg-white text-blue-600 text-xs font-bold px-2 py-1 rounded-full">UPCOMING</span>
              <% else %>
                <span class="bg-white text-gray-600 text-xs font-bold px-2 py-1 rounded-full">EXPIRED</span>
              <% end %>
            </div>
            <div class="mt-2">
              <p class="text-white/90 text-sm font-semibold"><%= promotion.discount_display %></p>
            </div>
          </div>

          <div class="p-6">
            <% if promotion.description.present? %>
              <p class="text-gray-700 mb-4"><%= promotion.description %></p>
            <% end %>

            <div class="space-y-2 mb-4">
              <div class="flex items-center gap-2 text-sm text-gray-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span><%= promotion.start_date.strftime("%b %d, %Y") %> - <%= promotion.end_date.strftime("%b %d, %Y") %></span>
              </div>
              <div class="flex items-center gap-2 text-sm text-gray-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span><%= pluralize(promotion.menu_items.count, 'menu item') %></span>
              </div>
            </div>

            <div class="flex gap-2 pt-4 border-t border-gray-200">
              <%= link_to edit_restaurant_promotion_path(@restaurant, promotion), class: "flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                <span>Edit</span>
              <% end %>
              <%= link_to restaurant_promotion_path(@restaurant, promotion), 
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this promotion?" }, 
                          class: "flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                <span>Delete</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-xl p-12 text-center">
      <svg class="w-20 h-20 text-indigo-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Promotions Yet</h3>
      <p class="text-gray-600 mb-6">Create your first promotion to attract more customers</p>
      <%= link_to new_restaurant_promotion_path(@restaurant), class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create Your First Promotion</span>
      <% end %>
    </div>
  <% end %>
</div>

