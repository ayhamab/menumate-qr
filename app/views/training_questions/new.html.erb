<% content_for :title, "New Question - #{@training_module.title}" %>

<div class="training-question-form-page">
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">New Question</h1>
    <p class="text-gray-600 text-lg"><%= @training_module.title %></p>
  </div>

  <%= form_with model: [@restaurant, @training_module, @training_question], local: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
    <% if @training_question.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-6 mb-8 rounded-lg">
        <h3 class="text-lg font-semibold mb-2">Errors:</h3>
        <ul class="list-disc pl-5">
          <% @training_question.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div>
        <%= form.label :question_text, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Question <span class="text-red-500">*</span>
        <% end %>
        <%= form.text_area :question_text, required: true, rows: 3, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Enter your question here..." %>
      </div>

      <div>
        <%= form.label :question_type, "Question Type", class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Question Type <span class="text-red-500">*</span>
        <% end %>
        <%= form.select :question_type,
                         [
                           ['Multiple Choice', 'multiple_choice'],
                           ['True/False', 'true_false'],
                           ['Multiple Select', 'multiple_select']
                         ],
                         { selected: @training_question.question_type || 'multiple_choice' },
                         { required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", 
                            data: { controller: "question-type-selector" } } %>
      </div>

      <div id="options-section">
        <div class="mb-4">
          <%= form.label :options, "Answer Options", class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Answer Options <span class="text-red-500">*</span>
          <% end %>
          <p class="text-xs text-gray-500 mb-3">Enter each option on a new line</p>
          <%= form.text_area :options_text, rows: 6, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono text-sm", 
                            placeholder: "Option 1\nOption 2\nOption 3\nOption 4" %>
        </div>

        <div>
          <%= form.label :correct_option, "Correct Answer", class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Correct Answer <span class="text-red-500">*</span>
          <% end %>
          <p class="text-xs text-gray-500 mb-2">For multiple choice/true-false: Enter the option number (0, 1, 2, etc.)</p>
          <p class="text-xs text-gray-500 mb-3">For multiple select: Enter option numbers separated by commas (e.g., 0,2,3)</p>
          <%= form.text_field :correct_option_text, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", 
                            placeholder: "0" %>
        </div>
      </div>

      <div>
        <%= form.label :explanation, "Explanation", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :explanation, rows: 3, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", 
                          placeholder: "Explain why this is the correct answer (shown after quiz completion)..." %>
      </div>

      <div>
        <%= form.label :hint, "Hint", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :hint, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", 
                          placeholder: "Optional hint to help staff (shown during quiz)..." %>
      </div>

      <div>
        <%= form.label :position, "Position", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.number_field :position, value: @training_question.position || 0, min: 0, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">Order in which this question appears (0 = first)</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-200 mt-8">
        <% begin %>
          <%= link_to "Cancel", restaurant_training_module_path(@restaurant, @training_module), class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/training_modules/#{@training_module.id}", class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% end %>
        <%= form.submit "Create Question", class: "w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

<script>
// Convert options text to array and correct option text to proper format
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function(e) {
      const optionsText = document.getElementById('training_question_options_text');
      const correctOptionText = document.getElementById('training_question_correct_option_text');
      
      if (optionsText && correctOptionText) {
        // Convert options text to array
        const options = optionsText.value.split('\n').filter(opt => opt.trim().length > 0);
        
        // Create hidden fields for options array
        options.forEach((option, index) => {
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'training_question[options][]';
          hidden.value = option.trim();
          form.appendChild(hidden);
        });
        
        // Handle correct option
        const correctValue = correctOptionText.value.trim();
        if (correctValue.includes(',')) {
          // Multiple select - array
          const indices = correctValue.split(',').map(v => v.trim()).filter(v => v.length > 0);
          indices.forEach(index => {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'training_question[correct_option][]';
            hidden.value = index;
            form.appendChild(hidden);
          });
        } else {
          // Single select - number
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'training_question[correct_option]';
          hidden.value = correctValue;
          form.appendChild(hidden);
        }
      }
    });
  }
});
</script>

