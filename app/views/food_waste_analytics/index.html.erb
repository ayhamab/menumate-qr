<% content_for :title, "Food Waste Analytics - #{@restaurant.name}" %>

<div class="food-waste-analytics-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Food Waste Analytics</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <div class="flex gap-3">
        <% begin %>
          <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Back</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Period Selector -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <%= form_with url: restaurant_food_waste_analytics_index_path(@restaurant), method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div>
        <%= f.label :period_days, "Analysis Period", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.select :period_days,
                     [['Last 7 days', 7], ['Last 14 days', 14], ['Last 30 days', 30], ['Last 60 days', 60], ['Last 90 days', 90]],
                     { selected: @period_days },
                     { class: "px-4 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>
      <%= f.submit "Update", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl transition-all duration-200" %>
    <% end %>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-600">Total Menu Items</span>
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
      <p class="text-3xl font-extrabold text-gray-900"><%= @summary[:total_menu_items] %></p>
    </div>
    
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-600">Active Items</span>
        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-3xl font-extrabold text-green-600"><%= @summary[:active_items] %></p>
      <p class="text-xs text-gray-500 mt-1">Viewed in last <%= @period_days %> days</p>
    </div>
    
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-600">Inactive Items</span>
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-3xl font-extrabold text-red-600"><%= @summary[:inactive_items] %></p>
      <p class="text-xs text-gray-500 mt-1"><%= @summary[:inactive_percentage] %>% of total</p>
    </div>
    
    <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-600">Waste Risk Items</span>
        <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
      <p class="text-3xl font-extrabold text-orange-600"><%= @summary[:waste_risk_count] %></p>
      <p class="text-xs text-gray-500 mt-1">Items needing attention</p>
    </div>
  </div>

  <!-- Waste Risk Items -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">High Waste Risk Items</h2>
    <% if @waste_risk_items.any? %>
      <div class="space-y-4">
        <% @waste_risk_items.each do |item_data| %>
          <% item = item_data[:menu_item] %>
          <% risk_level = item_data[:risk_level] %>
          <% reasons = item_data[:reasons] %>
          <% recommendations = item_data[:recommendations] %>
          
          <div class="bg-<%= risk_level == 'high' ? 'red' : risk_level == 'medium' ? 'orange' : 'yellow' %>-50 border-2 border-<%= risk_level == 'high' ? 'red' : risk_level == 'medium' ? 'orange' : 'yellow' %>-200 rounded-xl p-6">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="text-xl font-bold text-gray-900"><%= item.name %></h3>
                  <span class="bg-<%= risk_level == 'high' ? 'red' : risk_level == 'medium' ? 'orange' : 'yellow' %>-600 text-white text-xs font-bold px-3 py-1 rounded-full capitalize">
                    <%= risk_level %> Risk
                  </span>
                </div>
                <p class="text-sm text-gray-600 mb-3">Category: <%= item.category || 'Uncategorized' %></p>
                
                <!-- Reasons -->
                <div class="mb-4">
                  <p class="text-sm font-semibold text-gray-700 mb-2">Risk Factors:</p>
                  <ul class="list-disc list-inside text-sm text-gray-600 space-y-1">
                    <% reasons.each do |reason| %>
                      <li><%= reason %></li>
                    <% end %>
                  </ul>
                </div>
                
                <!-- Recommendations -->
                <div class="bg-white rounded-lg p-4 border border-gray-200">
                  <p class="text-sm font-semibold text-indigo-700 mb-2">Recommendations:</p>
                  <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
                    <% recommendations.each do |rec| %>
                      <li><%= rec %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
              <div class="flex gap-2 ml-4">
                <% begin %>
                  <%= link_to restaurant_food_waste_analytics_path(@restaurant, item), class: "text-indigo-600 hover:text-indigo-800" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  <% end %>
                <% rescue %>
                  <%= link_to "/restaurants/#{@restaurant.id}/food_waste_analytics/#{item.id}", class: "text-indigo-600 hover:text-indigo-800" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-green-50 border border-green-200 rounded-xl p-12 text-center">
        <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-xl font-bold text-gray-900 mb-2">No High-Risk Items</h3>
        <p class="text-gray-600">All menu items are performing well. Great job!</p>
      </div>
    <% end %>
  </div>

  <!-- Unpopular Items -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Unpopular Items</h2>
    <% if @unpopular_items.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Menu Item</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Views</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Clicks</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Orders</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Revenue</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Last Viewed</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Popularity Score</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @unpopular_items.each do |item_data| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm font-medium text-gray-900">
                  <%= item_data[:menu_item].name %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-700"><%= number_with_delimiter(item_data[:views]) %></td>
                <td class="px-4 py-3 text-sm text-gray-700"><%= number_with_delimiter(item_data[:clicks]) %></td>
                <td class="px-4 py-3 text-sm text-gray-700"><%= number_with_delimiter(item_data[:orders]) %></td>
                <td class="px-4 py-3 text-sm text-gray-700">$<%= number_with_precision(item_data[:revenue], precision: 2) %></td>
                <td class="px-4 py-3 text-sm text-gray-700">
                  <% if item_data[:last_viewed] %>
                    <%= item_data[:days_since_view] %> days ago
                  <% else %>
                    <span class="text-red-600 font-semibold">Never</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm">
                  <span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded-full">
                    <%= item_data[:popularity_score] %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="bg-gray-50 rounded-xl p-12 text-center border-2 border-dashed border-gray-200">
        <p class="text-gray-600">No unpopular items found. All items are performing well!</p>
      </div>
    <% end %>
  </div>

  <!-- Items with No Activity -->
  <% if @items_with_no_activity.any? %>
    <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Items with No Activity</h2>
      <p class="text-sm text-gray-600 mb-4">These items have had no views, clicks, or orders in the last <%= @period_days %> days.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @items_with_no_activity.each do |item| %>
          <div class="bg-red-50 border-2 border-red-200 rounded-xl p-4">
            <h3 class="font-bold text-gray-900 mb-1"><%= item.name %></h3>
            <p class="text-xs text-gray-600">Category: <%= item.category || 'Uncategorized' %></p>
            <p class="text-xs text-red-700 font-semibold mt-2">Consider removing or promoting</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Declining Items -->
  <% if @declining_items.any? %>
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Declining Popularity</h2>
      <p class="text-sm text-gray-600 mb-4">Items with decreasing engagement over the analysis period.</p>
      <div class="space-y-4">
        <% @declining_items.each do |item_data| %>
          <div class="bg-orange-50 border border-orange-200 rounded-xl p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-bold text-gray-900"><%= item_data[:menu_item].name %></h3>
              <span class="bg-orange-600 text-white text-xs font-bold px-3 py-1 rounded-full">
                <%= item_data[:decline_percentage] %>% decline
              </span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              <div>
                <p class="text-gray-600">First Half Score</p>
                <p class="font-bold text-gray-900"><%= item_data[:first_half_score] %></p>
              </div>
              <div>
                <p class="text-gray-600">Second Half Score</p>
                <p class="font-bold text-gray-900"><%= item_data[:second_half_score] %></p>
              </div>
              <div>
                <p class="text-gray-600">Recent Views</p>
                <p class="font-bold text-gray-900"><%= item_data[:current_stats][:total_views] %></p>
              </div>
              <div>
                <p class="text-gray-600">Recent Orders</p>
                <p class="font-bold text-gray-900"><%= item_data[:current_stats][:total_orders] %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

