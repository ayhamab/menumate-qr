<div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Add Menu Items</h1>
    <p class="text-gray-600">Add your menu items now, or skip and add them later</p>
  </div>

  <!-- Quick Add Sample Items -->
  <div class="mb-8 bg-indigo-50 border-2 border-indigo-200 rounded-xl p-6">
    <h3 class="text-lg font-semibold text-indigo-900 mb-4">Quick Start - Add Sample Items</h3>
    <p class="text-sm text-indigo-700 mb-4">Click to quickly add sample menu items, or add your own below</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <% sample_items.each do |item| %>
        <%= button_to restaurant_menu_items_path(restaurant),
                    params: {
                      menu_item: {
                        name: item[:name],
                        description: item[:description],
                        price: item[:price],
                        category: item[:category]
                      }
                    },
                    method: :post,
                    class: "bg-white hover:bg-indigo-100 border-2 border-indigo-300 rounded-lg p-4 text-left transition-all duration-200",
                    data: { turbo_frame: "_top" } do %>
          <p class="font-bold text-gray-900 mb-1"><%= item[:name] %></p>
          <p class="text-sm text-gray-600 mb-2"><%= item[:description] %></p>
          <p class="text-lg font-bold text-indigo-600">$<%= number_with_precision(item[:price], precision: 2) %></p>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Current Menu Items -->
  <% if menu_items.any? %>
    <div class="mb-8">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Your Menu Items (<%= menu_items.count %>)</h3>
      <div class="space-y-3">
        <% menu_items.each do |item| %>
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-bold text-gray-900"><%= item.name %></p>
                <p class="text-sm text-gray-600"><%= item.description %></p>
              </div>
              <div class="text-right">
                <p class="font-bold text-indigo-600">$<%= number_with_precision(item.price, precision: 2) %></p>
                <p class="text-xs text-gray-500"><%= item.category %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Actions -->
  <div class="flex items-center justify-between pt-6 border-t border-gray-200">
    <%= link_to onboarding_step_path(step: step - 1), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-xl transition-all duration-200" do %>
      ← Back
    <% end %>
    <div class="flex gap-3">
      <%= link_to new_restaurant_menu_item_path(restaurant), 
                  class: "bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2",
                  data: { turbo_frame: "_top" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add Custom Item</span>
      <% end %>
      <%= form_with url: update_onboarding_step_path(step: step), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :skip_menu, 'true' %>
        <%= f.submit "Skip for Now", class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-xl transition-all duration-200" %>
      <% end %>
      <%= link_to onboarding_step_path(step: step + 1), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        Continue →
      <% end %>
    </div>
  </div>
</div>

