<div class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 rounded-2xl shadow-xl p-8 md:p-12 border-2 border-indigo-200">
  <div class="text-center mb-8">
    <div class="bg-green-500 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Congratulations!</h1>
    <p class="text-xl text-gray-600">Your restaurant is ready to go live</p>
  </div>

  <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">What's Next?</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex items-start gap-4 p-4 bg-indigo-50 rounded-lg">
        <div class="bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold flex-shrink-0">1</div>
        <div>
          <h3 class="font-bold text-gray-900 mb-1">Add More Menu Items</h3>
          <p class="text-sm text-gray-600">Build out your complete menu with all your dishes</p>
        </div>
      </div>
      <div class="flex items-start gap-4 p-4 bg-purple-50 rounded-lg">
        <div class="bg-purple-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold flex-shrink-0">2</div>
        <div>
          <h3 class="font-bold text-gray-900 mb-1">Print Your QR Code</h3>
          <p class="text-sm text-gray-600">Download and display QR codes for customers</p>
        </div>
      </div>
      <div class="flex items-start gap-4 p-4 bg-pink-50 rounded-lg">
        <div class="bg-pink-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold flex-shrink-0">3</div>
        <div>
          <h3 class="font-bold text-gray-900 mb-1">Customize Your Menu</h3>
          <p class="text-sm text-gray-600">Add images, dietary tags, and descriptions</p>
        </div>
      </div>
      <div class="flex items-start gap-4 p-4 bg-green-50 rounded-lg">
        <div class="bg-green-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold flex-shrink-0">4</div>
        <div>
          <h3 class="font-bold text-gray-900 mb-1">Share with Customers</h3>
          <p class="text-sm text-gray-600">Start sharing your digital menu today!</p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Quick Stats</h2>
    <div class="grid grid-cols-3 gap-4 text-center">
      <div>
        <p class="text-3xl font-bold text-indigo-600"><%= restaurant.menu_items.count %></p>
        <p class="text-sm text-gray-600">Menu Items</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-purple-600">0</p>
        <p class="text-sm text-gray-600">QR Scans</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-pink-600"><%= restaurant.subscription ? 'Active' : 'Free' %></p>
        <p class="text-sm text-gray-600">Subscription</p>
      </div>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-4 justify-center">
    <%= link_to restaurant_path(restaurant), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-4 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 text-center" do %>
      View Restaurant Dashboard
    <% end %>
    <%= link_to onboarding_complete_path(restaurant_id: restaurant.id), class: "bg-white hover:bg-gray-50 text-indigo-600 border-2 border-indigo-600 font-semibold py-4 px-8 rounded-xl transition-all duration-200 text-center" do %>
      Complete Setup
    <% end %>
  </div>
</div>

