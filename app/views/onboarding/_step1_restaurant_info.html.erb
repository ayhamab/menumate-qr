<div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Restaurant Information</h1>
    <p class="text-gray-600">Let's start by setting up your restaurant profile</p>
  </div>

  <%= form_with model: restaurant, url: update_onboarding_step_path(step: step), method: :patch, local: true, class: "space-y-6" do |f| %>
    <% if restaurant.errors.any? %>
      <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6">
        <h3 class="text-red-800 font-bold mb-2">
          <%= pluralize(restaurant.errors.count, "error") %> found:
        </h3>
        <ul class="list-disc list-inside text-red-700">
          <% restaurant.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Restaurant Name <span class="text-red-500">*</span>
      <% end %>
      <%= f.text_field :name, 
                      required: true,
                      class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                      placeholder: "e.g., The Gourmet Kitchen" %>
      <p class="text-xs text-gray-500 mt-1">This is how customers will see your restaurant</p>
    </div>

    <div>
      <%= f.label :address, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Address <span class="text-red-500">*</span>
      <% end %>
      <%= f.text_field :address, 
                      required: true,
                      class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                      placeholder: "123 Main St, City, State 12345" %>
      <p class="text-xs text-gray-500 mt-1">Full address helps customers find you</p>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
        Description
      <% end %>
      <%= f.text_area :description, 
                     rows: 4,
                     class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 resize-none",
                     placeholder: "Describe your restaurant, cuisine type, specialties..." %>
      <p class="text-xs text-gray-500 mt-1">Optional: Help customers understand what makes your restaurant special</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :cuisine, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Cuisine Type
        <% end %>
        <%= f.select :cuisine,
                    options_for_select([
                      ['Italian', 'Italian'],
                      ['Mexican', 'Mexican'],
                      ['Asian', 'Asian'],
                      ['American', 'American'],
                      ['Mediterranean', 'Mediterranean'],
                      ['Indian', 'Indian'],
                      ['French', 'French'],
                      ['Japanese', 'Japanese'],
                      ['Thai', 'Thai'],
                      ['Other', 'Other']
                    ], restaurant.cuisine),
                    { include_blank: 'Select cuisine type' },
                    { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" } %>
      </div>

      <div>
        <%= f.label :phone_number, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Phone Number
        <% end %>
        <%= f.text_field :phone_number, 
                        class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                        placeholder: "(555) 123-4567" %>
      </div>
    </div>

    <div class="flex items-center justify-between pt-6 border-t border-gray-200">
      <div></div>
      <%= f.submit "Continue", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
    </div>
  <% end %>
</div>

