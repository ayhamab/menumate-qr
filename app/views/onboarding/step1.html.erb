<% content_for :title, "Step 1: Restaurant Info - MenuMate QR" %>

<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 py-12 px-4">
  <div class="max-w-2xl mx-auto">
    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-700">Step 1 of 4</span>
        <span class="text-sm text-gray-500">25% Complete</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 h-2 rounded-full" style="width: 25%"></div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 md:p-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Tell us about your restaurant</h1>
      <p class="text-gray-600 mb-8">We'll use this to create your menu page</p>

      <%= form_with model: @restaurant, url: onboarding_create_step1_path, local: true, class: "space-y-6" do |f| %>
        <% if @restaurant.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <ul class="text-sm text-red-700 space-y-1">
              <% @restaurant.errors.full_messages.each do |message| %>
                <li>• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Restaurant Name -->
        <div>
          <%= f.label :name, "Restaurant Name *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :name, 
              placeholder: "e.g., Joe's Pizza",
              class: "w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-lg",
              required: true,
              autofocus: true %>
        </div>

        <!-- Description -->
        <div>
          <%= f.label :description, "Brief Description", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_area :description, 
              rows: 3,
              placeholder: "Tell customers what makes your restaurant special...",
              class: "w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <p class="text-xs text-gray-500 mt-1">Optional - You can add this later</p>
        </div>

        <!-- Address -->
        <div>
          <%= f.label :address, "Address *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :address, 
              placeholder: "123 Main St, City, State 12345",
              class: "w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
              required: true %>
        </div>

        <!-- Phone -->
        <div>
          <%= f.label :phone_number, "Phone Number", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.telephone_field :phone_number, 
              placeholder: "(555) 123-4567",
              class: "w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <p class="text-xs text-gray-500 mt-1">Optional - For customer contact</p>
        </div>

        <!-- Cuisine Type -->
        <div>
          <%= f.label :cuisine, "Cuisine Type", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :cuisine, 
              placeholder: "e.g., Italian, Mexican, American",
              class: "w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Navigation -->
        <div class="flex gap-4 pt-6">
          <% begin %>
            <%= link_to root_path, class: "flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl transition-all duration-200 text-center" do %>
              ← Back
            <% end %>
          <% rescue %>
            <%= link_to "/", class: "flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl transition-all duration-200 text-center" do %>
              ← Back
            <% end %>
          <% end %>
          <%= f.submit "Continue →", class: "flex-1 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

