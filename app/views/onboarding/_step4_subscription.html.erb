<div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100">
  <div class="mb-8 text-center">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Choose Your Plan</h1>
    <p class="text-gray-600">Select a subscription plan to unlock features (you can skip and choose later)</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <% subscription_plans.each do |plan_key, plan| %>
      <div class="bg-white rounded-xl shadow-lg p-6 border-2 <%= plan_key == 'pro' ? 'border-indigo-400 ring-4 ring-indigo-100' : 'border-gray-200' %> hover:border-indigo-300 transition-all duration-200">
        <div class="text-center mb-6">
          <h3 class="text-2xl font-bold text-gray-900 mb-2"><%= plan[:name] %></h3>
          <div class="mb-4">
            <span class="text-4xl font-extrabold text-indigo-600">$<%= number_with_precision(plan[:price], precision: 2) %></span>
            <span class="text-gray-600">/month</span>
          </div>
          <% if plan_key == 'pro' %>
            <span class="bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full">POPULAR</span>
          <% end %>
        </div>
        <ul class="space-y-3 mb-6">
          <% plan[:features].first(5).each do |feature| %>
            <li class="flex items-start gap-2 text-sm text-gray-700">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= feature %></span>
            </li>
          <% end %>
        </ul>
        <%= form_with url: restaurant_subscription_checkout_path(restaurant), method: :post, local: true do |f| %>
          <%= hidden_field_tag :plan_name, plan_key %>
          <%= f.submit "Choose Plan", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-50 border-2 border-gray-200 rounded-xl p-6 text-center">
    <p class="text-gray-700 mb-4">Not ready to subscribe? You can start with a free trial and choose a plan later.</p>
    <%= form_with url: update_onboarding_step_path(step: step), method: :patch, local: true do |f| %>
      <%= hidden_field_tag :skip_subscription, 'true' %>
      <%= f.submit "Skip for Now", class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" %>
    <% end %>
  </div>

  <div class="flex items-center justify-between pt-6 border-t border-gray-200 mt-8">
    <%= link_to onboarding_step_path(step: step - 1), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-xl transition-all duration-200" do %>
      ← Back
    <% end %>
    <%= link_to onboarding_step_path(step: step + 1), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
      Continue →
    <% end %>
  </div>
</div>

