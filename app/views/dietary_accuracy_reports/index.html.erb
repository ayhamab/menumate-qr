<% content_for :title, "Dietary Reports - #{@menu_item.name} - #{@restaurant.name}" %>

<div class="dietary-reports-index">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to restaurant_path(@restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Dietary Accuracy Reports</h1>
        <p class="text-gray-600 mt-1"><%= @menu_item.name %> - <%= @restaurant.name %></p>
      </div>
    </div>
  </div>

  <!-- Summary -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-6 border-2 border-gray-200">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-red-50 rounded-lg p-4 border border-red-200">
        <p class="text-sm font-semibold text-red-600 uppercase tracking-wide mb-1">Unresolved</p>
        <p class="text-3xl font-bold text-red-700"><%= @unresolved_count %></p>
      </div>
      <div class="bg-green-50 rounded-lg p-4 border border-green-200">
        <p class="text-sm font-semibold text-green-600 uppercase tracking-wide mb-1">Resolved</p>
        <p class="text-3xl font-bold text-green-700"><%= @reports.resolved.count %></p>
      </div>
      <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
        <p class="text-sm font-semibold text-blue-600 uppercase tracking-wide mb-1">Total Reports</p>
        <p class="text-3xl font-bold text-blue-700"><%= @reports.count %></p>
      </div>
    </div>
  </div>

  <!-- Reports List -->
  <% if @reports.any? %>
    <div class="space-y-4">
      <% @reports.each do |report| %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden border-2 <%= report.resolved? ? 'border-green-300' : 'border-red-300' %>">
          <div class="bg-gradient-to-r <%= report.resolved? ? 'from-green-500 to-green-600' : 'from-red-500 to-red-600' %> px-6 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <div>
                  <h3 class="text-lg font-bold text-white"><%= report.issue_type_display %></h3>
                  <p class="text-white/80 text-sm"><%= report.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
              </div>
              <% if report.resolved? %>
                <span class="bg-white text-green-600 text-xs font-bold px-3 py-1 rounded-full">RESOLVED</span>
              <% else %>
                <span class="bg-white text-red-600 text-xs font-bold px-3 py-1 rounded-full">UNRESOLVED</span>
              <% end %>
            </div>
          </div>

          <div class="p-6">
            <div class="mb-4">
              <p class="text-gray-700 leading-relaxed"><%= report.description %></p>
            </div>

            <% if report.reported_by.present? %>
              <div class="mb-4 p-3 bg-gray-50 rounded-lg">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Reported By</p>
                <p class="text-sm text-gray-900"><%= report.reported_by %></p>
              </div>
            <% end %>

            <% if report.resolution_notes.present? %>
              <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
                <p class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-2">Resolution Notes</p>
                <p class="text-sm text-green-900"><%= report.resolution_notes %></p>
              </div>
            <% end %>

            <% unless report.resolved? %>
              <div class="pt-4 border-t border-gray-200">
                <%= form_with model: [@restaurant, @menu_item, report], url: resolve_restaurant_menu_item_dietary_accuracy_report_path(@restaurant, @menu_item, report), method: :patch, local: true, class: "space-y-3" do |f| %>
                  <div>
                    <%= f.label :resolution_notes, "Resolution Notes", class: "block text-sm font-semibold text-gray-700 mb-1" %>
                    <%= f.text_area :resolution_notes, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-sm resize-none", placeholder: "Describe how you resolved this issue..." %>
                  </div>
                  <%= f.hidden_field :resolved, value: true %>
                  <%= f.submit "Mark as Resolved", class: "bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-xl p-12 text-center">
      <svg class="w-20 h-20 text-indigo-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Reports Yet</h3>
      <p class="text-gray-600">No dietary accuracy reports have been submitted for this menu item.</p>
    </div>
  <% end %>
</div>
