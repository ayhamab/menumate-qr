<div id="dietary-report-section-<%= menu_item.id %>" class="mt-4">
  <div class="bg-red-50 border-2 border-red-200 rounded-lg p-4">
    <div class="flex items-center gap-2 mb-3">
      <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <h4 class="text-sm font-bold text-red-800">Report Dietary Inaccuracy</h4>
    </div>
    <p class="text-xs text-red-700 mb-3">Help us maintain accurate dietary information. Report any issues with allergens or dietary tags.</p>
    
    <%= form_with model: [restaurant, menu_item, DietaryAccuracyReport.new], local: false, data: { turbo: true }, class: "space-y-3" do |f| %>
      <div id="dietary-report-errors-<%= menu_item.id %>"></div>
      
      <div>
        <%= f.label :issue_type, "Issue Type", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= f.select :issue_type,
                    options_for_select(DietaryAccuracyReport.issue_types.map { |k, v| [v, k] }),
                    { prompt: "Select issue type" },
                    { required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" } %>
      </div>

      <div>
        <%= f.label :description, "Description", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= f.text_area :description,
                       rows: 3,
                       required: true,
                       placeholder: "Please describe the issue in detail...",
                       class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm resize-none" %>
        <p class="text-xs text-gray-500 mt-1">Minimum 10 characters</p>
      </div>

      <div>
        <%= f.label :reported_by, "Your Name (Optional)", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= f.text_field :reported_by,
                        placeholder: "Optional: Your name or email",
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" %>
      </div>

      <div>
        <%= f.submit "Submit Report", class: "bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm w-full" %>
      </div>
    <% end %>
  </div>
</div>

