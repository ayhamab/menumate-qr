<% content_for :title, "Activity Log - #{@restaurant.name}" %>

<div class="activity-logs-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">Activity Log</h1>
        <p class="text-gray-600 text-lg"><%= @restaurant.name %></p>
      </div>
      <% begin %>
        <%= link_to restaurant_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back</span>
        <% end %>
      <% rescue %>
        <%= link_to "/restaurants/#{@restaurant.id}", class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
    <div class="flex flex-wrap gap-4">
      <%= form_with url: restaurant_activity_logs_path(@restaurant), method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
        <div>
          <%= f.label :type, "Activity Type", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.select :type,
                       [
                         ['All', ''],
                         ['Menu Item Created', 'menu_item_created'],
                         ['Menu Item Updated', 'menu_item_updated'],
                         ['Menu Item Deleted', 'menu_item_deleted'],
                         ['Team Member Added', 'team_member_added'],
                         ['Team Member Removed', 'team_member_removed'],
                         ['Assignment Created', 'assignment_created'],
                         ['Comment Added', 'comment_added']
                       ],
                       { selected: params[:type] },
                       { class: "px-4 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
        </div>
        <%= f.submit "Filter", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl transition-all duration-200" %>
        <% if params[:type].present? || params[:user_id].present? %>
          <%= link_to "Clear", restaurant_activity_logs_path(@restaurant), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-6 rounded-xl transition-all duration-200" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Activity Logs -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Recent Activity</h2>
    <% if @activity_logs.any? %>
      <div class="space-y-4">
        <% @activity_logs.each do |log| %>
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-md transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="bg-indigo-100 w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0">
                <% icon = case log.activity_type
                  when 'menu_item_created'
                    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>'
                  when 'menu_item_updated'
                    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>'
                  when 'menu_item_deleted'
                    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>'
                  when 'team_member_added', 'team_member_removed'
                    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>'
                  when 'assignment_created'
                    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>'
                  else
                    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>'
                end %>
                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <%= icon.html_safe %>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-gray-900 font-medium mb-1"><%= log.description %></p>
                <div class="flex items-center gap-4 text-xs text-gray-500">
                  <span><%= time_ago_in_words(log.created_at) %> ago</span>
                  <% if log.user.present? %>
                    <span>•</span>
                    <span><%= log.user.email %></span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-50 rounded-xl p-12 text-center border-2 border-dashed border-gray-200">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
        </svg>
        <h3 class="text-xl font-bold text-gray-900 mb-2">No Activity Yet</h3>
        <p class="text-gray-600">Activity will appear here as team members work on the menu</p>
      </div>
    <% end %>
  </div>
</div>

