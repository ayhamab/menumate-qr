<% content_for :title, "API Keys - MenuMate QR" %>

<div class="api-keys-page">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900 mb-2">API Keys</h1>
        <p class="text-gray-600">Manage your API keys for programmatic access to MenuMate QR</p>
      </div>
      <%= link_to api_documentation_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <span>View Documentation</span>
      <% end %>
    </div>
  </div>

  <!-- Create New API Key -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Create New API Key</h2>
    <%= form_with model: [current_user, ApiKey.new], url: api_keys_path, local: true, class: "space-y-6" do |f| %>
      <% if @api_key&.errors&.any? %>
        <div class="bg-red-50 border-2 border-red-300 rounded-xl p-4">
          <ul class="list-disc list-inside text-red-700">
            <% @api_key.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Key Name <span class="text-red-500">*</span>
          <% end %>
          <%= f.text_field :name, 
                          required: true,
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900",
                          placeholder: "e.g., Production API Key" %>
          <p class="text-xs text-gray-500 mt-1">A descriptive name to identify this key</p>
        </div>

        <div>
          <%= f.label :expires_at, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Expires At (optional)
          <% end %>
          <%= f.datetime_local_field :expires_at, 
                                    class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
          <p class="text-xs text-gray-500 mt-1">Leave blank for no expiration (default: 1 year)</p>
        </div>
      </div>

      <%= f.submit "Create API Key", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
    <% end %>
  </div>

  <!-- Existing API Keys -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Your API Keys</h2>
    
    <% if @api_keys.any? %>
      <div class="space-y-4">
        <% @api_keys.each do |api_key| %>
          <div class="bg-gray-50 rounded-xl p-6 border-2 <%= api_key.valid? ? 'border-gray-200' : 'border-red-300' %>">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-3">
                  <h3 class="text-lg font-bold text-gray-900"><%= api_key.name %></h3>
                  <% if api_key.valid? %>
                    <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full">Active</span>
                  <% else %>
                    <span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded-full">Inactive</span>
                  <% end %>
                </div>
                
                <div class="bg-white rounded-lg p-4 mb-4 border border-gray-200">
                  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">API Key</p>
                  <div class="flex items-center gap-2">
                    <code class="flex-1 text-sm font-mono text-gray-800 bg-gray-100 px-3 py-2 rounded break-all"><%= api_key.token %></code>
                    <button onclick="copyToClipboard('<%= api_key.token %>')" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded transition-all duration-200">
                      Copy
                    </button>
                  </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                  <div>
                    <p class="text-gray-500">Usage Count</p>
                    <p class="font-bold text-gray-900"><%= api_key.usage_count %></p>
                  </div>
                  <div>
                    <p class="text-gray-500">Last Used</p>
                    <p class="font-bold text-gray-900">
                      <%= api_key.last_used_at ? time_ago_in_words(api_key.last_used_at) + ' ago' : 'Never' %>
                    </p>
                  </div>
                  <div>
                    <p class="text-gray-500">Expires</p>
                    <p class="font-bold text-gray-900">
                      <%= api_key.expires_at ? api_key.expires_at.strftime('%Y-%m-%d') : 'Never' %>
                    </p>
                  </div>
                  <div>
                    <p class="text-gray-500">Created</p>
                    <p class="font-bold text-gray-900"><%= api_key.created_at.strftime('%Y-%m-%d') %></p>
                  </div>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= button_to regenerate_api_key_path(api_key), method: :post, 
                            class: "bg-yellow-500 hover:bg-yellow-600 text-white text-xs font-semibold py-2 px-4 rounded-lg transition-all duration-200",
                            data: { turbo_confirm: "Are you sure? This will invalidate the current key and generate a new one." } do %>
                  Regenerate
                <% end %>
                <%= button_to api_key_path(api_key), method: :delete,
                            class: "bg-red-500 hover:bg-red-600 text-white text-xs font-semibold py-2 px-4 rounded-lg transition-all duration-200",
                            data: { turbo_confirm: "Are you sure you want to delete this API key?" } do %>
                  Delete
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
        <p class="text-gray-600 mb-4">You don't have any API keys yet.</p>
        <p class="text-sm text-gray-500">Create your first API key above to get started.</p>
      </div>
    <% end %>
  </div>
</div>

<script>
  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function() {
      alert('API key copied to clipboard!');
    }, function(err) {
      console.error('Failed to copy: ', err);
    });
  }
</script>
