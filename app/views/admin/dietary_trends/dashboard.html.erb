<% content_for :title, "Dietary Trends Dashboard - Admin" %>

<div class="admin-dietary-trends-dashboard">
  <div class="mb-8">
    <h1 class="text-4xl font-extrabold text-gray-900">Dietary Trends Dashboard</h1>
    <p class="text-gray-600 mt-1">Analytics and insights from menu data</p>
  </div>

  <!-- Statistics -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-indigo-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Total Menu Items</p>
      <p class="text-3xl font-bold text-indigo-600"><%= number_with_delimiter(@total_menu_items) %></p>
    </div>
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-purple-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Total Restaurants</p>
      <p class="text-3xl font-bold text-purple-600"><%= number_with_delimiter(@total_restaurants) %></p>
    </div>
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-green-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Unique Dietary Tags</p>
      <p class="text-3xl font-bold text-green-600"><%= @unique_dietary_tags %></p>
    </div>
    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-pink-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Trend Records</p>
      <p class="text-3xl font-bold text-pink-600"><%= number_with_delimiter(DietaryTrend.count) %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Top Trends -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Top Dietary Trends</h2>
      <% if @top_trends.any? %>
        <div class="space-y-4">
          <% @top_trends.each_with_index do |trend, index| %>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
              <div class="flex items-center gap-3">
                <span class="bg-indigo-600 text-white font-bold w-8 h-8 rounded-full flex items-center justify-center"><%= index + 1 %></span>
                <div>
                  <p class="font-bold text-gray-900"><%= trend.dietary_tag.humanize %></p>
                  <p class="text-sm text-gray-600">Sample: <%= number_with_delimiter(trend.sample_size) %> items</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-2xl font-bold text-indigo-600"><%= number_with_precision(trend.trend_percentage, precision: 1) %>%</p>
                <% if trend.growth_rate && trend.growth_rate > 0 %>
                  <p class="text-xs text-green-600 font-semibold">+<%= number_with_precision(trend.growth_rate, precision: 1) %>% growth</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">No trend data available. Generate a report to see trends.</p>
      <% end %>
    </div>

    <!-- Growth Leaders -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Fastest Growing Trends</h2>
      <% if @growth_leaders.any? %>
        <div class="space-y-4">
          <% @growth_leaders.each_with_index do |trend, index| %>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
              <div class="flex items-center gap-3">
                <span class="bg-green-600 text-white font-bold w-8 h-8 rounded-full flex items-center justify-center"><%= index + 1 %></span>
                <div>
                  <p class="font-bold text-gray-900"><%= trend.dietary_tag.humanize %></p>
                  <p class="text-sm text-gray-600"><%= number_with_precision(trend.trend_percentage, precision: 1) %>% of items</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-2xl font-bold text-green-600">+<%= number_with_precision(trend.growth_rate, precision: 1) %>%</p>
                <p class="text-xs text-gray-500">growth rate</p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">No growth data available.</p>
      <% end %>
    </div>
  </div>

  <!-- Generate Report -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Generate Trend Report</h2>
    <%= form_with url: generate_report_admin_dietary_trends_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :start_date, "Start Date", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.date_field :start_date, 
                          value: 30.days.ago.to_date,
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        </div>
        <div>
          <%= f.label :end_date, "End Date", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.date_field :end_date, 
                          value: Date.today,
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        </div>
        <div>
          <%= f.label :region, "Region (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :region, 
                          placeholder: "City, State, or Country",
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        </div>
      </div>
      <%= f.submit "Generate Report", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
    <% end %>
  </div>

  <!-- Recent Trends -->
  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Recent Trends</h2>
    <% if @recent_trends.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="text-left py-3 px-4 font-semibold text-gray-700">Dietary Tag</th>
              <th class="text-center py-3 px-4 font-semibold text-gray-700">Percentage</th>
              <th class="text-center py-3 px-4 font-semibold text-gray-700">Sample Size</th>
              <th class="text-center py-3 px-4 font-semibold text-gray-700">Growth Rate</th>
              <th class="text-center py-3 px-4 font-semibold text-gray-700">Region</th>
              <th class="text-center py-3 px-4 font-semibold text-gray-700">Date</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_trends.each do |trend| %>
              <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="py-3 px-4 font-semibold text-gray-900"><%= trend.dietary_tag.humanize %></td>
                <td class="py-3 px-4 text-center font-bold text-indigo-600"><%= number_with_precision(trend.trend_percentage, precision: 2) %>%</td>
                <td class="py-3 px-4 text-center text-gray-600"><%= number_with_delimiter(trend.sample_size) %></td>
                <td class="py-3 px-4 text-center">
                  <% if trend.growth_rate %>
                    <span class="font-semibold <%= trend.growth_rate > 0 ? 'text-green-600' : 'text-red-600' %>">
                      <%= trend.growth_rate > 0 ? '+' : '' %><%= number_with_precision(trend.growth_rate, precision: 2) %>%
                    </span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="py-3 px-4 text-center text-gray-600"><%= trend.region || 'Global' %></td>
                <td class="py-3 px-4 text-center text-gray-600"><%= trend.trend_date.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No trend data available. Generate a report to see trends.</p>
    <% end %>
  </div>
</div>
