<% content_for :title, "Dietary Trends - Admin" %>

<div class="admin-dietary-trends">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900">Dietary Trends</h1>
        <p class="text-gray-600 mt-1">View and manage dietary trend data</p>
      </div>
      <div class="flex gap-3">
        <%= link_to dashboard_admin_dietary_trends_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <span>Dashboard</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
    <%= form_with url: admin_dietary_trends_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do |f| %>
      <div>
        <%= f.label :dietary_tag, "Dietary Tag", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.text_field :dietary_tag, 
                        value: params[:dietary_tag],
                        placeholder: "e.g., vegan",
                        class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-gray-900" %>
      </div>
      <div>
        <%= f.label :region, "Region", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.text_field :region, 
                        value: params[:region],
                        placeholder: "City or State",
                        class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-gray-900" %>
      </div>
      <div>
        <%= f.label :start_date, "Start Date", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.date_field :start_date, 
                        value: params[:start_date],
                        class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-gray-900" %>
      </div>
      <div>
        <%= f.label :end_date, "End Date", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.date_field :end_date, 
                        value: params[:end_date],
                        class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-gray-900" %>
      </div>
      <div class="md:col-span-4 flex gap-3">
        <%= f.submit "Filter", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg transition-all duration-200" %>
        <%= link_to admin_dietary_trends_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-6 rounded-lg transition-all duration-200" do %>
          Clear
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Trends List -->
  <% if @dietary_trends.any? %>
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gradient-to-r from-indigo-600 to-purple-600">
            <tr>
              <th class="text-left py-4 px-6 font-bold text-white">Dietary Tag</th>
              <th class="text-center py-4 px-6 font-bold text-white">Trend %</th>
              <th class="text-center py-4 px-6 font-bold text-white">Sample Size</th>
              <th class="text-center py-4 px-6 font-bold text-white">Growth Rate</th>
              <th class="text-center py-4 px-6 font-bold text-white">Region</th>
              <th class="text-center py-4 px-6 font-bold text-white">Date</th>
              <th class="text-center py-4 px-6 font-bold text-white">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @dietary_trends.each do |trend| %>
              <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="py-4 px-6">
                  <span class="font-bold text-gray-900"><%= trend.dietary_tag.humanize %></span>
                </td>
                <td class="py-4 px-6 text-center">
                  <span class="text-2xl font-bold text-indigo-600"><%= number_with_precision(trend.trend_percentage, precision: 2) %>%</span>
                </td>
                <td class="py-4 px-6 text-center text-gray-600">
                  <%= number_with_delimiter(trend.sample_size) %>
                </td>
                <td class="py-4 px-6 text-center">
                  <% if trend.growth_rate %>
                    <span class="font-semibold <%= trend.growth_rate > 0 ? 'text-green-600' : trend.growth_rate < 0 ? 'text-red-600' : 'text-gray-600' %>">
                      <%= trend.growth_rate > 0 ? '+' : '' %><%= number_with_precision(trend.growth_rate, precision: 2) %>%
                    </span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="py-4 px-6 text-center text-gray-600">
                  <%= trend.region || 'Global' %>
                </td>
                <td class="py-4 px-6 text-center text-gray-600">
                  <%= trend.trend_date.strftime("%b %d, %Y") %>
                </td>
                <td class="py-4 px-6 text-center">
                  <%= link_to admin_dietary_trend_path(trend), class: "text-indigo-600 hover:text-indigo-800 font-semibold text-sm" do %>
                    View
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-xl p-12 text-center">
      <svg class="w-20 h-20 text-indigo-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No Trend Data</h3>
      <p class="text-gray-600 mb-6">Generate a trend report to see dietary pattern analytics</p>
      <%= link_to dashboard_admin_dietary_trends_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        <span>Go to Dashboard</span>
      <% end %>
    </div>
  <% end %>
</div>
