<%= form_with model: [:admin, brand_analytic], local: true, class: "space-y-6" do |f| %>
  <% if brand_analytic.errors.any? %>
    <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6">
      <h3 class="text-red-800 font-bold mb-2">
        <%= pluralize(brand_analytic.errors.count, "error") %> prohibited this account from being saved:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% brand_analytic.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Brand Information</h2>
    
    <div class="space-y-6">
      <div>
        <%= f.label :brand_name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Brand Name <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :brand_name, 
                        required: true,
                        class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Email <span class="text-red-500">*</span>
        <% end %>
        <%= f.email_field :email, 
                         required: true,
                         class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
      </div>

      <div>
        <%= f.label :subscription_tier, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Subscription Tier <span class="text-red-500">*</span>
        <% end %>
        <%= f.select :subscription_tier,
                    options_for_select(BrandAnalytic.subscription_tiers.map { |k, v| ["#{v[:name]} - $#{number_with_precision(v[:price], precision: 2)}/month", k] }, brand_analytic.subscription_tier || 'basic'),
                    {},
                    { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" } %>
      </div>

      <div>
        <%= f.label :monthly_fee, "Monthly Fee (Override)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.number_field :monthly_fee, 
                          step: 0.01,
                          min: 0,
                          class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900" %>
        <p class="text-xs text-gray-500 mt-1">Leave blank to use tier default price</p>
      </div>

      <div class="flex items-center gap-3">
        <%= f.check_box :active, class: "w-5 h-5 text-indigo-600 border-gray-300 rounded" %>
        <%= f.label :active, "Active", class: "text-sm font-semibold text-gray-700 cursor-pointer" %>
      </div>

      <div>
        <%= f.label :notes, "Admin Notes", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.text_area :notes, 
                       rows: 4,
                       class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-gray-900 resize-none" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-6 border-t border-gray-200">
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
    <%= link_to admin_brand_analytics_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-8 rounded-xl transition-all duration-200" do %>
      Cancel
    <% end %>
  </div>
<% end %>

