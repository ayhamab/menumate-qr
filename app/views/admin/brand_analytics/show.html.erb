<% content_for :title, "#{@brand_analytic.brand_name} - Brand Analytics" %>

<div class="admin-brand-analytic-show">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <%= link_to admin_brand_analytics_path, class: "text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900"><%= @brand_analytic.brand_name %></h1>
        <p class="text-gray-600 mt-1">Brand Analytics Account Details</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Info -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Account Details -->
      <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Account Information</h2>
        
        <div class="space-y-4">
          <div>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Brand Name</p>
            <p class="text-lg font-bold text-gray-900"><%= @brand_analytic.brand_name %></p>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p>
            <p class="text-lg text-gray-900"><%= @brand_analytic.email %></p>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Subscription Tier</p>
            <div class="flex items-center gap-3">
              <span class="bg-gradient-to-r <%= @brand_analytic.subscription_tier == 'basic' ? 'from-gray-500 to-gray-600' : @brand_analytic.subscription_tier == 'premium' ? 'from-indigo-500 to-purple-600' : 'from-purple-600 to-pink-600' %> text-white font-bold px-4 py-2 rounded-lg">
                <%= @brand_analytic.subscription_details[:name] %>
              </span>
              <span class="text-lg font-bold text-gray-900">$<%= number_with_precision(@brand_analytic.subscription_details[:price], precision: 2) %>/month</span>
            </div>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Status</p>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold <%= @brand_analytic.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
              <%= @brand_analytic.active? ? 'Active' : 'Inactive' %>
            </span>
          </div>

          <% if @brand_analytic.notes.present? %>
            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Notes</p>
              <p class="text-gray-700"><%= @brand_analytic.notes %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- API Information -->
      <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">API Access</h2>
        
        <div class="space-y-4">
          <div>
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">API Key</p>
            <div class="flex items-center gap-3">
              <code class="flex-1 bg-gray-100 px-4 py-3 rounded-lg font-mono text-sm text-gray-900 break-all"><%= @brand_analytic.api_key %></code>
              <%= button_to regenerate_api_key_admin_brand_analytic_path(@brand_analytic), 
                          method: :post,
                          data: { turbo_confirm: "Are you sure you want to regenerate the API key? The old key will no longer work." },
                          class: "bg-yellow-600 hover:bg-yellow-700 text-white font-semibold py-2 px-4 rounded-lg transition-all duration-200 text-sm" do %>
                Regenerate
              <% end %>
            </div>
            <p class="text-xs text-gray-500 mt-2">Keep this key secure. Use it in the X-API-Key header for API requests.</p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">API Calls (This Month)</p>
              <p class="text-2xl font-bold text-gray-900"><%= @brand_analytic.api_calls_count %></p>
              <p class="text-xs text-gray-500">
                Limit: <%= @brand_analytic.subscription_details[:limits][:api_calls_per_month] == Float::INFINITY ? 'Unlimited' : number_with_delimiter(@brand_analytic.subscription_details[:limits][:api_calls_per_month]) %>
              </p>
            </div>

            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Last Access</p>
              <p class="text-lg font-bold text-gray-900">
                <%= @brand_analytic.last_access_at ? time_ago_in_words(@brand_analytic.last_access_at) + ' ago' : 'Never' %>
              </p>
              <% if @brand_analytic.last_access_at %>
                <p class="text-xs text-gray-500"><%= @brand_analytic.last_access_at.strftime("%B %d, %Y at %I:%M %p") %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- API Documentation -->
      <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-6">
        <h3 class="text-lg font-bold text-blue-900 mb-3">API Endpoints</h3>
        <div class="space-y-2 text-sm">
          <div>
            <code class="bg-white px-2 py-1 rounded text-blue-900 font-mono">GET /api/v1/dietary_trends</code>
            <p class="text-blue-700 mt-1">Get dietary trend data</p>
          </div>
          <div>
            <code class="bg-white px-2 py-1 rounded text-blue-900 font-mono">GET /api/v1/dietary_trends/summary</code>
            <p class="text-blue-700 mt-1">Get trend summary</p>
          </div>
          <div>
            <code class="bg-white px-2 py-1 rounded text-blue-900 font-mono">GET /api/v1/dietary_trends/export?format=csv</code>
            <p class="text-blue-700 mt-1">Export data as CSV or JSON</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Actions -->
    <div class="space-y-6">
      <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Actions</h3>
        <div class="space-y-3">
          <%= link_to edit_admin_brand_analytic_path(@brand_analytic), class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Edit Account</span>
          <% end %>

          <%= button_to toggle_active_admin_brand_analytic_path(@brand_analytic),
                      method: :patch,
                      class: "w-full #{@brand_analytic.active? ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700'} text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
            </svg>
            <span><%= @brand_analytic.active? ? 'Deactivate' : 'Activate' %></span>
          <% end %>

          <%= link_to admin_brand_analytics_path, 
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this brand analytics account?" },
                      class: "w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            <span>Delete Account</span>
          <% end %>
        </div>
      </div>

      <!-- Subscription Features -->
      <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Subscription Features</h3>
        <ul class="space-y-2">
          <% @brand_analytic.subscription_details[:features].each do |feature| %>
            <li class="flex items-start gap-2 text-sm text-gray-700">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= feature %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
