              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700">Email Support</span>
              </li>
            </ul>
          </div>

          <!-- Pro Plan -->
          <div class="border-2 border-indigo-500 rounded-xl p-5 bg-gradient-to-br from-indigo-50 to-purple-50 relative hover:shadow-lg transition-all duration-200">
            <div class="absolute top-0 right-0 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-bl-xl rounded-tr-xl">
              POPULAR
            </div>
            <div class="text-center mb-4">
              <h4 class="text-lg font-bold text-gray-900 mb-1">Pro</h4>
              <div class="flex items-baseline justify-center gap-1">
                <span class="text-3xl font-extrabold text-indigo-600">60€</span>
