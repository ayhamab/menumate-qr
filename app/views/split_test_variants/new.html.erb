<% content_for :title, "New Variant - #{@split_test.name}" %>

<div class="variant-form-page">
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-2">New Variant</h1>
    <p class="text-gray-600 text-lg"><%= @split_test.name %></p>
  </div>

  <%= form_with model: [@restaurant, @split_test, @variant], local: true, multipart: true, class: "bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100" do |form| %>
    <% if @variant.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-6 mb-8 rounded-lg">
        <h3 class="text-lg font-semibold mb-2">Errors:</h3>
        <ul class="list-disc pl-5">
          <% @variant.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div>
        <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Variant Name <span class="text-red-500">*</span>
        <% end %>
        <%= form.text_field :name, required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "e.g., Variant A, Short Description, etc." %>
      </div>

      <% case @split_test.test_type %>
      <% when 'description' %>
        <div>
          <%= form.label :description, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Description <span class="text-red-500">*</span>
          <% end %>
          <%= form.text_area :description, required: true, rows: 6, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Enter the description variant to test..." %>
        </div>
      <% when 'price' %>
        <div>
          <%= form.label :price, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Price <span class="text-red-500">*</span>
          <% end %>
          <%= form.number_field :price, required: true, step: 0.01, min: 0, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "0.00" %>
        </div>
      <% when 'placement' %>
        <div>
          <%= form.label :position, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
            Position <span class="text-red-500">*</span>
          <% end %>
          <%= form.number_field :position, required: true, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "1" %>
        </div>
      <% when 'image' %>
        <div>
          <%= form.label :image, "Image", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.file_field :image, accept: "image/*", class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      <% end %>

      <div>
        <%= form.label :weight, "Traffic Weight", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.number_field :weight, value: @variant.weight || 50, min: 1, max: 100, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">Percentage of traffic this variant should receive (1-100). Total should add up to 100 across all variants.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= form.check_box :is_control %>
        <%= form.label :is_control, "This is the control variant", class: "text-sm font-semibold text-gray-700" %>
        <p class="text-xs text-gray-500">Control variants are used as baseline for comparison</p>
      </div>

      <div>
        <%= form.label :notes, "Notes", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_area :notes, rows: 3, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Add any notes about this variant..." %>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-200 mt-8">
        <% begin %>
          <%= link_to "Cancel", restaurant_split_test_path(@restaurant, @split_test), class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% rescue %>
          <%= link_to "/restaurants/#{@restaurant.id}/split_tests/#{@split_test.id}", class: "w-full sm:w-auto px-8 py-3 text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-xl font-semibold transition-all duration-200 text-center" %>
        <% end %>
        <%= form.submit "Create Variant", class: "w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

