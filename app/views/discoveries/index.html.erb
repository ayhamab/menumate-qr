<% content_for :title, "Discover Restaurants - MenuMate QR" %>

<div class="discover-page">
  <!-- Hero Search Section -->
  <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
          Discover Amazing Restaurants
        </h1>
        <p class="text-xl text-indigo-100 max-w-2xl mx-auto">
          Find restaurants by cuisine, dietary preferences, or search by name
        </p>
      </div>

      <!-- Search Form -->
      <%= form_with url: discover_path, method: :get, local: true, class: "max-w-4xl mx-auto" do |form| %>
        <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Search Query -->
            <div class="md:col-span-1">
              <%= form.text_field :query, 
                                  value: @query,
                                  placeholder: "Search by name...",
                                  class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200" %>
            </div>

            <!-- Cuisine Filter -->
            <div class="md:col-span-1">
              <%= form.select :cuisine,
                              options_for_select([['All Cuisines', '']] + @cuisines.map { |c| [c, c] }, @cuisine),
                              {},
                              { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200" } %>
            </div>

            <!-- Dietary Option Filter -->
            <div class="md:col-span-1">
              <%= form.select :dietary_option,
                              options_for_select([['All Dietary Options', '']] + @dietary_options.map { |d| [d.humanize, d] }, @dietary_option),
                              {},
                              { class: "w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200" } %>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6">
            <%= form.submit "Search", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 w-full sm:w-auto" %>
            <% if @query.present? || @cuisine.present? || @dietary_option.present? %>
              <%= link_to "Clear Filters", discover_path, class: "text-gray-600 hover:text-indigo-600 font-medium py-3 px-6 rounded-xl border-2 border-gray-300 hover:border-indigo-300 transition-all duration-200 w-full sm:w-auto text-center" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Results Header -->
      <div class="mb-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">
              <% if @query.present? || @cuisine.present? || @dietary_option.present? %>
                Search Results
              <% else %>
                All Restaurants
              <% end %>
            </h2>
            <p class="text-gray-600">
              <%= pluralize(@restaurants.count, 'restaurant') %> found
              <% if @query.present? %>
                <span class="text-indigo-600 font-semibold">for "<%= @query %>"</span>
              <% end %>
              <% if @cuisine.present? %>
                <span class="text-indigo-600 font-semibold">in <%= @cuisine %></span>
              <% end %>
              <% if @dietary_option.present? %>
                <span class="text-indigo-600 font-semibold">with <%= @dietary_option.humanize %> options</span>
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <!-- Restaurants Grid -->
      <% if @restaurants.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @restaurants.each do |restaurant| %>
            <div class="bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 transform hover:-translate-y-1">
              <div class="p-6">
                <!-- Restaurant Header -->
                <div class="mb-4">
                  <h3 class="text-2xl font-bold text-gray-900 mb-2">
                    <%= link_to restaurant.name, restaurant_path(restaurant), class: "text-indigo-600 hover:text-indigo-800 transition-colors" %>
                  </h3>
                  <% if restaurant.cuisine.present? %>
                    <span class="inline-block bg-indigo-100 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-full mb-2">
                      <%= restaurant.cuisine %>
                    </span>
                  <% end %>
                </div>

                <!-- Description -->
                <% if restaurant.description.present? %>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                    <%= restaurant.description %>
                  </p>
                <% end %>

                <!-- Restaurant Info -->
                <div class="space-y-2 mb-4">
                  <div class="flex items-start gap-2 text-sm text-gray-600">
                    <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="line-clamp-2"><%= restaurant.address %></span>
                  </div>
                  <% if restaurant.phone_number.present? %>
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                      </svg>
                      <a href="tel:<%= restaurant.phone_number.gsub(/\s/, '') %>" class="hover:text-indigo-600 transition-colors">
                        <%= restaurant.phone_number %>
                      </a>
                    </div>
                  <% end %>
                </div>

                <!-- Menu Items Count -->
                <div class="mb-4 pt-4 border-t border-gray-200">
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-600">
                      <%= pluralize(restaurant.menu_items.count, 'menu item') %>
                    </span>
                    <% if restaurant.menu_items.any? %>
                      <% 
                        dietary_tags = restaurant.menu_items.pluck(:dietary_tags)
                                                   .map { |tags| tags.is_a?(String) ? (JSON.parse(tags) rescue []) : (tags || []) }
                                                   .flatten
                                                   .compact
                                                   .uniq
                      %>
                      <% if dietary_tags.any? %>
                        <div class="flex flex-wrap gap-1">
                          <% dietary_tags.first(3).each do |tag| %>
                            <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded">
                              <%= tag.humanize %>
                            </span>
                          <% end %>
                          <% if dietary_tags.count > 3 %>
                            <span class="text-gray-500 text-xs">+<%= dietary_tags.count - 3 %></span>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-2">
                  <%= link_to restaurant_path(restaurant), class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 text-center text-sm" do %>
                    View Details
                  <% end %>
                  <%= link_to menu_restaurant_path(restaurant), class: "flex-1 bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 text-center text-sm" do %>
                    View Menu
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center">
          <svg class="w-20 h-20 text-indigo-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">No Restaurants Found</h3>
          <p class="text-gray-600 mb-6">
            <% if @query.present? || @cuisine.present? || @dietary_option.present? %>
              Try adjusting your search filters or <%= link_to "view all restaurants", discover_path, class: "text-indigo-600 hover:text-indigo-800 font-semibold" %>.
            <% else %>
              No restaurants are available yet. Check back soon!
            <% end %>
          </p>
          <% if @query.present? || @cuisine.present? || @dietary_option.present? %>
            <%= link_to "Clear Filters", discover_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span>Clear All Filters</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>

