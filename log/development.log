679:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
680:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
681:                    </svg>
682:                    <span>Manage Promotions</span>
683:                  <% end %>
684:                  <%= link_to restaurant_seasonal_menu_schedules_path(@restaurant), class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
685:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
686:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
687:                    </svg>
688:                    <span>Seasonal Menus</span>
689:                  <% end %>
690:                  <%= link_to restaurant_subscription_path(@restaurant), class: "w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
691:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
692:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
693:                    </svg>
694:                    <span>Subscription</span>
