368:            </div>
369:            <div class="p-8">
370:              <% if @restaurant.menu_items.any? %>
371:                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
372:                  <% @restaurant.menu_items.each do |item| %>
373:                    <div class="bg-white border-2 <%= item.has_allergens? ? 'border-red-300 hover:border-red-400' : 'border-gray-200 hover:border-indigo-300' %> rounded-xl overflow-hidden hover:shadow-lg transition-all duration-200 <%= 'ring-2 ring-indigo-100' if restaurant_owner?(@restaurant) %> relative">
374:                      <!-- Allergy Warning Badge -->
375:                      <% if item.has_allergens? %>
376:                        <div class="absolute top-2 right-2 bg-red-600 text-white px-2 py-1 rounded-full shadow-md flex items-center gap-1 z-10">
377:                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
378:                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
379:                          </svg>
380:                          <span class="text-xs font-bold">ALLERGENS</span>
381:                        </div>
382:                      <% end %>
383:                      
384:                      <!-- Image Section -->
385:                      <% if item.image.attached? %>
386:                        <div class="w-full h-48 overflow-hidden bg-gray-100">
387:                          <%= image_tag item.image, class: "w-full h-full object-cover hover:scale-110 transition-transform duration-300", alt: item.name %>
388:                        </div>
389:                      <% end %>
390:                      
391:                      <div class="p-6">
392:                        <div class="flex justify-between items-start mb-3">
393:                          <div class="flex-1 min-w-0">
394:                            <h3 class="font-bold text-gray-900 text-lg mb-2"><%= item.name %></h3>
395:                            <% if item.description.present? %>
396:                              <p class="text-sm text-gray-600 mb-3 leading-relaxed line-clamp-2"><%= item.description %></p>
397:                            <% end %>
398:                            <div class="mb-3">
399:                              <p class="text-2xl font-bold text-indigo-600">$<%= number_with_precision(item.price, precision: 2) %></p>
400:                            </div>
401:                            
402:                            <!-- Allergy Warning -->
403:                            <% if item.has_allergens? %>
404:                              <div class="mb-3 p-2 bg-red-50 border border-red-300 rounded-md">
405:                                <div class="flex items-center gap-1.5 mb-1">
406:                                  <svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
407:                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
408:                                  </svg>
409:                                  <span class="text-xs font-bold text-red-800">Contains:</span>
410:                                </div>
411:                                <div class="flex flex-wrap gap-1">
412:                                  <% item.allergens.each do |allergen| %>
413:                                    <span class="text-xs font-semibold text-red-700 bg-red-100 px-1.5 py-0.5 rounded">
414:                                      <%= MenuItem.common_allergens[allergen.to_s] || allergen.humanize %>
415:                                    </span>
416:                                  <% end %>
417:                                </div>
418:                              </div>
419:                            <% end %>
420:                            
421:                          <!-- Dietary Tags Display -->
422:                          <% if item.dietary_tags.present? && item.dietary_tags.any? %>
423:                            <div class="flex flex-wrap gap-1.5 mb-3">
424:                              <% item.dietary_tags.each do |tag| %>
425:                                <span class="bg-green-100 text-green-700 text-xs font-medium px-2.5 py-1 rounded-full">
