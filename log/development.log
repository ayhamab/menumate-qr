452:                                <%= link_to "/restaurants/#{@restaurant.id}/menu_items/#{item.id}/menu_item_assignments", class: "flex-1 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-1 text-xs shadow-sm hover:shadow-md" do %>
453:                                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
454:                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
455:                                  </svg>
456:                                  <span>Assign</span>
457:                                <% end %>
458:                                <%= link_to "/restaurants/#{@restaurant.id}/menu_items/#{item.id}/menu_item_comments", class: "flex-1 bg-green-50 hover:bg-green-100 text-green-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-1 text-xs shadow-sm hover:shadow-md" do %>
459:                                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
460:                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
461:                                  </svg>
462:                                  <span>Comments</span>
463:                                <% end %>
464:                              <% end %>
465:                            </div>
466:                          <% end %>
467:                        </div>
468:                        
469:                        <!-- Edit/Delete Options (Owners Only) -->
470:                        <% if restaurant_owner?(@restaurant) %>
471:                          <div class="flex items-center gap-2 pt-4 border-t border-gray-200">
472:                          <%= link_to edit_restaurant_menu_item_path(@restaurant, item), class: "flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
473:                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
474:                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
475:                            </svg>
476:                            <span>Edit</span>
477:                          <% end %>
478:                          <%= link_to restaurant_menu_item_path(@restaurant, item), 
479:                                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete '#{item.name}'? This action cannot be undone." }, 
480:                                      class: "flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
481:                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
482:                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
483:                            </svg>
484:                            <span>Delete</span>
485:                          <% end %>
486:                        </div>
487:                      <% end %>
488:                    </div>
489:                  <% end %>
490:                </div>
491:              <% else %>
492:                <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-12 border-2 border-dashed border-indigo-200 text-center">
