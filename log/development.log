620:                    <div class="flex gap-2">
621:                      <% begin %>
622:                        <%= link_to qr_code_png_restaurant_path(@restaurant), class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
623:                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
624:                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
625:                          </svg>
626:                          <span>PNG</span>
627:                        <% end %>
628:                      <% rescue NoMethodError, NameError %>
629:                        <%= link_to "/restaurants/#{@restaurant.id}/qr_code_png", class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
630:                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
631:                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
632:                          </svg>
633:                          <span>PNG</span>
634:                        <% end %>
635:                      <% end %>
636:                      <% begin %>
637:                        <%= link_to qr_code_svg_restaurant_path(@restaurant), class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
638:                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
639:                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
640:                          </svg>
641:                          <span>SVG</span>
642:                        <% end %>
643:                      <% rescue NoMethodError, NameError %>
644:                        <%= link_to "/restaurants/#{@restaurant.id}/qr_code_svg", class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
645:                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
646:                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
647:                          </svg>
648:                          <span>SVG</span>
649:                        <% end %>
650:                      <% end %>
651:                    </div>
652:                  </div>
653:                <% end %>
654:              </div>
655:            </div>
656:          </div>
657:    
658:          <!-- Quick Actions Card -->
659:          <% if restaurant_owner?(@restaurant) %>
660:            <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
661:              <div class="bg-gradient-to-r from-indigo-50 to-purple-50 px-6 py-4 border-b border-gray-200">
662:                <h3 class="text-lg font-bold text-gray-900">Quick Actions</h3>
663:              </div>
664:              <div class="p-6 space-y-3">
665:                <% begin %>
666:                  <%= link_to restaurant_dashboard_path(@restaurant), class: "w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
667:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
668:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
669:                    </svg>
670:                    <span>View Dashboard</span>
671:                  <% end %>
