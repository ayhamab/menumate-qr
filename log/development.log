580:                    rescue NoMethodError, NameError
581:                      menu_url = restaurant_url(@restaurant, host: request.host_with_port, protocol: request.protocol)
582:                    end
583:                  %>
584:                  <%= qr_code_svg(menu_url, size: 200) %>
585:                </div>
