632:                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
633:                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
634:                          </svg>
635:                          <span>PNG</span>
636:                        <% end %>
637:                      <% end %>
