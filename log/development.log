500:                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
501:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
502:                      </svg>
503:                      <span>Add Your First Menu Item</span>
504:                    <% end %>
505:                  <% end %>
506:                </div>
507:              <% end %>
508:            </div>
509:          </div>
