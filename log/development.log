639:                        <%= link_to qr_code_svg_restaurant_path(@restaurant), class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-sm" do %>
640:                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
