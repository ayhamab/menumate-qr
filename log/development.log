566:                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
567:                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2.01M5 20h2.01M8 8h.01M8 20h.01M12 8h.01M12 20h.01M16 8h.01M16 20h.01M20 8h.01M20 20h.01"></path>
568:                </svg>
569:                <h3 class="text-lg font-bold text-gray-900">Menu QR Code</h3>
