693:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
694:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
695:                    </svg>
696:                    <span>Subscription</span>
697:                  <% end %>
698:                  <% if @restaurant.menu_items.any? && @restaurant.menu_items.joins(:dietary_accuracy_reports).where(dietary_accuracy_reports: { resolved: false }).exists? %>
699:                    <% unresolved_reports = @restaurant.menu_items.joins(:dietary_accuracy_reports).where(dietary_accuracy_reports: { resolved: false }).count %>
700:                    <%= link_to "#", class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 relative" do %>
701:                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
702:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
703:                      </svg>
704:                      <span>Dietary Reports</span>
705:                      <% if unresolved_reports > 0 %>
706:                        <span class="absolute -top-2 -right-2 bg-red-600 text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center"><%= unresolved_reports %></span>
707:                      <% end %>
708:                    <% end %>
709:                  <% end %>
710:                  <%= link_to edit_restaurant_path(@restaurant), class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
711:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
712:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
713:                    </svg>
714:                    <span>Edit Restaurant</span>
715:                  <% end %>
716:                <% rescue NoMethodError, NameError %>
717:                  <%= link_to "/restaurants/#{@restaurant.id}/edit", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
718:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
719:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
720:                    </svg>
721:                    <span>Edit Restaurant</span>
722:                  <% end %>
