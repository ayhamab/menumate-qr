673:                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
674:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
675:                    </svg>
676:                    <span>Virtual Brands</span>
677:                  <% end %>
