576:                    begin
577:                      menu_url = menu_restaurant_url(@restaurant, host: request.host_with_port, protocol: request.protocol)
578:                    rescue NoMethodError, NameError
579:                      menu_url = restaurant_url(@restaurant, host: request.host_with_port, protocol: request.protocol)
580:                    end
581:                  %>
582:                  <%= qr_code_svg(menu_url, size: 200) %>
583:                </div>
584:                <p class="text-sm text-gray-600 text-center mb-4">
585:                  Scan this QR code to view the menu on your phone
586:                </p>
587:                <div class="flex gap-2">
588:                  <% begin %>
589:                    <%= link_to menu_restaurant_path(@restaurant), class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
590:                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
591:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
592:                      </svg>
593:                      <span>View Menu</span>
594:                    <% end %>
595:                    <%= link_to menu_restaurant_path(@restaurant, print: true), target: '_blank', class: "flex-1 bg-white border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
596:                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
597:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
598:                      </svg>
599:                      <span>Print</span>
600:                    <% end %>
601:                  <% rescue NoMethodError, NameError %>
602:                    <%= link_to "/restaurants/#{@restaurant.id}/menu", class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
603:                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
604:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
605:                      </svg>
606:                      <span>View Menu</span>
607:                    <% end %>
608:                    <%= link_to "/restaurants/#{@restaurant.id}/menu?print=true", target: '_blank', class: "flex-1 bg-white border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold py-2.5 px-4 rounded-lg transition-all duration-200 flex items-center justify-center gap-2" do %>
609:                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
610:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
611:                      </svg>
612:                      <span>Print</span>
613:                    <% end %>
614:                  <% end %>
615:                </div>
616:                
617:                <% if restaurant_owner?(@restaurant) %>
618:                  <div class="w-full pt-3 border-t border-gray-200">
